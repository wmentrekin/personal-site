---
interface Props {
  visitedIso2: string[];
}

const { visitedIso2 } = Astro.props;
---

<div class="travel-globe-shell">
  <canvas
    class="travel-globe-canvas"
    data-travel-globe
    data-visited-iso2={JSON.stringify(visitedIso2)}
    aria-label="Interactive globe"
  ></canvas>
</div>

<script>
  import { geoGraticule10, geoOrthographic, geoPath } from "d3-geo";

  type CountryFeature = {
    properties: {
      ISO_A2?: string;
      ADMIN?: string;
    };
  };

  let countriesDataPromise: Promise<CountryFeature[]> | undefined;

  const countryAliases: Record<string, string> = {
    France: "FR"
  };

  const loadCountriesData = async () => {
    if (!countriesDataPromise) {
      countriesDataPromise = fetch("/data/travel/ne_110m_admin_0_countries.geojson")
        .then((response) => {
          if (!response.ok) {
            throw new Error(`Failed to load travel globe data: ${response.status}`);
          }

          return response.json() as Promise<{ features: CountryFeature[] }>;
        })
        .then((countries) =>
          countries.features.filter(
            (feature: CountryFeature) => feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "AQ"
          )
        );
    }

    return countriesDataPromise;
  };

  const getCountryCode = (feature: CountryFeature) => {
    if (feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "-99") {
      return feature.properties.ISO_A2;
    }

    return countryAliases[feature.properties.ADMIN ?? ""] ?? null;
  };

  const mountTravelGlobe = async (canvas: Element) => {
    if (!(canvas instanceof HTMLCanvasElement) || canvas.dataset.ready === "true") {
      return;
    }

    canvas.dataset.ready = "true";

    const countries = await loadCountriesData();
    const visitedIso2 = JSON.parse(canvas.dataset.visitedIso2 ?? "[]");
    const visitedSet = new Set(visitedIso2);
    const context = canvas.getContext("2d");

    if (!context) {
      return;
    }

    const projection = geoOrthographic();
    const path = geoPath(projection, context);
    const graticule = geoGraticule10();
    const rotation = [-20, -18, 0];

    let width = 0;
    let height = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    const drawSphere = () => {
      const sphere = { type: "Sphere" };
      const radius = Math.min(width, height) * 0.42;
      const centerX = width / 2;
      const centerY = height / 2;

      context.save();
      context.beginPath();
      path(sphere);
      const glow = context.createRadialGradient(centerX, centerY, radius * 0.55, centerX, centerY, radius * 1.08);
      glow.addColorStop(0, "rgba(125, 211, 252, 0)");
      glow.addColorStop(1, "rgba(125, 211, 252, 0.18)");
      context.fillStyle = glow;
      context.fill();
      context.restore();

      context.save();
      context.beginPath();
      path(sphere);
      const fill = context.createRadialGradient(
        centerX - radius * 0.38,
        centerY - radius * 0.42,
        radius * 0.08,
        centerX,
        centerY,
        radius
      );
      fill.addColorStop(0, "rgba(196, 236, 255, 0.34)");
      fill.addColorStop(0.24, "rgba(64, 130, 181, 0.4)");
      fill.addColorStop(0.62, "rgba(16, 34, 54, 0.98)");
      fill.addColorStop(1, "rgba(5, 10, 17, 1)");
      context.fillStyle = fill;
      context.fill();
      context.restore();

      context.save();
      context.beginPath();
      path(sphere);
      context.strokeStyle = "rgba(173, 196, 221, 0.24)";
      context.lineWidth = 1.1;
      context.stroke();
      context.restore();
    };

    const draw = () => {
      context.clearRect(0, 0, width, height);

      drawSphere();

      context.save();
      context.beginPath();
      path({ type: "Sphere" });
      context.clip();

      context.beginPath();
      path(graticule);
      context.strokeStyle = "rgba(173, 196, 221, 0.12)";
      context.lineWidth = 0.7;
      context.stroke();

      countries.forEach((feature: CountryFeature) => {
        const code = getCountryCode(feature);
        const visited = code ? visitedSet.has(code) : false;

        context.beginPath();
        path(feature);
        context.fillStyle = visited ? "rgba(94, 234, 212, 0.88)" : "rgba(148, 163, 184, 0.08)";
        context.fill();
        context.strokeStyle = visited ? "rgba(214, 245, 255, 0.34)" : "rgba(173, 196, 221, 0.12)";
        context.lineWidth = 0.75;
        context.stroke();
      });

      const shadow = context.createRadialGradient(
        width * 0.38,
        height * 0.34,
        width * 0.04,
        width * 0.62,
        height * 0.64,
        Math.min(width, height) * 0.48
      );
      shadow.addColorStop(0, "rgba(255, 255, 255, 0)");
      shadow.addColorStop(0.65, "rgba(0, 0, 0, 0.06)");
      shadow.addColorStop(1, "rgba(0, 0, 0, 0.3)");
      context.fillStyle = shadow;
      context.fillRect(0, 0, width, height);

      context.restore();
    };

    const resize = () => {
      const nextWidth = Math.max(1, canvas.clientWidth);
      const nextHeight = Math.max(1, canvas.clientHeight);
      const ratio = window.devicePixelRatio || 1;

      width = nextWidth;
      height = nextHeight;

      canvas.width = Math.round(nextWidth * ratio);
      canvas.height = Math.round(nextHeight * ratio);

      context.setTransform(1, 0, 0, 1, 0, 0);
      context.scale(ratio, ratio);

      projection
        .translate([width / 2, height / 2])
        .scale(Math.min(width, height) * 0.42)
        .clipAngle(90)
        .precision(0.5)
        .rotate(rotation);

      draw();
    };

    const stopDragging = (event: PointerEvent) => {
      if (!isDragging) {
        return;
      }

      isDragging = false;
      if (event instanceof PointerEvent) {
        canvas.releasePointerCapture(event.pointerId);
      }
    };

    canvas.addEventListener("pointerdown", (event) => {
      isDragging = true;
      startX = event.clientX;
      startY = event.clientY;
      canvas.setPointerCapture(event.pointerId);
    });

    canvas.addEventListener("pointermove", (event) => {
      if (!isDragging) {
        return;
      }

      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;

      startX = event.clientX;
      startY = event.clientY;

      rotation[0] += deltaX * 0.35;
      rotation[1] = Math.max(-55, Math.min(55, rotation[1] - deltaY * 0.25));
      projection.rotate(rotation);
      draw();
    });

    canvas.addEventListener("pointerup", stopDragging);
    canvas.addEventListener("pointercancel", stopDragging);
    canvas.addEventListener("pointerleave", stopDragging);

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(canvas);
    resize();

    window.addEventListener(
      "pagehide",
      () => {
        resizeObserver.disconnect();
      },
      { once: true }
    );
  };

  const initTravelGlobes = () => {
    document.querySelectorAll("[data-travel-globe]").forEach((canvas) => {
      void mountTravelGlobe(canvas);
    });
  };

  document.addEventListener("astro:page-load", initTravelGlobes);
  initTravelGlobes();
</script>

<style>
  .travel-globe-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 32rem;
    overflow: hidden;
  }

  .travel-globe-canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 32rem;
    cursor: grab;
  }

  .travel-globe-canvas:active {
    cursor: grabbing;
  }
</style>
