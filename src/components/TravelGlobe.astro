---
import { readFileSync } from "node:fs";
import { geoEquirectangular, geoGraticule10, geoPath } from "d3-geo";

interface FeatureProperties {
  ISO_A2?: string;
  ADMIN?: string;
}

interface FeatureCollection {
  features: Array<{
    properties: FeatureProperties;
  }>;
}

interface Props {
  visitedIso2: string[];
}

const { visitedIso2 } = Astro.props;
const adminIsoAliases: Record<string, string> = {
  France: "FR"
};

const countries = JSON.parse(
  readFileSync(new URL("../../public/data/travel/ne_110m_admin_0_countries.geojson", import.meta.url), "utf-8")
) as FeatureCollection;

const width = 1400;
const height = 700;
const projection = geoEquirectangular().fitSize([width, height], countries as never);
const path = geoPath(projection);
const graticule = geoGraticule10();
const visitedSet = new Set(visitedIso2);

const countryPaths = countries.features
  .filter((feature) => feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "AQ")
  .map((feature) => {
    const shape = path(feature as never);

    if (!shape) {
      return "";
    }

    const isoCode = feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "-99"
      ? feature.properties.ISO_A2
      : adminIsoAliases[feature.properties.ADMIN ?? ""] ?? "";
    const visited = visitedSet.has(isoCode);

    return `<path d="${shape}" fill="${visited ? "#5eead4" : "rgba(148,163,184,0.08)"}" stroke="${
      visited ? "rgba(214,245,255,0.32)" : "rgba(173,196,221,0.10)"
    }" stroke-width="0.7" />`;
  })
  .join("");

const graticulePath = path(graticule as never) ?? "";

const textureSvg = `
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}">
    <rect width="${width}" height="${height}" fill="#0a121b" />
    <path d="${graticulePath}" fill="none" stroke="rgba(173,196,221,0.11)" stroke-width="0.8" />
    ${countryPaths}
  </svg>
`;

const textureUrl = `url("data:image/svg+xml,${encodeURIComponent(textureSvg)}")`;
---

<div class="travel-globe-shell">
  <div class="globe-orbit orbit-one"></div>
  <div class="globe-orbit orbit-two"></div>
  <div class="travel-globe-sphere" data-drag-globe style={`--globe-texture: ${textureUrl};`}>
    <div class="globe-map"></div>
  </div>
</div>

<script>
  const initDragGlobes = () => {
    document.querySelectorAll("[data-drag-globe]").forEach((globe) => {
      if (!(globe instanceof HTMLElement) || globe.dataset.ready === "true") {
        return;
      }

      globe.dataset.ready = "true";

      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let shiftX = 0;
      let tiltDeg = -18;

      const apply = () => {
        globe.style.setProperty("--globe-shift", `${shiftX}px`);
        globe.style.setProperty("--globe-tilt", `${tiltDeg}deg`);
      };

      globe.addEventListener("pointerdown", (event) => {
        isDragging = true;
        startX = event.clientX;
        startY = event.clientY;
        globe.setPointerCapture(event.pointerId);
      });

      globe.addEventListener("pointermove", (event) => {
        if (!isDragging) {
          return;
        }

        const deltaX = event.clientX - startX;
        const deltaY = event.clientY - startY;
        startX = event.clientX;
        startY = event.clientY;

        shiftX += deltaX * 2.2;
        tiltDeg = Math.max(-32, Math.min(8, tiltDeg + deltaY * 0.08));
        apply();
      });

      const stopDragging = (event: PointerEvent) => {
        if (!isDragging) {
          return;
        }

        isDragging = false;
        if (event instanceof PointerEvent) {
          globe.releasePointerCapture(event.pointerId);
        }
      };

      globe.addEventListener("pointerup", stopDragging);
      globe.addEventListener("pointercancel", stopDragging);
      globe.addEventListener("pointerleave", stopDragging);

      apply();
    });
  };

  document.addEventListener("astro:page-load", initDragGlobes);
  initDragGlobes();
</script>

<style>
  .travel-globe-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 22rem;
    overflow: hidden;
  }

  .travel-globe-sphere {
    --globe-shift: 0px;
    --globe-tilt: -18deg;
    position: relative;
    width: min(38rem, 84vw);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    cursor: grab;
    background:
      radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.22), transparent 14%),
      radial-gradient(circle at 42% 36%, rgba(125, 211, 252, 0.16), transparent 24%),
      radial-gradient(circle at 50% 50%, rgba(14, 29, 45, 0.98), rgba(5, 10, 17, 1) 74%);
    box-shadow:
      inset -34px -30px 72px rgba(0, 0, 0, 0.42),
      inset 24px 20px 56px rgba(255, 255, 255, 0.05),
      0 24px 60px rgba(0, 0, 0, 0.36);
    transform: rotateZ(-6deg);
  }

  .travel-globe-sphere:active {
    cursor: grabbing;
  }

  .globe-map {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-image: var(--globe-texture);
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: var(--globe-shift) 50%;
    transform: perspective(900px) rotateX(var(--globe-tilt)) scaleX(1.22);
    transform-origin: center;
    opacity: 0.96;
    transition: transform 140ms ease-out;
  }

  .globe-map::before,
  .globe-map::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
  }

  .globe-map::before {
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.16), transparent 18%),
      radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.18) 78%);
  }

  .globe-map::after {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.32), transparent 22%, transparent 72%, rgba(0, 0, 0, 0.36)),
      radial-gradient(circle at center, transparent 62%, rgba(125, 211, 252, 0.1) 100%);
  }

  .globe-orbit {
    position: absolute;
    border: 1px solid rgba(173, 196, 221, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }

  .orbit-one {
    width: min(44rem, 92vw);
    aspect-ratio: 1;
  }

  .orbit-two {
    width: min(47rem, 96vw);
    aspect-ratio: 1;
    transform: rotateX(72deg);
  }
</style>
