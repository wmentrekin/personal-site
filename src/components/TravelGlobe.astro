---
interface Props {
  visitedIso2: string[];
}

const { visitedIso2 } = Astro.props;
---

<div class="travel-globe-shell">
  <div
    class="travel-globe-canvas"
    aria-label="Interactive globe visualization"
    data-travel-globe
    data-visited-iso2={JSON.stringify(visitedIso2)}
  ></div>
</div>

<script>
  let globeModulePromise;

  let countriesDataPromise;

  const loadGlobeModule = async () => {
    if (!globeModulePromise) {
      globeModulePromise = import("globe.gl").then((module) => module.default);
    }

    return globeModulePromise;
  };

  const loadCountriesData = async () => {
    if (!countriesDataPromise) {
      countriesDataPromise = fetch("/data/travel/ne_110m_admin_0_countries.geojson")
        .then((response) => {
          if (!response.ok) {
            throw new Error(`Failed to load travel globe data: ${response.status}`);
          }

          return response.json();
        })
        .then((countries) =>
          countries.features.filter(
            (feature) => feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "AQ"
          )
        );
    }

    return countriesDataPromise;
  };

  const mountTravelGlobe = async (container) => {
    if (!(container instanceof HTMLElement) || container.dataset.ready === "true" || container.dataset.loading === "true") {
      return;
    }

    container.dataset.loading = "true";

    const [Globe, countriesData] = await Promise.all([loadGlobeModule(), loadCountriesData()]);
    container.dataset.loading = "false";
    container.dataset.ready = "true";

    const visitedIso2 = JSON.parse(container.dataset.visitedIso2 ?? "[]");
    const visitedSet = new Set(visitedIso2);

    let hoveredPolygon = null;

    const polygonAltitude = (feature) => {
      if (feature === hoveredPolygon) return 0.11;
      return visitedSet.has(feature.properties.ISO_A2) ? 0.055 : 0.006;
    };

    const polygonCapColor = (feature) => {
      if (feature === hoveredPolygon) return "rgba(125, 211, 252, 0.94)";
      return visitedSet.has(feature.properties.ISO_A2)
        ? "rgba(94, 234, 212, 0.84)"
        : "rgba(148, 163, 184, 0.08)";
    };

    const polygonSideColor = (feature) =>
      visitedSet.has(feature.properties.ISO_A2)
        ? "rgba(94, 234, 212, 0.18)"
        : "rgba(148, 163, 184, 0.04)";

    const polygonStrokeColor = (feature) =>
      visitedSet.has(feature.properties.ISO_A2)
        ? "rgba(173, 196, 221, 0.36)"
        : "rgba(173, 196, 221, 0.12)";

    const globe = new Globe(container)
      .backgroundColor("rgba(0,0,0,0)")
      .showAtmosphere(true)
      .atmosphereColor("#7dd3fc")
      .atmosphereAltitude(0.16)
      .lineHoverPrecision(0)
      .polygonsData(countriesData)
      .polygonAltitude(polygonAltitude)
      .polygonCapColor(polygonCapColor)
      .polygonSideColor(polygonSideColor)
      .polygonStrokeColor(polygonStrokeColor)
      .polygonLabel(
        (feature) => `
          <div style="padding: 0.2rem 0.35rem;">
            <strong>${feature.properties.ADMIN}</strong><br />
            ${visitedSet.has(feature.properties.ISO_A2) ? "Visited" : "Not visited yet"}
          </div>
        `
      )
      .onPolygonHover((feature) => {
        hoveredPolygon = feature;
        globe
          .polygonAltitude(polygonAltitude)
          .polygonCapColor(polygonCapColor)
          .polygonSideColor(polygonSideColor);
      })
      .polygonsTransitionDuration(220)
      .onGlobeReady(() => {
        globe.pointOfView({ lat: 20, lng: -70, altitude: 2.05 }, 0);
      });

    const controls = globe.controls();
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.45;
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.enablePan = false;

    const resize = () => {
      globe.width(container.clientWidth);
      globe.height(container.clientHeight);
    };

    resize();

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(container);

    window.addEventListener(
      "pagehide",
      () => {
        resizeObserver.disconnect();
      },
      { once: true }
    );
  };

  const initTravelGlobes = () => {
    const containers = document.querySelectorAll("[data-travel-globe]");

    if (!("IntersectionObserver" in window)) {
      containers.forEach((container) => {
        void mountTravelGlobe(container);
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }

          observer.unobserve(entry.target);
          void mountTravelGlobe(entry.target);
        });
      },
      { rootMargin: "200px 0px" }
    );

    containers.forEach((container) => {
      if (container instanceof HTMLElement && container.dataset.ready !== "true") {
        observer.observe(container);
      }
    });
  };

  document.addEventListener("astro:page-load", initTravelGlobes);
  initTravelGlobes();
</script>

<style>
  .travel-globe-shell,
  .travel-globe-canvas {
    width: 100%;
    height: 100%;
  }

  .travel-globe-canvas {
    min-height: 22rem;
    cursor: grab;
    position: relative;
  }

  .travel-globe-canvas:active {
    cursor: grabbing;
  }
</style>
