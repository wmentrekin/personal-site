---
interface Props {
  visitedIso2: string[];
  visitedUsStates?: string[];
}

const { visitedIso2, visitedUsStates = [] } = Astro.props;
---

<div class="travel-globe-shell">
  <canvas
    class="travel-globe-canvas"
    data-travel-globe
    data-visited-iso2={JSON.stringify(visitedIso2)}
    data-visited-us-states={JSON.stringify(visitedUsStates)}
    aria-label="Interactive globe"
  ></canvas>
</div>

<script>
  import { geoCentroid, geoGraticule10, geoOrthographic, geoPath } from "d3-geo";
  import { feature } from "topojson-client";
  import usStatesUrl from "us-atlas/states-10m.json?url";

  type CountryFeature = {
    type?: string;
    geometry?: {
      type: string;
      coordinates: unknown;
    };
    properties: {
      ISO_A2?: string;
      ADMIN?: string;
    };
  };

  type UsStateFeature = {
    type?: string;
    id?: string;
    geometry?: {
      type: string;
      coordinates: unknown;
    };
    properties?: {
      name?: string;
    };
  };

  let countriesDataPromise: Promise<CountryFeature[]> | undefined;
  let usStatesDataPromise: Promise<UsStateFeature[]> | undefined;

  const countryAliases: Record<string, string> = {
    France: "FR"
  };
  const usStateFipsByCode: Record<string, string> = {
    AL: "01",
    AK: "02",
    AZ: "04",
    AR: "05",
    CA: "06",
    CO: "08",
    CT: "09",
    DE: "10",
    FL: "12",
    GA: "13",
    HI: "15",
    ID: "16",
    IL: "17",
    IN: "18",
    IA: "19",
    KS: "20",
    KY: "21",
    LA: "22",
    ME: "23",
    MD: "24",
    MA: "25",
    MI: "26",
    MN: "27",
    MS: "28",
    MO: "29",
    MT: "30",
    NE: "31",
    NV: "32",
    NH: "33",
    NJ: "34",
    NM: "35",
    NY: "36",
    NC: "37",
    ND: "38",
    OH: "39",
    OK: "40",
    OR: "41",
    PA: "42",
    RI: "44",
    SC: "45",
    SD: "46",
    TN: "47",
    TX: "48",
    UT: "49",
    VT: "50",
    VA: "51",
    WA: "53",
    WV: "54",
    WI: "55",
    WY: "56",
    DC: "11",
    PR: "72"
  };

  const loadUsStatesData = async () => {
    if (!usStatesDataPromise) {
      usStatesDataPromise = fetch(usStatesUrl)
        .then((response) => {
          if (!response.ok) {
            throw new Error(`Failed to load U.S. state geometry: ${response.status}`);
          }

          return response.json();
        })
        .then((topology) => {
          const collection = feature(topology as never, (topology as any).objects.states) as {
            features: UsStateFeature[];
          };
          return collection.features;
        });
    }

    return usStatesDataPromise;
  };

  const loadCountriesData = async () => {
    if (!countriesDataPromise) {
      countriesDataPromise = fetch("/data/travel/ne_110m_admin_0_countries.geojson")
        .then((response) => {
          if (!response.ok) {
            throw new Error(`Failed to load travel globe data: ${response.status}`);
          }

          return response.json() as Promise<{ features: CountryFeature[] }>;
        })
        .then((countries) =>
          countries.features.filter(
            (feature: CountryFeature) => feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "AQ"
          )
        );
    }

    return countriesDataPromise;
  };

  const getCountryCode = (feature: CountryFeature) => {
    if (feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "-99") {
      return feature.properties.ISO_A2;
    }

    return countryAliases[feature.properties.ADMIN ?? ""] ?? null;
  };

  const normalizeCountryFeature = (feature: CountryFeature) => {
    const code = getCountryCode(feature);

    if (
      code === "FR" &&
      feature.geometry?.type === "MultiPolygon" &&
      Array.isArray(feature.geometry.coordinates)
    ) {
      const mainlandCoordinates = feature.geometry.coordinates.filter((polygon) => {
        const centroid = geoCentroid({
          type: "Feature",
          properties: feature.properties,
          geometry: {
            type: "MultiPolygon",
            coordinates: [polygon]
          }
        } as never);

        return centroid[0] > -10 && centroid[0] < 15 && centroid[1] > 35 && centroid[1] < 55;
      });

      if (mainlandCoordinates.length > 0) {
        return {
          ...feature,
          geometry: {
            ...feature.geometry,
            coordinates: mainlandCoordinates
          }
        };
      }
    }

    return feature;
  };

  const mountTravelGlobe = async (canvas: Element) => {
    if (!(canvas instanceof HTMLCanvasElement) || canvas.dataset.ready === "true") {
      return;
    }

    canvas.dataset.ready = "true";

    const countries = await loadCountriesData();
    const usStates = await loadUsStatesData();
    const visitedIso2 = JSON.parse(canvas.dataset.visitedIso2 ?? "[]");
    const visitedUsStates = JSON.parse(canvas.dataset.visitedUsStates ?? "[]");
    const visitedSet = new Set(visitedIso2);
    const visitedUsStatesSet = new Set(
      visitedUsStates.map((code: string) => usStateFipsByCode[code]).filter(Boolean)
    );
    const context = canvas.getContext("2d");

    if (!context) {
      return;
    }

    const projection = geoOrthographic();
    const path = geoPath(projection, context);
    const graticule = geoGraticule10();
    const rotation = [-20, -18, 0];
    let zoom = 1;

    let width = 0;
    let height = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    const drawSphere = () => {
      const sphere = { type: "Sphere" };
      const fill = context.createLinearGradient(0, 0, 0, height);

      context.save();
      context.beginPath();
      path(sphere);
      fill.addColorStop(0, "rgba(24, 34, 46, 0.98)");
      fill.addColorStop(0.45, "rgba(12, 20, 30, 0.99)");
      fill.addColorStop(1, "rgba(5, 10, 17, 1)");
      context.fillStyle = fill;
      context.fill();
      context.restore();

      context.save();
      context.beginPath();
      path(sphere);
      context.strokeStyle = "rgba(173, 196, 221, 0.24)";
      context.lineWidth = 1.45;
      context.stroke();
      context.restore();
    };

    const draw = () => {
      context.clearRect(0, 0, width, height);

      drawSphere();

      context.save();
      context.beginPath();
      path({ type: "Sphere" });
      context.clip();

      context.beginPath();
      path(graticule);
      context.strokeStyle = "rgba(173, 196, 221, 0.12)";
      context.lineWidth = 0.7;
      context.stroke();

      countries.forEach((feature: CountryFeature) => {
        const normalizedFeature = normalizeCountryFeature(feature);
        const code = getCountryCode(normalizedFeature);
        const visited = code ? visitedSet.has(code) : false;
        const isUnitedStates = code === "US";

        context.beginPath();
        path(normalizedFeature as never);
        context.fillStyle = isUnitedStates
          ? "rgba(61, 72, 85, 0.12)"
          : visited
            ? "rgba(217, 67, 67, 0.96)"
            : "rgba(74, 86, 102, 0.32)";
        context.fill();
        context.strokeStyle = isUnitedStates
          ? "rgba(173, 196, 221, 0.12)"
          : visited
            ? "rgba(255, 228, 228, 0.62)"
            : "rgba(173, 196, 221, 0.16)";
        context.lineWidth = visited ? 1 : 0.75;
        context.stroke();
      });

      usStates.forEach((stateFeature) => {
        const visited = stateFeature.id ? visitedUsStatesSet.has(stateFeature.id) : false;

        context.beginPath();
        path(stateFeature as never);
        context.fillStyle = visited ? "rgba(217, 67, 67, 0.98)" : "rgba(74, 86, 102, 0.16)";
        context.fill();
        context.strokeStyle = visited ? "rgba(255, 234, 234, 0.68)" : "rgba(173, 196, 221, 0.14)";
        context.lineWidth = visited ? 0.95 : 0.55;
        context.stroke();
      });

      context.restore();
    };

    const resize = () => {
      const nextWidth = Math.max(1, canvas.clientWidth);
      const nextHeight = Math.max(1, canvas.clientHeight);
      const ratio = window.devicePixelRatio || 1;

      width = nextWidth;
      height = nextHeight;

      canvas.width = Math.round(nextWidth * ratio);
      canvas.height = Math.round(nextHeight * ratio);

      context.setTransform(1, 0, 0, 1, 0, 0);
      context.scale(ratio, ratio);

      projection
        .translate([width / 2, height / 2])
        .scale(Math.min(width, height) * 0.45 * zoom)
        .clipAngle(90)
        .precision(0.5)
        .rotate(rotation);

      draw();
    };

    const stopDragging = (event: PointerEvent) => {
      if (!isDragging) {
        return;
      }

      isDragging = false;
      if (event instanceof PointerEvent) {
        canvas.releasePointerCapture(event.pointerId);
      }
    };

    canvas.addEventListener("pointerdown", (event) => {
      isDragging = true;
      startX = event.clientX;
      startY = event.clientY;
      canvas.setPointerCapture(event.pointerId);
    });

    canvas.addEventListener("pointermove", (event) => {
      if (!isDragging) {
        return;
      }

      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;

      startX = event.clientX;
      startY = event.clientY;

      rotation[0] += deltaX * 0.35;
      rotation[1] = Math.max(-55, Math.min(55, rotation[1] - deltaY * 0.25));
      projection.rotate(rotation);
      draw();
    });

    canvas.addEventListener("pointerup", stopDragging);
    canvas.addEventListener("pointercancel", stopDragging);
    canvas.addEventListener("pointerleave", stopDragging);

    canvas.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        const direction = Math.sign(event.deltaY);
        zoom = Math.max(0.88, Math.min(1.55, zoom - direction * 0.06));
        resize();
      },
      { passive: false }
    );

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(canvas);
    resize();

    window.addEventListener(
      "pagehide",
      () => {
        resizeObserver.disconnect();
      },
      { once: true }
    );
  };

  const initTravelGlobes = () => {
    document.querySelectorAll("[data-travel-globe]").forEach((canvas) => {
      void mountTravelGlobe(canvas);
    });
  };

  document.addEventListener("astro:page-load", initTravelGlobes);
  initTravelGlobes();
</script>

<style>
  .travel-globe-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 32rem;
    overflow: hidden;
  }

  .travel-globe-canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 36rem;
    cursor: grab;
  }

  .travel-globe-canvas:active {
    cursor: grabbing;
  }
</style>
