---
import { readFileSync } from "node:fs";
import { geoEquirectangular, geoGraticule10, geoPath } from "d3-geo";

interface FeatureProperties {
  ISO_A2?: string;
}

interface FeatureCollection {
  features: Array<{
    properties: FeatureProperties;
  }>;
}

interface Props {
  visitedIso2: string[];
}

const { visitedIso2 } = Astro.props;

const countries = JSON.parse(
  readFileSync(new URL("../../public/data/travel/ne_110m_admin_0_countries.geojson", import.meta.url), "utf-8")
) as FeatureCollection;

const width = 1400;
const height = 700;
const projection = geoEquirectangular().fitSize([width, height], countries as never);
const path = geoPath(projection);
const graticule = geoGraticule10();
const visitedSet = new Set(visitedIso2);

const countryPaths = countries.features
  .filter((feature) => feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "AQ")
  .map((feature) => {
    const shape = path(feature as never);

    if (!shape) {
      return "";
    }

    const visited = visitedSet.has(feature.properties.ISO_A2 ?? "");

    return `<path d="${shape}" fill="${visited ? "#5eead4" : "rgba(148,163,184,0.08)"}" stroke="${
      visited ? "rgba(214,245,255,0.32)" : "rgba(173,196,221,0.10)"
    }" stroke-width="0.7" />`;
  })
  .join("");

const graticulePath = path(graticule as never) ?? "";

const textureSvg = `
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}">
    <rect width="${width}" height="${height}" fill="#0a121b" />
    <path d="${graticulePath}" fill="none" stroke="rgba(173,196,221,0.11)" stroke-width="0.8" />
    ${countryPaths}
  </svg>
`;

const textureUrl = `url("data:image/svg+xml,${encodeURIComponent(textureSvg)}")`;
---

<div class="travel-globe-shell">
  <div class="globe-orbit orbit-one"></div>
  <div class="globe-orbit orbit-two"></div>
  <div class="travel-globe-sphere" style={`--globe-texture: ${textureUrl};`}>
    <div class="globe-map"></div>
  </div>
</div>

<style>
  .travel-globe-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 22rem;
    overflow: hidden;
  }

  .travel-globe-sphere {
    position: relative;
    width: min(25rem, 68vw);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.22), transparent 14%),
      radial-gradient(circle at 42% 36%, rgba(125, 211, 252, 0.16), transparent 24%),
      radial-gradient(circle at 50% 50%, rgba(14, 29, 45, 0.98), rgba(5, 10, 17, 1) 74%);
    box-shadow:
      inset -34px -30px 72px rgba(0, 0, 0, 0.42),
      inset 24px 20px 56px rgba(255, 255, 255, 0.05),
      0 24px 60px rgba(0, 0, 0, 0.36);
  }

  .globe-map {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-image: var(--globe-texture);
    background-repeat: repeat-x;
    background-size: auto 100%;
    background-position: 0 50%;
    transform: scaleX(1.22);
    transform-origin: center;
    opacity: 0.96;
    animation: globe-spin 34s linear infinite;
  }

  .globe-map::before,
  .globe-map::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
  }

  .globe-map::before {
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.16), transparent 18%),
      radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.18) 78%);
  }

  .globe-map::after {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.32), transparent 22%, transparent 72%, rgba(0, 0, 0, 0.36)),
      radial-gradient(circle at center, transparent 62%, rgba(125, 211, 252, 0.1) 100%);
  }

  .globe-orbit {
    position: absolute;
    border: 1px solid rgba(173, 196, 221, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }

  .orbit-one {
    width: min(30rem, 82vw);
    aspect-ratio: 1;
  }

  .orbit-two {
    width: min(32rem, 88vw);
    aspect-ratio: 1;
    transform: rotateX(72deg);
  }

  @keyframes globe-spin {
    from {
      background-position: 0 50%;
    }

    to {
      background-position: -1400px 50%;
    }
  }
</style>
