  .sg-game-body {
    display: inline-flex;
    align-items: center;
    gap: 0.18rem;
  }

  /* The "@" / "vs" that used to lead a full "@ Stanford" label. It now leads the
     opponent's LOGO instead, so a cell reads "@ {logo} W 45-6". A neutral-site
     game reads "vs*" -- see opponentPrefix() above for the asterisk regression
     fix and its accessible aria-label/title. */
  .sg-prefix {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    opacity: 0.75;
  }

  .sg-opp-logo {
    width: 1.05rem;
    height: 1.05rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* Only rendered when the opponent has no logo (typically an FCS team). Capped so a
