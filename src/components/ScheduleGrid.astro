---
// Season Grid: conference-grouped, color-coded team-by-week schedule table (T9).
//
// Consumes the schedule artifact contract exactly as T4b publishes it (see
// docs/schedule-grid/plan.yaml contracts.interfaces in the cfb-rankings repo) --
// conferences[] is already in fixed display order, conferences[].name is already
// the display name, teams[] within a conference is already standings-sorted, and
// weeks[] is already the canonical, identical-across-teams column list. This
// component renders that structure; it never re-derives/re-sorts/re-maps any of it.
//
// This is the server-rendered (build-time) counterpart to the client-side
// `renderScheduleGrid()` mirror in index.astro's inline script, which rebuilds
// this exact markup via document.createElement when the page-level season
// selector changes while the Season Grid tab is active -- see that script's
// comment block for why the logic is duplicated rather than shared (same
// reason RankingsTable.astro's renderRows() is duplicated there today: a
// client-rebuilt table's elements never carry Astro's scoped data-astro-cid-*
// attribute, so this component's own <style> must be `is:global`).
//
// Missing-logo convention: identical to RankingsTable.astro (DO NOT modify that
// file) -- if a logo URL exists, render the <img>; if null/missing, render no
// image at all. No placeholder-initial badge (confirmed there is no precedent
// for one anywhere in this codebase).

interface WeekCell {
  slot_id: string;
  label: string;
  season_type: string | null;
  opponent: string | null;
  opponent_logo_url: string | null;
  conditional_opponent: string | null;
  game_name: string | null;
  home_away: "home" | "away" | null;
  neutral_site: boolean;
  status: string;
  team_score: number | null;
  opp_score: number | null;
}

interface TeamEntry {
  team: string;
  logo_url: string | null;
  // Both added by the artifact builder in this same pass (cfb-rankings PR #11).
  // rank: the team's current position in the published rankings for this season;
  // null for a team the ranking run did not cover. division: the team's division
  // within its conference ("East"/"West"), null for every team in a conference
  // that has no divisions -- which is all of them but the Sun Belt today, so the
  // null branch is the common case, not the edge case.
  // Optional, not just nullable: the artifact currently published to R2 predates both
  // fields, so a payload that omits them entirely is a live, reachable case -- which is
  // what the `!== undefined` guard in the render below has always been handling. Declaring
  // them required said otherwise and made that guard look like dead defensiveness.
  rank?: number | null;
  record: { wins: number; losses: number };
  conf_record: { wins: number; losses: number } | null;
  division?: string | null;
  weeks: WeekCell[];
}

interface ConferenceEntry {
  name: string;
  teams: TeamEntry[];
}

export interface SchedulePayload {
  season: number;
  generated_at_utc: string;
  conferences: ConferenceEntry[];
}

interface Props {
  data: SchedulePayload | null;
}

const { data } = Astro.props;

type CellView = {
  className: string;
  gameName: string | null;
  kind: "game" | "muted" | "blank";
  prefix: string | null;
  logo: string | null;
  opponentFallback: string | null;
  badge: "W" | "L" | null;
  scoreText: string | null;
  mutedText: string | null;
};

// Mirrored 1:1 by opponentPrefix() in index.astro's client script.
//
// A neutral-site game is nobody's home game, so BOTH participants read "vs" --
// previously the nominal away team showed "@" for a game played on neutral ground.
// The opponent's NAME is deliberately not part of the label any more: the cell
// carries the opponent's logo instead, which is what makes the grid dense enough
// to read a full conference at once. The name is the fallback for a team with no
// logo (typically an FCS opponent).
//
// Regression fix: cells used to read "@ Stanford*", the trailing "*" marking a
// neutral-site game. When the opponent NAME was replaced by their LOGO, the
// asterisk was dropped along with it. It comes back here, glued onto the prefix
// itself ("vs*") since neutral-site games already read "vs" (never "@") for both
// teams -- the marker only ever appears as "vs*". The render below adds an
// aria-label/title on the prefix span so a bare "*" doesn't announce as bare
// punctuation. role="img" is required for that to work and is not decoration: a <span>
// with no role is role=generic, for which ARIA prohibits author naming. Without the role
// Chromium computed the name but left the "vs*" StaticText child exposed underneath it, so
// browse-mode still read the bare asterisk, and Firefox and Safari dropped the name
// outright. Verified in the accessibility tree. This is what .sg-team-rank and
// RankingsTable's .delta-cell already do; the prefix was the one place that set a bare
// aria-label and silently got nothing for it.
function opponentPrefix(cell: WeekCell): string {
  if (cell.neutral_site) return "vs*";
  return cell.home_away === "away" ? "@" : "vs";
}

// Mirrored 1:1 by statusMutedText() in index.astro's client script.
//
// The SAME status value reads differently per column -- status='possible' means
// "In the Hunt" in the conference-championship column but "Not Yet Eligible"
// in the Bowls column -- so display text is a (slot_id, status) lookup rather than a
// property of the status alone. The artifact's status enum is unchanged; this is
// purely presentational, which is why it lives here and not in the builder.
//
// conditional_opponent is deliberately NOT rendered any more. It was a projection
// ("possible vs Georgia"), and a projected matchup is exactly the kind of thing this
// grid should not assert.
const STATUS_TEXT_BY_SLOT: Record<string, Record<string, string>> = {
  "conf-championship": {
    possible: "In the Hunt",
    clinched: "Clinched",
    eliminated: "Eliminated",
  },
  "cfp-r1-bowls": {
    possible: "Not Yet Eligible",
    eligible: "Eligible",
    ineligible: "Ineligible",
  },
};

// Generic per-status text for any (slot_id, status) pair the map above does not cover. The
// artifact builder lives in another repo and can add a slot or emit an existing status in a
// new column; without this a cell would silently render blank. Mirrored in index.astro.
const STATUS_TEXT_FALLBACK: Record<string, string> = {
  tbd: "vs TBD",
  possible: "Still possible",
  clinched: "Clinched",
  eliminated: "Eliminated",
  eligible: "Eligible",
  ineligible: "Ineligible",
};

function statusMutedText(cell: WeekCell): string {
  const forSlot = STATUS_TEXT_BY_SLOT[cell.slot_id];
  if (forSlot && forSlot[cell.status] !== undefined) return forSlot[cell.status];
  return STATUS_TEXT_FALLBACK[cell.status] ?? "";
}

// Mirrored 1:1 by cellClassName() in index.astro's client script.
function cellClassName(status: string): string {
  if (status === "win") return "sg-cell sg-cell--win";
  if (status === "loss") return "sg-cell sg-cell--loss";
  if (status === "upcoming") return "sg-cell sg-cell--upcoming";
  if (status === "bye") return "sg-cell sg-cell--bye";
  return "sg-cell sg-cell--muted";
}

// Mirrored 1:1 by buildCellView() in index.astro's client script. status drives
// every branch here, never string-matching rendered text -- the display strings are
// a presentation lookup that can change without touching this dispatch.
function buildCellView(cell: WeekCell): CellView {
  const className = cellClassName(cell.status);
  const gameName = cell.game_name;

  if (cell.status === "win" || cell.status === "loss") {
    return {
      className,
      gameName,
      kind: "game",
      prefix: opponentPrefix(cell),
      logo: cell.opponent_logo_url,
      opponentFallback: cell.opponent_logo_url ? null : cell.opponent,
      badge: cell.status === "win" ? "W" : "L",
      scoreText: `${cell.team_score}-${cell.opp_score}`,
      mutedText: null,
    };
  }

  if (cell.status === "upcoming") {
    return {
      className,
      gameName,
      kind: "game",
      prefix: opponentPrefix(cell),
      logo: cell.opponent_logo_url,
      opponentFallback: cell.opponent_logo_url ? null : cell.opponent,
      badge: null,
      scoreText: null,
      mutedText: null,
    };
  }

  if (cell.status === "bye") {
    return { className, gameName, kind: "blank", prefix: null, logo: null, opponentFallback: null, badge: null, scoreText: null, mutedText: null };
  }

  // tbd / clinched / possible / eliminated / eligible / ineligible
  return {
    className,
    gameName,
    kind: "muted",
    prefix: null,
    logo: null,
    opponentFallback: null,
    badge: null,
    scoreText: null,
    mutedText: statusMutedText(cell),
  };
}

// Mirrored 1:1 by formatRecord() in index.astro's client script. conf_record is
// null for Independents -- overall record only, no ", 0-0 XXX" suffix.
function formatRecord(team: TeamEntry, confName: string): string {
  const { wins, losses } = team.record;
  if (team.conf_record) {
    return `${wins}-${losses}, ${team.conf_record.wins}-${team.conf_record.losses} ${confName}`;
  }
  return `${wins}-${losses}`;
}

// T15: which team indexes within a conference get a division sub-heading above them.
//
// Computed here rather than inline in the template for two reasons. It keeps the template a
// straight lookup, and a generic type argument inside the template (`new Set<string>()`)
// parses as JSX -- TypeScript then infers `boolean` from the comparison it thinks it sees
// and reports "Property 'add' does not exist on type 'boolean'" plus a cascade of bogus
// unclosed-tag errors. In the frontmatter it is ordinary TypeScript.
//
// teams[] arrives already grouped by division (the builder sorts each division's members in
// its own pass and appends the groups whole), so a heading belongs wherever the division
// CHANGES -- this never re-groups the payload, matching the rest of this component's "render
// the artifact, never re-derive it" rule. `seen` braces that: a payload whose divisions are
// NOT contiguous (hand-edited, or a producer regression) would otherwise emit a heading per
// team, so an SBC interleaved East/West/East/West would render 14 heading rows for 14 teams.
// A conference with no divisions has division null on every team and gets an empty set, so
// its markup is byte-identical to before divisions existed.
function divisionHeaderIndexes(teams: TeamEntry[]): Set<number> {
  const seen = new Set<string>();
  const indexes = new Set<number>();
  let previous: string | null = null;
  teams.forEach((team, index) => {
    const division = team.division ?? null;
    if (division !== null && division !== previous && !seen.has(division)) {
      seen.add(division);
      indexes.add(index);
    }
    previous = division;
  });
  return indexes;
}

// The canonical column list is identical across every team in the payload --
// build it from the first team of the first conference, never recomputed.
const columns: Array<{ slot_id: string; label: string }> =
  data?.conferences[0]?.teams[0]?.weeks.map((w) => ({ slot_id: w.slot_id, label: w.label })) ?? [];
---

<div class="schedule-grid-shell" id="schedule-grid-shell">
  {data && columns.length > 0 ? (
    <table id="schedule-grid-table">
      <thead>
        <tr>
          <th class="sg-th sg-corner">Team</th>
          {columns.map((col) => (
            <th class="sg-th">{col.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {data.conferences.map((conf) => {
          const divisionHeaders = divisionHeaderIndexes(conf.teams);
          return (
          <>
            <tr class="sg-conf-row" data-conference={conf.name}>
              <th class="sg-conf-header sg-conf-header--sticky">{conf.name}</th>
              <th class="sg-conf-header" colspan={columns.length}></th>
            </tr>
            {conf.teams.map((team, teamIndex) => {
              // T15: division sub-headings, placed by divisionHeaderIndexes() above. The
              // heading row carries data-conference so the conference filter (index.astro)
              // hides it with its conference; that filter selects on [data-conference]
              // generically, so no filter change was needed.
              const showDivisionHeader = divisionHeaders.has(teamIndex);
              const division = team.division ?? null;
              return (
              <>
              {showDivisionHeader ? (
                <tr class="sg-div-row" data-conference={conf.name}>
                  <th class="sg-div-header sg-div-header--sticky">{division}</th>
                  <th class="sg-div-header" colspan={columns.length}></th>
                </tr>
              ) : null}
              <tr data-conference={conf.name}>
                <td class="sg-team-col">
                  <span class="sg-team-cell">
                    {team.logo_url ? (
                      <img class="sg-team-logo" src={team.logo_url} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class="sg-team-logo sg-team-logo--empty" aria-hidden="true"></span>
                    )}
                    <span class="sg-team-name-block">
                      <span class="sg-team-name-line">
                        {/* title as insurance: the column is sized to fit today's longest
                            name, but a future rename or realignment could exceed it, and a
                            silently-ellipsised team name has no other recovery. */}
                        <span class="sg-team-name" title={team.team}>{team.team}</span>
                        {team.rank !== null && team.rank !== undefined ? (
                          <span class="sg-team-rank" role="img" aria-label={`Rank ${team.rank}`}>{team.rank}</span>
                        ) : null}
                      </span>
                      <span class="sg-team-record">{formatRecord(team, conf.name)}</span>
                    </span>
                  </span>
                </td>
                {team.weeks.map((cell) => {
                  const view = buildCellView(cell);
                  return (
                    <td class={view.className}>
                      {view.gameName ? <span class="sg-game-name">{view.gameName}</span> : null}
                      {view.kind === "game" ? (
                        <span class="sg-game-body">
                          <span
                            class="sg-prefix"
                            title={cell.neutral_site ? "Neutral-site game" : undefined}
                            role={cell.neutral_site ? "img" : undefined}
                            aria-label={cell.neutral_site ? "vs, neutral site" : undefined}
                          >{view.prefix}</span>
                          {view.logo ? (
                            <img class="sg-opp-logo" src={view.logo} alt={cell.opponent ?? ""} loading="lazy" decoding="async" />
                          ) : null}
                          {view.opponentFallback ? (
                            <span class="sg-opp-fallback">{view.opponentFallback}</span>
                          ) : null}
                          {view.badge ? (
                            <span class={`sg-badge sg-badge--${view.badge.toLowerCase()}`}>{view.badge}</span>
                          ) : null}
                          {view.scoreText ? <span class="sg-score">{view.scoreText}</span> : null}
                        </span>
                      ) : null}
                      {view.kind === "muted" ? <span class="sg-muted-text">{view.mutedText}</span> : null}
                      {view.kind === "blank" ? (
                        <span class="sg-blank" aria-hidden="true">{"\u2014"}</span>
                      ) : null}
                    </td>
                  );
                })}
              </tr>
              </>
              );
            })}
          </>
          );
        })}
      </tbody>
    </table>
  ) : (
    <div class="sg-empty">
      <p>Season Grid data isn't available for this selection yet.</p>
    </div>
  )}
</div>

<style is:global>
  /*
    Global, not scoped: the season selector rebuilds this entire table client-side
    via document.createElement on a season change (see index.astro), and those
    elements never get Astro's scoped data-astro-cid-* attribute -- scoped
    selectors would silently stop matching the moment a user changes season.
    Mirrors RankingsTable.astro's own is:global rationale exactly.
  */
  .schedule-grid-shell {
    overflow: auto;
    /* Was 70vh with much taller rows, which capped the view at ~9-10 teams -- fewer
       than any conference has, so no conference could be read without scrolling. */
    max-height: 82vh;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    /* Solid, matching .sg-team-col below (T10): this shell is the backdrop behind
       every cell that doesn't paint its own opaque background (e.g. the non-sticky
       half of .sg-conf-header, and the padding added below for T11b), so it has to
       be opaque too or the page's grid-line pattern still shows through those gaps. */
    background: rgba(16, 23, 32, 0.98);
    /* T11b: room at the bottom so the horizontal scrollbar (see below) never
       overlaps the last team row. */
    padding-bottom: 0.85rem;
    /* T11b: dark, translucent scrollbar consistent with the site's theme. Standards
       property first (Firefox and any Chromium build honoring it); WebKit
       pseudo-elements below cover Chrome/Safari, since neither alone covers both. */
    scrollbar-color: rgba(173, 196, 221, 0.35) rgba(255, 255, 255, 0.04);
    scrollbar-width: thin;
  }

  .schedule-grid-shell::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .schedule-grid-shell::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
  }

  .schedule-grid-shell::-webkit-scrollbar-thumb {
    background-color: rgba(173, 196, 221, 0.35);
    border-radius: 6px;
    border: 2px solid rgba(16, 23, 32, 0.98);
  }

  .schedule-grid-shell::-webkit-scrollbar-thumb:hover {
    background-color: rgba(173, 196, 221, 0.5);
  }

  .sg-empty {
    padding: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  #schedule-grid-table {
    /* Deliberately NOT width:100%. Stretching the table to fill the shell distributed
       the slack across the week columns, leaving a wide gap after every score. Sizing
       to content instead lets each week column be as narrow as its widest cell. */
    min-width: 46rem;
    border-collapse: separate;
    border-spacing: 0;
    /* T11a: with the default auto layout, each column sized itself to its own
       widest cell -- a column with even one no-logo opponent (whose name falls
       back to text, see .sg-opp-fallback) came out visibly wider than its
       neighbors. table-layout: fixed makes every column's width come from its
       <th> in the header row instead, so declaring one width for the data
       columns below (and its own width on .sg-corner) makes them all equal
       regardless of what any individual cell contains. */
    table-layout: fixed;
  }

  #schedule-grid-table th,
  #schedule-grid-table td {
    padding: 0.22rem 0.3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    text-align: left;
    white-space: nowrap;
    font-size: 0.75rem;
    overflow: hidden;
  }

  /* T11a: one fixed width for every data column (week AND postseason alike --
     see the .sg-th rule below). Sized to fit the widest ordinary cell content,
     "vs {logo} W 99-99" (prefix + opponent logo + result badge + a 2-digit-2-digit
     score), measured in a real browser render; the sole thing that used to be
     wider, the no-logo opponent-name fallback, already self-truncates via its own
     max-width + ellipsis (see .sg-opp-fallback) so it no longer drives column
     width. .sg-corner and .sg-team-col keep their own separate 9.75rem, and the
     postseason columns (Conference Championship / Bowls / CFP slots) share this
     same width rather than a distinct one: their header <th> carries no marker
     that distinguishes them from a plain week column, and the client-side mirror
     in index.astro (out of this task's owned scope) creates every non-corner
     header with the identical "sg-th" class, so any new class added only here
     would silently stop applying the moment a season switch rebuilds the table
     client-side -- the same hazard this file's own header comment warns about.
     Sharing the width is a safe, always-in-sync default; the task's constraint
     only requires week columns to match each other, not to differ from these. */
  .sg-th:not(.sg-corner),
  #schedule-grid-table td:not(.sg-team-col) {
    /* min and max, not width alone. table-layout: fixed above is NOT sufficient on its
       own: Chromium falls back to auto layout when the table's own width is auto (this
       table is deliberately content-sized, not width:100%), so a bare `width` becomes a
       hint that auto layout is free to ignore in favour of content. It did exactly that --
       columns holding a played score came out 105px while unplayed ones collapsed to 50px,
       and the regression only appeared once a later change altered cell content, because
       until then every column happened to hold similarly-sized content and looked uniform.
       Pinning min and max makes the width independent of what any cell contains. */
       Widened from 5.75rem: the neutral-site "*" was added to the prefix AFTER the 5.75rem
       measurement was taken, and it costs 6.55px ("vs" 13.11px -> "vs*" 19.66px), which the
       overflow: hidden above then clipped. Measured: 14 of 2793 cells overflowed, every one
       of them a "vs*" cell -- "vs* W 24-21" wanted 104px of a 102px box, shaving the last
       score digit. 6rem restores the headroom. */
    width: 6rem;
    min-width: 6rem;
    max-width: 6rem;
  }

  /* Sticky header row. Selector is qualified with the table's ID (rather than
     plain .sg-th) so its white-space: normal actually beats the higher-specificity
     #schedule-grid-table th, td { white-space: nowrap } above -- a bare class
     selector cannot out-rank an ID selector regardless of source order. Wrapping
     lets a label like "Conference Championship" fall onto a second line now that
     every header cell shares one fixed width instead of growing to fit its text. */
  #schedule-grid-table .sg-th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: rgba(10, 15, 20, 0.96);
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: normal;
  }

  /* Sticky corner cell: both top AND left, above every other sticky layer, with
     its own explicit opaque background so scrolled content never bleeds through
     the intersection -- no existing component in this codebase combines both.
     Selector is qualified with the table ID, matching #schedule-grid-table
     .sg-th above (same reason: a bare .sg-corner class cannot out-rank that
     ID-qualified rule, which also targets this element since it also carries
     "sg-th" -- without the qualification here, .sg-th's z-index: 2 and header
     background would silently win over this cell's z-index: 4 and background). */
  #schedule-grid-table .sg-corner {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 4;
    background: rgba(10, 15, 20, 0.98);
    /* table-layout: fixed (above) sizes every column from the header row's <th>
       widths alone -- matches .sg-team-col's own min/max-width below so the two
       stay in lockstep. */
    width: 12rem;
  }

  .sg-conf-row .sg-conf-header {
    background: rgba(125, 211, 252, 0.08);
    color: var(--text);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: normal;
  }

  /* The conference-name cell is ALSO sticky-left (same tier as .sg-team-col below it),
     with the same background as the rest of the row -- otherwise, once the grid is
     scrolled horizontally, the sticky corner/column's own opaque background would show
     through where this row's first cell used to be, creating a visible color seam. */
  .sg-conf-header--sticky {
    position: sticky;
    left: 0;
    z-index: 1;
  }

  /* T15: division sub-heading, one visual tier below the conference header above --
     lighter tint, smaller and lighter type, and indented so it reads as nested under
     the conference rather than as a second conference.

     Selector is qualified with the table's ID, unlike .sg-conf-row .sg-conf-header
     above. That is not cosmetic: #schedule-grid-table th, td sets font-size, padding
     and white-space with an ID in the selector, which a bare class selector cannot
     out-rank at any source position. Measured in a browser -- the unqualified form of
     this rule left the sub-heading at the shared 0.75rem/0.3rem, visually identical to
     the conference header it is supposed to sit beneath. (The conference header rule
     loses the same three properties for the same reason; that is pre-existing rendered
     behavior and deliberately left alone here, so the two headings still differ by the
     properties this rule does win -- size, weight, tint and indent.) */
  #schedule-grid-table .sg-div-header {
    background: rgba(125, 211, 252, 0.035);
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: normal;
  }

  #schedule-grid-table .sg-div-header--sticky {
    /* Indent applies only to the named first cell, not the colspan filler beside it. */
    padding-left: 1.1rem;
  }

  /* Sticky-left for the same reason as .sg-conf-header--sticky: without it, the opaque
     sticky first column beneath would show through this row once the grid is scrolled
     horizontally, leaving a color seam down the heading rows. */
  .sg-div-header--sticky {
    position: sticky;
    left: 0;
    z-index: 1;
  }

  /* Sticky first column (team name/logo/record) for every data row. */
  .sg-team-col {
    position: sticky;
    left: 0;
    z-index: 1;
    background: rgba(16, 23, 32, 0.98);
    /* Keeps logo + name + record (the user's explicit choice over name-only), but
       compressed: the record moves under the name in smaller mono type.

       Widened from 9.75rem when the rank was added to the name line. The rank and its gap
       take ~24px of a line the name used to own outright, and at 9.75rem that truncated 11
       real FBS teams -- "Mississippi State" rendered "Mississippi Sta...", with no way to
       recover the full name. Measured by ablation (hide the rank spans, re-measure
       scrollWidth vs clientWidth): 11 names truncated with the rank present, 0 without, and
       the widest name needs 130px. 12rem clears that with room to spare, and .sg-corner
       above carries the same value. Re-measure this if anything is added to that line. */
    min-width: 12rem;
    max-width: 12rem;
    white-space: normal;
  }

  .sg-team-cell {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .sg-team-logo {
    width: 1.1rem;
    height: 1.1rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* A team with no logo still occupies the logo's slot, so its name lines up with
     every other team's rather than sliding left against the column edge. */
  .sg-team-logo--empty {
    display: inline-block;
  }

  .sg-team-name-block {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
    /* T15: grow to fill the column so the rank's margin-left: auto below has slack to
       push against -- without this the block shrink-wraps the name and the rank sits
       flush against it instead of at the column's right edge. */
    flex: 1 1 auto;
  }

  /* T15: the name and the rank share one line, the rank pinned right. align-items:
     baseline (not center) so the two sit on the same text baseline even though they
     differ in size; with a name long enough to wrap, a flex item's first baseline is
     its first line's, which is the line the rank should align to. */
  .sg-team-name-line {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    min-width: 0;
  }

  .sg-team-name {
    color: var(--text);
    font-weight: 700;
    font-size: 0.75rem;
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Right-aligned via margin-left: auto rather than a fixed width: ranks run 1-3
     characters and a fixed slot would either clip a 3-digit rank or leave a gap after
     a 1-digit one. flex-shrink: 0 keeps the number intact when a long team name
     competes for the same line. */
  .sg-team-rank {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .sg-team-record {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.2;
    letter-spacing: 0;
  }

  /* Cell status coloring -- full-cell background on every played game, not
     alternating rows (a real CSS-specificity bug in the original mockup that
     must not be reintroduced).

     T10: all five statuses now get a SOLID background so the page's grid-line
     pattern (BaseLayout.astro's --grid-line, painted behind everything) never
     shows through a cell. --schedule-win-bg/--schedule-loss-bg are translucent
     tints (rgba(21,128,61,0.18) and rgba(153,27,27,0.18)) that used to composite
     over that grid pattern; simply setting their alpha to 1 would make them read
     far more saturated than before. Instead each is pre-composited onto the same
     solid base .sg-team-col already uses -- rgb(16, 23, 32) -- so the apparent
     tint intensity is unchanged while the result is fully opaque:

       result = tint * alpha + base * (1 - alpha), per channel, alpha = 0.18

       win:  R 21*0.18 + 16*0.82 = 16.90 -> 17
             G 128*0.18 + 23*0.82 = 41.90 -> 42
             B 61*0.18 + 32*0.82 = 37.22 -> 37   => rgb(17, 42, 37)

       loss: R 153*0.18 + 16*0.82 = 40.66 -> 41
             G 27*0.18 + 23*0.82 = 23.72 -> 24
             B 27*0.18 + 32*0.82 = 31.10 -> 31   => rgb(41, 24, 31)
  */
  .sg-cell--win {
    background: rgb(17, 42, 37);
    color: var(--schedule-win-text);
  }

  .sg-cell--loss {
    background: rgb(41, 24, 31);
    color: var(--schedule-loss-text);
  }

  .sg-cell--upcoming {
    background: rgba(16, 23, 32, 0.98);
    color: var(--text-soft);
  }

  .sg-cell--bye {
    background: rgba(16, 23, 32, 0.98);
  }

  .sg-cell--muted {
    background: rgba(16, 23, 32, 0.98);
  }

  .sg-game-name {
    display: block;
    margin-bottom: 0.05rem;
    color: inherit;
    opacity: 0.85;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: normal;
