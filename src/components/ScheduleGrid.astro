  }

  .sg-muted-text {
    color: var(--muted);
    font-style: italic;
    font-size: 0.66rem;
    line-height: 1.15;
    white-space: normal;
  }

  .sg-blank {
    color: var(--muted);
    opacity: 0.35;
  }

  /* Only tint the cell types with no status-driven background of their own --
     win/loss keep their solid highlight, and the sticky team column keeps its
     own opaque background regardless of hover, so it never looks translucent
     while other content scrolls underneath it. */
  /* Pre-composited onto the same rgb(16, 23, 32) base every cell now uses, rather than left
     as rgba(125, 211, 252, 0.05). A 95%-transparent hover replaced the solid base outright
     and reopened the T10 hole -- the page's grid-line pattern showing through -- on whichever
     cell the pointer happened to be over. Same arithmetic as RankingsTable.astro's zebra and
     hover tints:

       result = tint * alpha + base * (1 - alpha), per channel, alpha = 0.05
         R 125*0.05 + 16*0.95 = 21.45 -> 21
         G 211*0.05 + 23*0.95 = 32.40 -> 32
         B 252*0.05 + 32*0.95 = 43.00 -> 43        => rgb(21, 32, 43) */
  tbody tr:hover td.sg-cell--upcoming,
  tbody tr:hover td.sg-cell--bye,
  tbody tr:hover td.sg-cell--muted {
    background-color: rgb(21, 32, 43);
  }
</style>
