---
type TeamCell = { logo: string | null; name: string };

interface Props {
  headers: string[];
  rows: Array<Array<string | number | TeamCell>>;
}

const { headers, rows } = Astro.props;

function isTeamCell(cell: string | number | TeamCell): cell is TeamCell {
  return typeof cell === "object" && cell !== null;
}
---

<div class="rankings-shell">
  <table>
    <thead>
      <tr>
        {headers.map((header) => <th>{header}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, index) => (
            <td class={index === 0 ? "rank-col" : ""}>
              {isTeamCell(cell) ? (
                cell.logo ? (
                  <span class="team-cell">
                    <img class="team-logo" src={cell.logo} alt="" loading="lazy" decoding="async" />
                    {cell.name}
                  </span>
                ) : (
                  cell.name
                )
              ) : (
                cell
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .rankings-shell {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
  }

  table {
    width: 100%;
    min-width: 31rem;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.85rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }

  th:nth-child(1),
  td:nth-child(1),
  th:nth-child(4),
  td:nth-child(4),
  th:nth-child(6),
  td:nth-child(6) {
    text-align: center;
  }

  th:nth-child(5),
  td:nth-child(5) {
    text-align: right;
  }

  th {
    position: sticky;
    top: 0;
    background: rgba(10, 15, 20, 0.96);
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  td {
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  td:not(:nth-child(2)) {
    font-family: var(--font-mono);
  }

  .rank-col {
    color: var(--text);
    font-weight: 700;
  }

  .team-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .team-logo {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  tbody tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.02);
  }

  tbody tr:hover {
    background: rgba(125, 211, 252, 0.04);
  }
</style>
