---
type TeamCell = { logo: string | null; name: string };
// Delta arrives as a raw number wrapped in an object (never a plain string/number cell) so
// isDeltaCell can distinguish it positionally from Rank (a plain number) and Rating (a plain
// string) without relying on column index. Sign convention: delta = previous_rank - current_rank
// with rank 1 best, so a POSITIVE delta means the team ROSE (fewer = better rank).
type DeltaCell = { delta: number };

interface Props {
  headers: string[];
  rows: Array<Array<string | number | TeamCell | DeltaCell>>;
}

const { headers, rows } = Astro.props;

// Accessible names for headers whose visible text is a symbol rather than a word. "\u0394"
// is the Greek capital delta the Delta column now uses: screen readers announce a bare
// mathematical symbol inconsistently (Chromium says "increment", others read nothing at
// all), so the column header gets a real name. aria-label is valid here where it was NOT on
// the plain <span> in ScheduleGrid.astro -- a <th> is role=columnheader, which permits
// author naming; a role=generic span does not.
//
// The same string is also the `title`, so a sighted reader who does not know the convention
// gets the word on hover -- the aria-label alone serves screen readers and leaves everyone
// else with an unexplained symbol where a word used to be.
//
// A header not in this map gets `undefined`, and Astro omits an attribute set to undefined,
// so every word header renders exactly as before, with neither attribute.
const HEADER_ARIA_LABELS: Record<string, string> = {
  "\u0394": "Delta",
};

function isTeamCell(cell: string | number | TeamCell | DeltaCell): cell is TeamCell {
  return typeof cell === "object" && cell !== null && "name" in cell;
}

function isDeltaCell(cell: string | number | TeamCell | DeltaCell): cell is DeltaCell {
  return typeof cell === "object" && cell !== null && "delta" in cell;
}

// Mirrored verbatim in index.astro's client-side buildDeltaCellNode() -- see that file's
// comment for why the duplication exists (client-rebuilt rows can't reuse this component).
function deltaDirection(delta: number): "up" | "down" | "flat" {
  if (delta > 0) return "up";
  if (delta < 0) return "down";
  return "flat";
}

function deltaAriaLabel(delta: number): string {
  if (delta > 0) return `Up ${delta}`;
  if (delta < 0) return `Down ${Math.abs(delta)}`;
  // Expected, not a bug: delta is never null -- a team with no previous week emits 0, so a
  // team that genuinely held its rank is indistinguishable from one with no prior week. That
  // distinction would need a pipeline change and is out of scope here.
  return "No change";
}
---

<div class="rankings-shell">
  <table>
    <thead>
      <tr>
        {headers.map((header) => (
          <th aria-label={HEADER_ARIA_LABELS[header]} title={HEADER_ARIA_LABELS[header]}>{header}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, index) => (
            <td class={index === 0 ? "rank-col" : ""}>
              {isTeamCell(cell) ? (
                cell.logo ? (
                  <span class="team-cell">
                    <img class="team-logo" src={cell.logo} alt="" loading="lazy" decoding="async" />
                    {cell.name}
                  </span>
                ) : (
                  cell.name
                )
              ) : isDeltaCell(cell) ? (
                (() => {
                  const direction = deltaDirection(cell.delta);
                  return (
                    <span
                      class={`delta-cell delta-cell--${direction}`}
                      role="img"
                      aria-label={deltaAriaLabel(cell.delta)}
                    >
                      {direction === "flat" ? (
                        <span class="delta-glyph" aria-hidden="true">–</span>
                      ) : (
                        <>
                          <span class="delta-glyph" aria-hidden="true">{direction === "up" ? "▲" : "▼"}</span>
                          <span class="delta-value" aria-hidden="true">{Math.abs(cell.delta)}</span>
                        </>
                      )}
                    </span>
                  );
                })()
              ) : (
                cell
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style is:global>
  /*
    Global, not scoped: the season/week switcher on the consuming page rebuilds table rows
    client-side via document.createElement, and those elements never get Astro's scoped-style
    data-astro-cid-* attribute -- scoped selectors would silently stop matching them the moment
    a user changes the selection, breaking padding/alignment/borders on every re-rendered row.
    This component is only ever used on the CFB Rankings page, so going global here is safe.
  */
  .rankings-shell {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    /* Solid, matching ScheduleGrid.astro's .sg-team-col (T10): the backdrop
       behind every cell, so the page's grid-line pattern (BaseLayout.astro's
       --grid-line) never shows through, including in the bottom padding below. */
    background: rgba(16, 23, 32, 0.98);
    /* T11b: room at the bottom so the horizontal scrollbar (see below) never
       overlaps the last team row. */
    padding-bottom: 0.85rem;
    /* T11b: dark, translucent scrollbar consistent with the site's theme. Standards
       property first (Firefox and any Chromium build honoring it); WebKit
       pseudo-elements below cover Chrome/Safari, since neither alone covers both. */
    scrollbar-color: rgba(173, 196, 221, 0.35) rgba(255, 255, 255, 0.04);
    scrollbar-width: thin;
    /* Hug the table rather than spanning the card: the table is now content-sized, so a
       full-width shell would frame a large empty panel to its right. max-width keeps it
       from overflowing on a narrow viewport, where it scrolls instead. */
    width: max-content;
    max-width: 100%;
    /* Centred in the tile. Hugging the content left the compact table pinned to the card's
       left edge with all the slack pooled on one side, which read as misaligned rather than
       as deliberate.

       Once max-width: 100% binds on a narrow viewport there is no slack to distribute and
       the shell sits where it did before -- NOT because the auto margins resolve to 0 on
       both sides, which is what an earlier version of this comment claimed. They resolve to
       0 and -2px: this element computes box-sizing: content-box, because the site's
       * { box-sizing: border-box } lives in BaseLayout's SCOPED style block and is rewritten
       to *[data-astro-cid-...], which never reaches an is:global element like this one. Its
       two 1px borders therefore fall outside max-width: 100%, over-constraining the box.
       The resulting 2px overhang predates this rule (main has the same 2px, all on the
       right) and is left alone here rather than "fixed" with box-sizing: border-box, which
       would also change how width: max-content above resolves. */
    margin-left: auto;
    margin-right: auto;
  }

  .rankings-shell::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .rankings-shell::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
  }

  .rankings-shell::-webkit-scrollbar-thumb {
    background-color: rgba(173, 196, 221, 0.35);
    border-radius: 6px;
    border: 2px solid rgba(16, 23, 32, 0.98);
  }

  .rankings-shell::-webkit-scrollbar-thumb:hover {
    background-color: rgba(173, 196, 221, 0.5);
  }

  table {
    /* Deliberately NOT width:100%. Stretching the table to fill the shell distributed the
       slack across all six columns -- a two-digit rank was getting 127px and the delta
       column 136px, which is the "spacing looks weird" this change was asked to fix.
       max-content sizes to the widest real row instead, and max-width:100% keeps it from
       overflowing the shell on a narrow viewport (the shell scrolls in that case). */
    width: max-content;
    max-width: 100%;
    /* The old min-width: 31rem floor is gone with it: measured, this table's min-content is
       ~545px, so any floor below that never binds. table-layout stays
       "auto" (the default) rather than "fixed" like ScheduleGrid.astro's grid: that grid has
       many structurally-identical week-slot columns where fixed widths make sense, but this
       table's six columns vary widely in natural content width (a team name+logo vs. a
       2-character delta vs. a conference name), so auto layout's content-driven sizing suits
       it better than hand-picked fixed widths would. */
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.85rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }

  /* T10: solid base so the page's grid-line pattern never shows through a cell,
     matching ScheduleGrid.astro's .sg-team-col (rgb(16, 23, 32)). A td's own
     background always paints over its row's background, so this alone would
     also erase the zebra striping and hover tint below -- both are recomputed
     against this same base, same as ScheduleGrid.astro's win/loss tints, so
     they keep their prior apparent intensity instead of just disappearing.

     Scoped to .rankings-shell (unlike the other, pre-existing bare th/td rules
     in this global stylesheet): a bare `td` background here would out-specificity
     ScheduleGrid.astro's own classed cell rules (e.g. .sg-cell--win) once this
     property moves from tr to td below, silently repainting Season Grid cells
     whenever this component's global styles happen to load alongside it. */
  .rankings-shell td {
    background: rgba(16, 23, 32, 0.98);
  }

  /* Every column NAME is centred (see .rankings-shell th below); these rules now govern the
     BODY cells only, which is why they dropped their th selectors rather than being
     out-specificitied by a later th rule -- an equal-specificity override that depends on
     source order is the kind of thing a later edit reorders and silently breaks.
  
     Column order (T12): Rank, Team, Record, Rating, Delta, Conference. Centered: Rank(1),
     Record(3), Delta(5) -- same three columns that were centered before the reorder, just at
     their new positions. Team(2) and Conference(6) stay left-aligned (the default `text-align:
     left` above); Rating(4) is right-aligned below. Getting these nth-child indices wrong after
     a reorder fails silently -- no error, just wrong alignment -- so check the computed
     text-align per column in a browser rather than trusting the source to read correctly. */
  td:nth-child(1),
  td:nth-child(3),
  td:nth-child(5) {
    text-align: center;
  }

  td:nth-child(4) {
    text-align: right;
  }

  /* Scoped, unlike the other bare element rules in this global sheet. As a bare `th` this
     reached ScheduleGrid.astro's markup too, where it pinned every conference AND division
     heading cell to top: 0 -- so scrolling the grid stacked all the passed headings behind
     the real header row. Invisible today only because .sg-th carries a higher z-index and a
     near-opaque background, and each new heading row type added to that grid makes it one
     row worse. The remaining bare rules here (table, th/td, td, the nth-child set) leak the
     same way and are deliberately left alone in this pass: unlike position, several of them
     are currently load-bearing for the Season Grid's own typography, so unpicking them is a
     visual change in its own right rather than a fix. */
  .rankings-shell th {
    /* All six column names centred over their columns, regardless of how the cells beneath
       them are aligned -- the header row reads as one band that way, where per-column header
       alignment made the compact table look ragged along its top edge. */
    text-align: center;
    position: sticky;
    top: 0;
    background: rgba(10, 15, 20, 0.96);
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  td {
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  td:not(:nth-child(2)) {
    font-family: var(--font-mono);
  }

  .rank-col {
    color: var(--text);
    font-weight: 700;
  }

  .team-cell {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .team-logo {
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* Delta glyphs (T12). .delta-cell/.delta-glyph/.delta-value are new, uniquely-named classes
     with no ScheduleGrid.astro counterpart, so there's no leak risk the way the bare td rules
     above have -- scoped to .rankings-shell anyway, for the same "both files share a document"
     reason as the zebra/hover rules above, rather than relying on the name being unique today.
     Colour is never the only signal: direction is also carried by the glyph (▲/▼/–), and the
     wrapper exposes a single text alternative via role="img" + aria-label ("Up 2" / "Down 3" /
     "No change") while its children are aria-hidden, so screen readers get one clean phrase
     instead of the glyph and the bare number read out separately. */
  .rankings-shell .delta-cell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.32rem;
  }

  .rankings-shell .delta-glyph {
    font-size: 0.68rem;
    line-height: 1;
  }

  .rankings-shell .delta-cell--up .delta-glyph,
  .rankings-shell .delta-cell--up .delta-value {
    color: var(--schedule-win-text);
  }

  .rankings-shell .delta-cell--down .delta-glyph,
  .rankings-shell .delta-cell--down .delta-value {
    color: var(--schedule-loss-text);
  }

  .rankings-shell .delta-cell--flat .delta-glyph {
    color: var(--accent-method);
  }

  /* Both used to be set on the <tr>, relying on td having no background of its
     own so the row color would show through. Now that td has a solid background
     (above), a tr-level background would be fully hidden -- so both are moved to
     target td directly, each pre-composited onto that same rgb(16, 23, 32) base
     so they keep their prior apparent intensity instead of vanishing:

       result = tint * alpha + base * (1 - alpha), per channel

       zebra (rgba(255,255,255,0.02), alpha = 0.02):
         R 255*0.02 + 16*0.98 = 20.78 -> 21
         G 255*0.02 + 23*0.98 = 27.64 -> 28
         B 255*0.02 + 32*0.98 = 36.46 -> 36        => rgb(21, 28, 36)

       hover (rgba(125,211,252,0.04), alpha = 0.04):
         R 125*0.04 + 16*0.96 = 20.36 -> 20
         G 211*0.04 + 23*0.96 = 30.52 -> 31
         B 252*0.04 + 32*0.96 = 40.80 -> 41        => rgb(20, 31, 41)

     hover is declared after zebra, same as the tr-level rules were, so it wins
     on an even row exactly like before (equal specificity, source order). Both
     are scoped to .rankings-shell for the same cross-component reason as the
     base td rule above -- an unscoped `tbody tr:nth-child(even) td` would
     otherwise outrank ScheduleGrid.astro's .sg-cell--* classes on its own
     table's even rows. */
  .rankings-shell tbody tr:nth-child(even) td {
    background: rgb(21, 28, 36);
  }

  .rankings-shell tbody tr:hover td {
    background: rgb(20, 31, 41);
  }
</style>
