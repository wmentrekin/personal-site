---
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Sports analytics, data engineering, and technical portfolio work by Wyatt Entrekin."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&family=Inter+Tight:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <ViewTransitions />

    <style>
      :root {
        color-scheme: dark;
        --font-body: "Inter", "Segoe UI", sans-serif;
        --font-display: "Inter Tight", "Inter", "Segoe UI", sans-serif;
        --font-mono: "IBM Plex Mono", "SFMono-Regular", monospace;
        --bg-0: #0a0f14;
        --bg-1: #101720;
        --bg-2: #16212d;
        --surface: rgba(16, 23, 32, 0.82);
        --surface-strong: rgba(19, 28, 39, 0.94);
        --surface-soft: rgba(255, 255, 255, 0.03);
        --text: #f3f7fb;
        --text-soft: #d8e2ed;
        --muted: #96a9bc;
        --line: rgba(173, 196, 221, 0.14);
        --line-strong: rgba(173, 196, 221, 0.24);
        --grid-line: rgba(173, 196, 221, 0.055);
        --accent: #7dd3fc;
        --accent-football: #a3e635;
        --accent-basketball: #fb923c;
        --accent-baseball: #60a5fa;
        --accent-method: #facc15;
        --accent-archive: #94a3b8;
        --accent-travel: #5eead4;
        --error-bg: rgba(123, 24, 24, 0.16);
        --error-text: #f6b1b1;
        --shadow-card:
          0 18px 42px rgba(0, 0, 0, 0.32),
          inset 0 1px 0 rgba(255, 255, 255, 0.04);
        --shadow-hover:
          0 24px 56px rgba(0, 0, 0, 0.4),
          inset 0 1px 0 rgba(255, 255, 255, 0.06);
        --radius-sm: 16px;
        --radius-md: 20px;
        --radius-lg: 24px;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        scroll-behavior: smooth;
      }

      body {
        position: relative;
        font-family: var(--font-body);
        color: var(--text);
        background:
          linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
          linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px),
          linear-gradient(180deg, var(--bg-1) 0%, var(--bg-0) 55%, #070b10 100%);
        background-size: 42px 42px, 42px 42px, auto;
        background-attachment: fixed;
      }

      a {
        color: inherit;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.4rem;
      }

      main {
        padding-block: 1.5rem 3rem;
      }

      .muted {
        color: var(--muted);
        line-height: 1.75;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.4rem;
      }

      .card {
        background: linear-gradient(160deg, rgba(19, 28, 39, 0.92), rgba(11, 18, 26, 0.98));
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: 1.35rem;
        box-shadow: var(--shadow-card);
      }

      .card h2,
      .card h3 {
        margin-top: 0;
        margin-bottom: 0.7rem;
      }

      .card ul,
      .card ol {
        margin: 0.7rem 0;
        padding-left: 1.3rem;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        text-align: left;
        padding: 0.78rem;
        border-bottom: 1px solid var(--line);
      }

      th {
        color: var(--muted);
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .error {
        background: var(--error-bg);
        color: var(--error-text);
        border: 1px solid rgba(246, 177, 177, 0.22);
        border-radius: 14px;
        padding: 0.8rem 0.9rem;
        margin: 0.75rem 0;
        font-weight: 600;
      }

      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 520ms ease, transform 520ms ease;
        will-change: opacity, transform;
      }

      .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        html,
        body {
          scroll-behavior: auto;
        }

        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }

        * {
          animation: none !important;
          transition-duration: 0.01ms !important;
        }
      }

      @media (max-width: 820px) {
        .grid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <style is:global>
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        width: fit-content;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
        transition: color 180ms ease;
      }

      .back-link:hover {
        color: var(--text);
      }

      .quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.35rem;
        margin-top: 1.35rem;
      }

      .quick-card,
      .tile-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 16rem;
        padding: 1.6rem;
        border-radius: var(--radius-lg);
        border: 1px solid var(--line);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
          linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
        box-shadow: var(--shadow-card);
        color: var(--text);
        text-align: center;
        text-decoration: none;
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
      }

      .quick-card:hover,
      .tile-link:hover,
      .link-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
      }

      .quick-card h2,
      .tile-link h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.4rem;
        line-height: 1.05;
        letter-spacing: -0.03em;
        text-transform: none;
      }

      .tile-link h3 {
        margin: 0.65rem 0 0;
        max-width: 30rem;
        color: var(--muted);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.65;
      }

      .tone-football {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 32%),
          linear-gradient(160deg, rgba(163, 230, 53, 0.08), rgba(19, 28, 39, 0.72)),
          linear-gradient(160deg, rgba(19, 28, 39, 0.72), rgba(11, 18, 26, 0.84));
        backdrop-filter: blur(10px);
      }

      .tone-projects {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 32%),
          linear-gradient(160deg, rgba(125, 211, 252, 0.08), rgba(19, 28, 39, 0.72)),
          linear-gradient(160deg, rgba(19, 28, 39, 0.72), rgba(11, 18, 26, 0.84));
        backdrop-filter: blur(10px);
      }

      .tone-about {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 32%),
          linear-gradient(160deg, rgba(250, 204, 21, 0.08), rgba(19, 28, 39, 0.72)),
          linear-gradient(160deg, rgba(19, 28, 39, 0.72), rgba(11, 18, 26, 0.84));
        backdrop-filter: blur(10px);
      }

      .tone-now {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 32%),
          linear-gradient(160deg, rgba(148, 163, 184, 0.1), rgba(19, 28, 39, 0.72)),
          linear-gradient(160deg, rgba(19, 28, 39, 0.72), rgba(11, 18, 26, 0.84));
        backdrop-filter: blur(10px);
      }

      .tone-travel {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 32%),
          linear-gradient(160deg, rgba(94, 234, 212, 0.1), rgba(19, 28, 39, 0.72)),
          linear-gradient(160deg, rgba(19, 28, 39, 0.72), rgba(11, 18, 26, 0.84));
        backdrop-filter: blur(10px);
      }

      .tone-election {
        background:
          linear-gradient(160deg, rgba(148, 163, 184, 0.1), rgba(19, 28, 39, 0.96)),
          linear-gradient(160deg, rgba(19, 28, 39, 0.96), rgba(11, 18, 26, 0.98));
      }

      .tone-linkedin {
        background:
          linear-gradient(145deg, rgba(125, 211, 252, 0.2), rgba(22, 33, 45, 0.98) 62%, rgba(10, 15, 20, 1));
      }

      .tone-repo {
        background:
          linear-gradient(145deg, rgba(96, 165, 250, 0.2), rgba(22, 33, 45, 0.98) 62%, rgba(10, 15, 20, 1));
      }

      .tone-streamlit {
        background:
          linear-gradient(145deg, rgba(251, 146, 60, 0.18), rgba(22, 33, 45, 0.98) 62%, rgba(10, 15, 20, 1));
      }

      .tone-method {
        background:
          linear-gradient(145deg, rgba(250, 204, 21, 0.18), rgba(22, 33, 45, 0.98) 62%, rgba(10, 15, 20, 1));
      }

      .link-card-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 0.8rem;
        margin: 1rem 0 1.1rem;
      }

      .link-card-row.single {
        max-width: 20rem;
      }

      .link-card {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 4rem;
        padding: 0.6rem 0.9rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-card);
        color: var(--text);
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
      }

      @media (max-width: 820px) {
        .quick-grid {
          grid-template-columns: 1fr;
        }

        .quick-card,
        .tile-link {
          min-height: 13rem;
        }
      }
    </style>
  </head>
  <body>
    <main class="container">
      <slot />
    </main>

    <script is:inline>
      const initReveal = () => {
        const items = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          items.forEach((item) => item.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.14, rootMargin: "0px 0px -10% 0px" }
        );

        items.forEach((item) => observer.observe(item));
      };

      document.addEventListener("astro:page-load", initReveal);
      initReveal();
    </script>
  </body>
</html>
