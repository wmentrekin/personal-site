---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Data engineering and analytics projects by Wyatt Entrekin."
} = Astro.props;

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" }
];

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      :root {
        color-scheme: dark;
        --bg: #080b12;
        --bg-accent: #182742;
        --card: #0f151f;
        --text: #e7ecf3;
        --muted: #97a2b2;
        --line: #233248;
        --accent: #63a5ff;
        --accent-strong: #96c4ff;
        --soft: #151c2a;
        --error-bg: #2a1418;
        --error-text: #f4a8b7;
      }

      * {
        box-sizing: border-box;
      }
      

      body {
        margin: 0;
        font-family: "Avenir Next", "Trebuchet MS", "Segoe UI", Tahoma, sans-serif;
        background:
          radial-gradient(1100px 700px at 10% -15%, rgba(54, 108, 199, 0.34) 0%, transparent 52%),
          radial-gradient(900px 620px at 90% 0%, rgba(24, 58, 121, 0.34) 0%, transparent 48%),
          linear-gradient(180deg, #0b1220 0%, var(--bg) 48%);
        color: var(--text);
      }

      header {
        border-bottom: 1px solid var(--line);
        background: rgba(9, 11, 16, 0.85);
        backdrop-filter: blur(4px);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .container {
        max-width: 1040px;
        margin: 0 auto;
        padding: 1.25rem;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .brand {
        font-weight: 800;
        text-decoration: none;
        color: var(--text);
        letter-spacing: 0.2px;
      }

      nav .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      nav .links a {
        color: var(--text);
        text-decoration: none;
        font-weight: 650;
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
      }

      nav .links a.active {
        background: var(--soft);
        color: var(--text);
      }

      main {
        padding-block: 2rem 2.7rem;
      }

      .hero {
        padding: 0.2rem 0 0.5rem;
      }

      .hero h1 {
        margin-top: 0;
        margin-bottom: 0.55rem;
      }

      .quick-grid {
        margin-top: 0.2rem;
      }

      .quick-card,
      .tile-link {
        color: var(--text);
      }

      .quick-card:hover,
      .tile-link:hover {
        transform: translateY(-1px);
      }

      .tile-icon {
        width: 48px;
        height: 48px;
      }

      .tone-projects {
        background: linear-gradient(145deg, #0d1b35, #20355b);
      }

      .tone-about {
        background: linear-gradient(145deg, #1b1230, #2a1f4a);
      }

      .tone-cfb {
        background: linear-gradient(145deg, #0f2638, #1f4e63);
      }

      .tone-election {
        background: linear-gradient(145deg, #34151f, #4a2630);
      }

      .muted {
        color: var(--muted);
        line-height: 1.7;
      }

      .button-row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1.1rem;
      }

      .button {
        background: var(--accent);
        color: #0a1020;
        text-decoration: none;
        padding: 0.7rem 1rem;
        border-radius: 10px;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(34, 99, 255, 0.28);
      }

      .button.secondary {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--line);
      }

      .section-title {
        margin: 2rem 0 0.9rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.2rem;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.2rem;
        box-shadow:
          0 16px 40px rgba(0, 0, 0, 0.28),
          0 1px 0 rgba(255, 255, 255, 0.03) inset;
      }

      .card h2,
      .card h3 {
        margin-top: 0;
        margin-bottom: 0.6rem;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        text-align: left;
        padding: 0.72rem;
        border-bottom: 1px solid var(--line);
      }

      th {
        font-size: 0.92rem;
        color: #c8d2e2;
      }

      .error {
        background: var(--error-bg);
        color: var(--error-text);
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        margin: 0.75rem 0;
        font-weight: 600;
      }

      .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        color: var(--accent-strong);
        font-weight: 700;
        margin-bottom: 0.35rem;
      }

      @media (max-width: 820px) {
        .grid {
          grid-template-columns: 1fr;
        }

        nav {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
    <style is:global>
      .quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.3rem;
        margin-top: 1.2rem;
      }

      .quick-card,
      .tile-link {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        text-decoration: none;
        color: var(--text);
        background: linear-gradient(150deg, #111a29, #162338);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 1.45rem;
        min-height: 300px;
        box-shadow:
          0 20px 44px rgba(0, 0, 0, 0.33),
          0 1px 0 rgba(255, 255, 255, 0.03) inset;
        transition: border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
      }

      .quick-card:hover,
      .tile-link:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
        box-shadow:
          0 28px 55px rgba(0, 0, 0, 0.45),
          0 1px 0 rgba(255, 255, 255, 0.05) inset;
      }

      .quick-card h2,
      .tile-link h2 {
        margin: 0.8rem 0 0;
        font-size: 1.65rem;
        color: var(--text);
      }

      .tile-icon {
        width: 68px;
        height: 68px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.09);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
      }

      .tone-projects {
        background: linear-gradient(145deg, #0d1b35, #20355b);
      }

      .tone-about {
        background: linear-gradient(145deg, #1b1230, #2a1f4a);
      }

      .tone-cfb {
        background: linear-gradient(145deg, #0f2638, #1f4e63);
      }

      .tone-election {
        background: linear-gradient(145deg, #34151f, #4a2630);
      }

      @media (max-width: 820px) {
        .quick-grid {
          grid-template-columns: 1fr;
        }

        .quick-card,
        .tile-link {
          min-height: 230px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/">Wyatt Entrekin</a>
          <div class="links">
            {
              navLinks.map((link) => (
                <a href={link.href} class={isActive(link.href) ? "active" : ""}>{link.label}</a>
              ))
            }
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
  </body>
</html>
