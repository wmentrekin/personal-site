---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Data engineering and analytics projects by Wyatt Entrekin."
} = Astro.props;

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" }
];

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      :root {
        color-scheme: light;
        --bg: #f7fafc;
        --bg-accent: #e6f0ff;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #475569;
        --line: #dbe4ef;
        --accent: #0a66c2;
        --accent-strong: #084b8f;
        --soft: #edf3fb;
        --error-bg: #fef2f2;
        --error-text: #991b1b;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Trebuchet MS", "Segoe UI", Tahoma, sans-serif;
        background: radial-gradient(circle at 0% 0%, var(--bg-accent), var(--bg) 42%);
        color: var(--text);
      }

      header {
        border-bottom: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.93);
        backdrop-filter: blur(4px);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .container {
        max-width: 1040px;
        margin: 0 auto;
        padding: 1rem;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .brand {
        font-weight: 800;
        text-decoration: none;
        color: var(--text);
        letter-spacing: 0.2px;
      }

      nav .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      nav .links a {
        color: var(--text);
        text-decoration: none;
        font-weight: 650;
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
      }

      nav .links a.active {
        background: var(--soft);
        color: var(--accent-strong);
      }

      main {
        padding-block: 1.5rem 2rem;
      }

      .hero {
        background: linear-gradient(115deg, #ffffff, #f2f7ff);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.2rem;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
      }

      .hero h1 {
        margin-top: 0;
        margin-bottom: 0.4rem;
      }

      .muted {
        color: var(--muted);
        line-height: 1.55;
      }

      .button-row {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-top: 0.9rem;
      }

      .button {
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        padding: 0.6rem 0.85rem;
        border-radius: 10px;
        font-weight: 700;
      }

      .button.secondary {
        background: #fff;
        color: var(--accent-strong);
        border: 1px solid var(--line);
      }

      .section-title {
        margin: 1.4rem 0 0.6rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
      }

      .card h2,
      .card h3 {
        margin-top: 0;
        margin-bottom: 0.45rem;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        text-align: left;
        padding: 0.62rem;
        border-bottom: 1px solid var(--line);
      }

      th {
        font-size: 0.92rem;
        color: #1f2937;
      }

      .error {
        background: var(--error-bg);
        color: var(--error-text);
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        margin: 0.75rem 0;
        font-weight: 600;
      }

      .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        color: var(--accent-strong);
        font-weight: 700;
        margin-bottom: 0.35rem;
      }

      footer {
        margin-top: 2.1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.9rem;
      }

      @media (max-width: 820px) {
        .grid {
          grid-template-columns: 1fr;
        }

        nav {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/">Wyatt Entrekin</a>
          <div class="links">
            {
              navLinks.map((link) => (
                <a href={link.href} class={isActive(link.href) ? "active" : ""}>{link.label}</a>
              ))
            }
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
      <footer>Static-first site on Cloudflare Pages. CFB is artifact-driven for reliability.</footer>
    </main>
  </body>
</html>
