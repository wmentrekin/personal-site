---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Data engineering and analytics projects by Wyatt Entrekin."
} = Astro.props;

const pathname = Astro.url.pathname;
const projectLinks = [
  { href: "/projects/cfb-rankings", label: "CFB Rankings" },
  { href: "/projects/2020-election-model", label: "2020 Election Model" }
];
const projectsActive = pathname === "/projects" || pathname.startsWith("/projects/");

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <style>
      :root {
        color-scheme: light;
        --bg-deep: #f4ece8;
        --bg-top: #fbf7f4;
        --surface: #fffcfa;
        --text: #2e1f1f;
        --muted: #705858;
        --line: rgba(137, 100, 94, 0.28);
        --soft: rgba(239, 216, 215, 0.84);
        --glass: rgba(255, 247, 244, 0.7);
        --glass-strong: rgba(254, 246, 242, 0.92);
        --accent: #8e3d3a;
        --accent-soft: #f1d8d7;
        --card-line: rgba(176, 132, 127, 0.28);
        --error-bg: #fff0f0;
        --error-text: #9f2e2e;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        font-family: "Avenir Next", "Trebuchet MS", "Segoe UI", Tahoma, sans-serif;
        color: var(--text);
        background:
          radial-gradient(1100px 660px at 8% -10%, rgba(177, 94, 88, 0.17) 0%, transparent 64%),
          radial-gradient(900px 620px at 90% -3%, rgba(206, 150, 113, 0.14) 0%, transparent 62%),
          linear-gradient(180deg, var(--bg-top) 0%, #f7efe9 52%, var(--bg-deep) 100%);
        background-attachment: fixed;
      }

      header {
        border-bottom: 1px solid rgba(178, 137, 132, 0.32);
        background: linear-gradient(180deg, rgba(255, 250, 247, 0.86), rgba(253, 246, 242, 0.78));
        backdrop-filter: blur(14px) saturate(125%);
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 1.25rem;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .brand {
        font-weight: 800;
        text-decoration: none;
        color: var(--text);
        letter-spacing: 0.2px;
      }

      nav .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      nav .links a {
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        padding: 0.45rem 0.78rem;
        border-radius: 999px;
        border: 1px solid transparent;
        transition:
          background-color 150ms ease,
          border-color 150ms ease,
          box-shadow 150ms ease,
          color 150ms ease;
      }

      nav .links a:hover {
        background: rgba(225, 194, 190, 0.5);
        border-color: rgba(168, 117, 112, 0.44);
      }

      nav .links a.active {
        background: var(--soft);
        border-color: rgba(160, 101, 97, 0.46);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
      }

      nav .links .projects-nav {
        position: relative;
      }

      nav .links .projects-trigger {
        display: flex;
        align-items: center;
        gap: 0.38rem;
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        padding: 0.45rem 0.78rem;
        border-radius: 999px;
        border: 1px solid transparent;
        user-select: none;
        transition:
          background-color 150ms ease,
          border-color 150ms ease,
          box-shadow 150ms ease,
          color 150ms ease;
      }

      nav .links .projects-trigger::after {
        content: "▾";
        font-size: 0.75rem;
        opacity: 0.86;
        transform: translateY(1px);
      }

      nav .links .projects-nav.active .projects-trigger,
      nav .links .projects-nav:hover .projects-trigger,
      nav .links .projects-nav:focus-within .projects-trigger {
        background: var(--soft);
        border-color: rgba(160, 101, 97, 0.46);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
      }

      nav .links .projects-menu {
        position: absolute;
        top: 100%;
        right: 0;
        min-width: 220px;
        display: none;
        gap: 0.26rem;
        padding: 0.5rem;
        margin-top: 0;
        background: var(--glass-strong);
        border: 1px solid rgba(170, 124, 119, 0.46);
        box-shadow:
          0 18px 38px rgba(74, 42, 39, 0.2),
          0 1px 0 rgba(255, 255, 255, 0.72) inset;
        backdrop-filter: blur(12px) saturate(130%);
        border-radius: 12px;
        z-index: 35;
      }

      nav .links .projects-nav:hover .projects-menu,
      nav .links .projects-nav:focus-within .projects-menu {
        display: grid;
      }

      nav .links .projects-menu a {
        border-radius: 8px;
        padding: 0.54rem 0.64rem;
        white-space: nowrap;
      }

      nav .links .projects-menu a:hover {
        background: rgba(228, 199, 194, 0.64);
      }

      nav .links .projects-menu a.active {
        background: rgba(236, 207, 203, 0.8);
        border-color: rgba(155, 94, 90, 0.48);
      }

      nav .links .projects-nav:focus-within {
        outline: none;
      }

      nav .links .projects-nav:focus-within .projects-trigger {
        color: #2e1f1f;
      }

      main {
        padding-block: 2.4rem 3rem;
      }

      .hero {
        padding: 0.2rem 0 0.5rem;
      }

      .hero h1 {
        margin-top: 0;
        margin-bottom: 0.7rem;
      }

      .muted {
        color: var(--muted);
        line-height: 1.7;
      }

      .section-title {
        margin: 2rem 0 0.9rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.2rem;
      }

      .card {
        background: linear-gradient(160deg, rgba(255, 252, 250, 0.96), rgba(252, 245, 241, 0.94));
        border: 1px solid var(--card-line);
        border-radius: 0;
        padding: 1.2rem;
        box-shadow:
          0 16px 34px rgba(82, 48, 45, 0.12),
          0 1px 0 rgba(255, 255, 255, 0.78) inset;
      }

      .card h2,
      .card h3 {
        margin-top: 0;
        margin-bottom: 0.6rem;
      }

      .card ul,
      .card ol {
        margin: 0.7rem 0;
        padding-left: 1.45rem;
        list-style-position: outside;
      }

      .card li {
        margin-bottom: 0.45rem;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        text-align: left;
        padding: 0.72rem;
        border-bottom: 1px solid var(--line);
      }

      th {
        font-size: 0.92rem;
        color: #6f5552;
      }

      .error {
        background: var(--error-bg);
        color: var(--error-text);
        border: 1px solid #efb0b0;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        margin: 0.75rem 0;
        font-weight: 600;
      }

      @media (max-width: 820px) {
        .grid {
          grid-template-columns: 1fr;
        }

        nav {
          align-items: flex-start;
          flex-direction: column;
        }

        nav .links .projects-menu {
          position: static;
          min-width: 0;
          margin-top: 0.36rem;
        }
      }
    </style>

    <style is:global>
      .quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.35rem;
        margin-top: 1.35rem;
      }

      .quick-card,
      .tile-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-decoration: none;
        color: var(--text);
        border: 1px solid var(--card-line);
        border-radius: 0;
        padding: 1.5rem;
        min-height: 260px;
        box-shadow:
          0 20px 40px rgba(82, 48, 45, 0.14),
          0 1px 0 rgba(255, 255, 255, 0.84) inset;
        transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
      }

      .quick-card:hover,
      .tile-link:hover {
        border-color: rgba(142, 61, 58, 0.58);
        transform: translateY(-3px);
        box-shadow:
          0 26px 52px rgba(92, 54, 52, 0.2),
          0 1px 0 rgba(255, 255, 255, 0.9) inset;
      }

      .quick-card h2,
      .tile-link h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.11em;
        line-height: 1.2;
      }

      .tile-link h3 {
        margin: 0.55rem 0 0;
        font-size: 1rem;
        font-weight: 560;
        line-height: 1.45;
        letter-spacing: 0.01em;
        text-transform: none;
        color: #6d5855;
        max-width: 34ch;
      }

      .tone-projects {
        background: linear-gradient(150deg, #fff4f2, #f2d9d8 58%, #ecd0cf);
      }

      .tone-about {
        background: linear-gradient(150deg, #fff7f5, #efddcf 60%, #e6d2c6);
      }

      .tone-cfb {
        background: linear-gradient(150deg, #fff5f3, #f0d1cc 60%, #e4bdb8);
      }

      .tone-election {
        background: linear-gradient(150deg, #fdf6f5, #ebd4d2 60%, #dec5c3);
      }

      .tone-linkedin {
        background: linear-gradient(145deg, #8e3d3a, #733130 62%, #5a2524);
      }

      .tone-repo {
        background: linear-gradient(145deg, #9f4b47, #843d39 62%, #6d302d);
      }

      .tone-streamlit {
        background: linear-gradient(145deg, #a75a49, #8f493c 62%, #773a31);
      }

      .tone-method {
        background: linear-gradient(145deg, #95514b, #7a413c 62%, #64342f);
      }

      .link-card-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 0.8rem;
        margin: 1rem 0 1.1rem;
      }

      .link-card-row.single {
        max-width: 300px;
      }

      .link-card {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 62px;
        border-radius: 0;
        border: 1px solid var(--card-line);
        box-shadow:
          0 12px 30px rgba(96, 58, 55, 0.2),
          0 1px 0 rgba(255, 255, 255, 0.18) inset;
        color: #fff8f7;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        transition: border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
      }

      .link-card:hover {
        border-color: rgba(120, 57, 53, 0.6);
        transform: translateY(-2px);
        box-shadow:
          0 20px 42px rgba(98, 56, 53, 0.24),
          0 1px 0 rgba(255, 255, 255, 0.24) inset;
      }

      @media (max-width: 820px) {
        .quick-grid {
          grid-template-columns: 1fr;
        }

        .quick-card,
        .tile-link {
          min-height: 210px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/">Wyatt Entrekin</a>
          <div class="links">
            <a href="/" class={isActive("/") ? "active" : ""}>Home</a>
            <div class={`projects-nav ${projectsActive ? "active" : ""}`} tabindex="0">
              <a href="/projects" class={`projects-trigger ${projectsActive ? "active" : ""}`}>Projects</a>
              <div class="projects-menu">
                {
                  projectLinks.map((link) => (
                    <a href={link.href} class={isActive(link.href) ? "active" : ""}>{link.label}</a>
                  ))
                }
              </div>
            </div>
            <a href="/about" class={isActive("/about") ? "active" : ""}>About</a>
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
  </body>
</html>
