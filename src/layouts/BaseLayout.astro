---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Data engineering and analytics projects by Wyatt Entrekin."
} = Astro.props;

const pathname = Astro.url.pathname;
const projectLinks = [
  { href: "/projects/cfb-rankings", label: "CFB Rankings" },
  { href: "/projects/2020-election-model", label: "2020 Election Model" }
];
const projectsActive = pathname === "/projects" || pathname.startsWith("/projects/");

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <style>
      :root {
        color-scheme: dark;
        --bg-deep: #070b14;
        --bg-top: #101a2b;
        --text: #edf3ff;
        --muted: #b8c4d7;
        --line: rgba(137, 172, 226, 0.28);
        --soft: rgba(23, 39, 66, 0.68);
        --glass: rgba(16, 27, 45, 0.54);
        --glass-strong: rgba(13, 24, 40, 0.72);
        --accent: #7cb7ff;
        --card-line: rgba(133, 168, 221, 0.22);
        --error-bg: #2a1418;
        --error-text: #f4a8b7;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        font-family: "Avenir Next", "Trebuchet MS", "Segoe UI", Tahoma, sans-serif;
        color: var(--text);
        background:
          radial-gradient(1200px 700px at 10% -15%, rgba(112, 178, 255, 0.2) 0%, transparent 64%),
          radial-gradient(900px 640px at 88% 2%, rgba(86, 139, 220, 0.17) 0%, transparent 62%),
          linear-gradient(180deg, #142238 0%, #0c1525 46%, var(--bg-deep) 100%);
        background-attachment: fixed;
      }

      header {
        border-bottom: 1px solid rgba(139, 175, 232, 0.22);
        background: linear-gradient(180deg, rgba(10, 17, 30, 0.72), rgba(10, 18, 31, 0.58));
        backdrop-filter: blur(12px) saturate(130%);
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 1.25rem;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .brand {
        font-weight: 800;
        text-decoration: none;
        color: var(--text);
        letter-spacing: 0.2px;
      }

      nav .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      nav .links a {
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        padding: 0.45rem 0.78rem;
        border-radius: 999px;
        border: 1px solid transparent;
        transition:
          background-color 150ms ease,
          border-color 150ms ease,
          box-shadow 150ms ease,
          color 150ms ease;
      }

      nav .links a:hover {
        background: rgba(38, 59, 92, 0.46);
        border-color: rgba(126, 170, 236, 0.36);
      }

      nav .links a.active {
        background: var(--soft);
        border-color: rgba(126, 170, 236, 0.4);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
      }

      nav .links .projects-nav {
        position: relative;
      }

      nav .links .projects-trigger {
        display: flex;
        align-items: center;
        gap: 0.38rem;
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        padding: 0.45rem 0.78rem;
        border-radius: 999px;
        border: 1px solid transparent;
        user-select: none;
        transition:
          background-color 150ms ease,
          border-color 150ms ease,
          box-shadow 150ms ease,
          color 150ms ease;
      }

      nav .links .projects-trigger::after {
        content: "▾";
        font-size: 0.75rem;
        opacity: 0.86;
        transform: translateY(1px);
      }

      nav .links .projects-nav.active .projects-trigger,
      nav .links .projects-nav:hover .projects-trigger,
      nav .links .projects-nav:focus-within .projects-trigger {
        background: var(--soft);
        border-color: rgba(126, 170, 236, 0.4);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
      }

      nav .links .projects-menu {
        position: absolute;
        top: 100%;
        right: 0;
        min-width: 220px;
        display: none;
        gap: 0.26rem;
        padding: 0.5rem;
        margin-top: 0.35rem;
        background: var(--glass-strong);
        border: 1px solid rgba(131, 168, 226, 0.4);
        box-shadow:
          0 20px 44px rgba(0, 0, 0, 0.42),
          0 1px 0 rgba(255, 255, 255, 0.08) inset;
        backdrop-filter: blur(12px) saturate(130%);
        border-radius: 12px;
        z-index: 35;
      }

      nav .links .projects-nav:hover .projects-menu,
      nav .links .projects-nav:focus-within .projects-menu {
        display: grid;
      }

      nav .links .projects-menu a {
        border-radius: 8px;
        padding: 0.54rem 0.64rem;
        white-space: nowrap;
      }

      nav .links .projects-menu a:hover {
        background: rgba(63, 100, 153, 0.42);
      }

      nav .links .projects-menu a.active {
        background: rgba(55, 93, 147, 0.5);
        border-color: rgba(129, 174, 241, 0.46);
      }

      nav .links .projects-nav:focus-within {
        outline: none;
      }

      nav .links .projects-nav:focus-within .projects-trigger {
        color: #f4f8ff;
      }

      main {
        padding-block: 2.4rem 3rem;
      }

      .hero {
        padding: 0.2rem 0 0.5rem;
      }

      .hero h1 {
        margin-top: 0;
        margin-bottom: 0.7rem;
      }

      .muted {
        color: var(--muted);
        line-height: 1.7;
      }

      .section-title {
        margin: 2rem 0 0.9rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.2rem;
      }

      .card {
        background: linear-gradient(160deg, rgba(17, 30, 52, 0.86), rgba(11, 22, 40, 0.92));
        border: 1px solid var(--card-line);
        border-radius: 0;
        padding: 1.2rem;
        box-shadow:
          0 20px 46px rgba(0, 0, 0, 0.34),
          0 1px 0 rgba(255, 255, 255, 0.05) inset;
      }

      .card h2,
      .card h3 {
        margin-top: 0;
        margin-bottom: 0.6rem;
      }

      .card ul,
      .card ol {
        margin: 0.7rem 0;
        padding-left: 1.45rem;
        list-style-position: outside;
      }

      .card li {
        margin-bottom: 0.45rem;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        text-align: left;
        padding: 0.72rem;
        border-bottom: 1px solid var(--line);
      }

      th {
        font-size: 0.92rem;
        color: #c8d2e2;
      }

      .error {
        background: var(--error-bg);
        color: var(--error-text);
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        margin: 0.75rem 0;
        font-weight: 600;
      }

      @media (max-width: 820px) {
        .grid {
          grid-template-columns: 1fr;
        }

        nav {
          align-items: flex-start;
          flex-direction: column;
        }

        nav .links .projects-menu {
          position: static;
          min-width: 0;
          margin-top: 0.36rem;
        }
      }
    </style>

    <style is:global>
      .quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.35rem;
        margin-top: 1.35rem;
      }

      .quick-card,
      .tile-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-decoration: none;
        color: var(--text);
        border: 1px solid var(--card-line);
        border-radius: 0;
        padding: 1.5rem;
        min-height: 260px;
        box-shadow:
          0 22px 50px rgba(0, 0, 0, 0.36),
          0 1px 0 rgba(255, 255, 255, 0.06) inset;
        transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
      }

      .quick-card:hover,
      .tile-link:hover {
        border-color: rgba(124, 182, 255, 0.72);
        transform: translateY(-3px);
        box-shadow:
          0 30px 65px rgba(0, 0, 0, 0.48),
          0 1px 0 rgba(255, 255, 255, 0.09) inset;
      }

      .quick-card h2,
      .tile-link h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.11em;
        line-height: 1.2;
      }

      .tile-link h3 {
        margin: 0.55rem 0 0;
        font-size: 1rem;
        font-weight: 560;
        line-height: 1.45;
        letter-spacing: 0.01em;
        text-transform: none;
        color: #d9e3f2;
        max-width: 34ch;
      }

      .tone-projects {
        background: linear-gradient(150deg, #0f3b7a, #1b5fc2 60%, #122f55);
      }

      .tone-about {
        background: linear-gradient(150deg, #114d56, #1d7f89 60%, #0f3a43);
      }

      .tone-cfb {
        background: linear-gradient(150deg, #0f3c5b, #17507b 62%, #12324a);
      }

      .tone-election {
        background: linear-gradient(150deg, #4a2231, #6a2d41 60%, #3d1d2b);
      }

      .tone-linkedin {
        background: linear-gradient(145deg, #0f4f86, #1469a8 62%, #113f67);
      }

      .tone-repo {
        background: linear-gradient(145deg, #293f67, #35578f 62%, #243a5b);
      }

      .tone-streamlit {
        background: linear-gradient(145deg, #1f506a, #2f789e 62%, #1b4259);
      }

      .link-card-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 0.8rem;
        margin: 1rem 0 1.1rem;
      }

      .link-card-row.single {
        max-width: 300px;
      }

      .link-card {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 62px;
        border-radius: 0;
        border: 1px solid var(--card-line);
        box-shadow:
          0 14px 32px rgba(0, 0, 0, 0.32),
          0 1px 0 rgba(255, 255, 255, 0.06) inset;
        color: var(--text);
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        transition: border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
      }

      .link-card:hover {
        border-color: rgba(124, 182, 255, 0.72);
        transform: translateY(-2px);
        box-shadow:
          0 22px 44px rgba(0, 0, 0, 0.42),
          0 1px 0 rgba(255, 255, 255, 0.08) inset;
      }

      @media (max-width: 820px) {
        .quick-grid {
          grid-template-columns: 1fr;
        }

        .quick-card,
        .tile-link {
          min-height: 210px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/">Wyatt Entrekin</a>
          <div class="links">
            <a href="/" class={isActive("/") ? "active" : ""}>Home</a>
            <div class={`projects-nav ${projectsActive ? "active" : ""}`} tabindex="0">
              <a href="/projects" class={`projects-trigger ${projectsActive ? "active" : ""}`}>Projects</a>
              <div class="projects-menu">
                {
                  projectLinks.map((link) => (
                    <a href={link.href} class={isActive(link.href) ? "active" : ""}>{link.label}</a>
                  ))
                }
              </div>
            </div>
            <a href="/about" class={isActive("/about") ? "active" : ""}>About</a>
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
  </body>
</html>
