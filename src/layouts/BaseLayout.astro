---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Data engineering and analytics projects by Wyatt Entrekin."
} = Astro.props;

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" }
];

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      :root {
        color-scheme: dark;
        --bg: #090b10;
        --bg-accent: #121623;
        --card: #0f131b;
        --text: #e7ecf3;
        --muted: #97a2b2;
        --line: #202737;
        --accent: #4f8dff;
        --accent-strong: #79abff;
        --soft: #151c2a;
        --error-bg: #2a1418;
        --error-text: #f4a8b7;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Avenir Next", "Trebuchet MS", "Segoe UI", Tahoma, sans-serif;
        background:
          radial-gradient(1100px 700px at 0% -10%, #1a2133 0%, transparent 45%),
          radial-gradient(900px 700px at 100% 0%, #111826 0%, transparent 40%),
          var(--bg);
        color: var(--text);
      }

      header {
        border-bottom: 1px solid var(--line);
        background: rgba(9, 11, 16, 0.85);
        backdrop-filter: blur(4px);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .container {
        max-width: 1040px;
        margin: 0 auto;
        padding: 1.25rem;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .brand {
        font-weight: 800;
        text-decoration: none;
        color: var(--text);
        letter-spacing: 0.2px;
      }

      nav .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      nav .links a {
        color: var(--text);
        text-decoration: none;
        font-weight: 650;
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
      }

      nav .links a.active {
        background: var(--soft);
        color: var(--accent-strong);
      }

      main {
        padding-block: 2rem 2.7rem;
      }

      .hero {
        background: linear-gradient(125deg, #0f131b, #111827);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow:
          0 14px 38px rgba(0, 0, 0, 0.32),
          0 1px 0 rgba(255, 255, 255, 0.04) inset;
      }

      .hero h1 {
        margin-top: 0;
        margin-bottom: 0.55rem;
      }

      .muted {
        color: var(--muted);
        line-height: 1.7;
      }

      .button-row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1.1rem;
      }

      .button {
        background: var(--accent);
        color: #0a1020;
        text-decoration: none;
        padding: 0.7rem 1rem;
        border-radius: 10px;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(34, 99, 255, 0.28);
      }

      .button.secondary {
        background: transparent;
        color: var(--accent-strong);
        border: 1px solid var(--line);
      }

      .section-title {
        margin: 2rem 0 0.9rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.2rem;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.2rem;
        box-shadow:
          0 16px 40px rgba(0, 0, 0, 0.28),
          0 1px 0 rgba(255, 255, 255, 0.03) inset;
      }

      .card h2,
      .card h3 {
        margin-top: 0;
        margin-bottom: 0.6rem;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        text-align: left;
        padding: 0.72rem;
        border-bottom: 1px solid var(--line);
      }

      th {
        font-size: 0.92rem;
        color: #c8d2e2;
      }

      .error {
        background: var(--error-bg);
        color: var(--error-text);
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 0.65rem 0.75rem;
        margin: 0.75rem 0;
        font-weight: 600;
      }

      .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        color: var(--accent-strong);
        font-weight: 700;
        margin-bottom: 0.35rem;
      }

      footer {
        margin-top: 2.7rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.9rem;
      }

      @media (max-width: 820px) {
        .grid {
          grid-template-columns: 1fr;
        }

        nav {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/">Wyatt Entrekin</a>
          <div class="links">
            {
              navLinks.map((link) => (
                <a href={link.href} class={isActive(link.href) ? "active" : ""}>{link.label}</a>
              ))
            }
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
      <footer>Static-first site on Cloudflare Pages. CFB is artifact-driven for reliability.</footer>
    </main>
  </body>
</html>
