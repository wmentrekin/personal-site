---
import BaseLayout from "../layouts/BaseLayout.astro";

const quickFacts = [
  {
    label: "Current Role",
    value: "Data Engineeering Consultant at CapTech"
  },
  {
    label: "Based In",
    value: "Atlanta, Georgia"
  },
  {
    label: "Education",
    value: "Georgia Tech, BS in Industrial & Systems Engineering"
  },
  {
    label: "Homewtown",
    value: "Memphis, Tennessee"
  },
];

const aboutCards = [
  {
    eyebrow: "Background",
    title: "Combinging academic background inIndustrial Engineering, professional experience in Data Engineering, and personal interests in analytics and systems.",
    paragraphs: [
      "I studied Industrial & Systems Engineering at Georgia Tech, where I became especially interested in optimization, modeling, analytics, and the kinds of technical problems that sit between math, systems, and decision-making.",
      "That background still shapes how I think. I tend to like approaching problems that are open-ended but require measurable and operationally useful solutions.",
      "Whether that means data pipelines, ranking models, or trying to explain a messy problem clearly, I enjoy working on things that require a combination of technical and analytical skills, creativity, and attention to real-world constraints."
    ]
  },
  {
    eyebrow: "Work",
    title: "My professional work is centered on reliable data systems and practical delivery.",
    paragraphs: [
      "At CapTech, I work in data and analytics consulting. A lot of that work has involved building and supporting data pipelines, improving testing and data quality processes, and contributing to larger migration and platform efforts.",
      "I care more about stable, understandable systems than cleverness for its own sake. That same preference carries into the project work on this site."
    ]
  },
  {
    eyebrow: "Interests",
    title: "Outside of work, most of my energy goes toward sports, fitness, travel, food, and learning.",
    paragraphs: [
      "I spend a lot of my free time lifting, running, following sports, traveling, and working on side projects. I am especially interested in college football, NBA basketball, history, languages, and anything that helps me understand how people and systems behave over time.",
      "That mix is part of why this site exists. The projects here sit at the intersection of technical curiosity and the things I naturally care enough about to keep thinking about after work."
    ]
  },
  {
    eyebrow: "Why This Site",
    title: "This site is meant to be a durable home for technical work, not a polished personal brand exercise.",
    paragraphs: [
      "The homepage is intentionally compact. The project pages are where the real work lives: methodology, artifacts, archived experiments, and the context behind what I am building.",
      "If someone lands here for the first time, the main thing I want them to understand is that I am a data engineer with strong analytical interests who likes building useful, technically grounded things."
    ]
  }
];
---

<BaseLayout title="About | Wyatt Entrekin">
  <section class="about-shell">
    <section class="about-hero reveal">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span>
        Home
      </a>
      <p class="hero-kicker">About</p>
      <p class="hero-text">
        This page is a high-level overview of my background, experience, and interests. For a more current view of what
        I&apos;m focused on right now, check out my <a href="/now">now page</a>.
      </p>
    </section>

    <section class="quick-grid reveal" aria-label="Quick facts">
      {quickFacts.map((fact) => (
        <article class="fact-card reveal">
          <p class="fact-label">{fact.label}</p>
          <p class="fact-value">{fact.value}</p>
        </article>
      ))}
    </section>

    <section class="about-grid">
      {aboutCards.map((card) => (
        <article class="about-card reveal">
          <p class="card-kicker">{card.eyebrow}</p>
          <h2>{card.title}</h2>
          {card.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </article>
      ))}
    </section>
  </section>

  <style>
    .about-shell {
      display: grid;
      gap: 1.5rem;
      max-width: 58rem;
      margin: 0 auto;
      padding-top: 0.8rem;
    }

    .about-hero {
      display: grid;
      gap: 0.75rem;
      padding-top: 0.3rem;
    }

    .hero-kicker,
    .fact-label,
    .card-kicker {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-text {
      margin: 0;
      max-width: 42rem;
      color: var(--text-soft);
      font-size: 1rem;
      line-height: 1.72;
    }

    .hero-text a {
      color: var(--text);
      text-underline-offset: 0.16em;
    }

    .quick-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .fact-card {
      padding: 1rem 1.05rem;
      display: grid;
      gap: 0.4rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .fact-value {
      margin: 0;
      color: var(--text-soft);
      font-weight: 600;
      line-height: 1.55;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .about-card {
      padding: 1.15rem 1.2rem;
      display: grid;
      align-content: start;
      gap: 0.75rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .about-card h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.45rem;
      line-height: 1.08;
      letter-spacing: -0.03em;
      text-wrap: pretty;
    }

    .about-card p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
    }

    .about-card p:first-of-type {
      color: var(--text-soft);
    }
    @media (max-width: 900px) {
      .quick-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
