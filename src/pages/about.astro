---
import BaseLayout from "../layouts/BaseLayout.astro";

const aboutSections = [
  {
    id: "background",
    title: "Background",
    image: "/images/about/memphis.png",
    alt: "Background placeholder image",
    text: [
      "I was born and raised in Memphis, Tennessee.",
      "I graduated from Christian Brothers High School in 2018 as a Co-Salutatorian."
    ],
    reverse: false
  },
  {
    id: "education",
    title: "Education",
    image: "/images/about/GT_logo.png",
    alt: "Georgia Tech logo",
    text: [
      "In the Fall of 2018, I enrolled at Georgia Tech to pursue a degree in Industrial & Systems Engineering. During my time at Tech, I developed a strong interest in data analytics, operation research, mathematical modeling, and machine learning.",
      "During school, I was lucky enough to have multiple jobs and internships in a variety of industries, including CapTech, Assurant, Code Ninjas, Printpack, and WeAdmit. I was also an active member of Delta Tau Delta Fraternity, serving as the chapter's Vice President.",
      "Before graduating in May 2023, I worked on a senior design project with Delta Airlines using process simulation to mitigate failures in the airline's baggage handling system at the Atlanta airport hub."
    ],
    reverse: true
  },
  {
    id: "career",
    title: "Career",
    image: "/images/about/captech.png",
    alt: "CapTech logo",
    text: [
      "After graduating from Georgia Tech, I briefly returned home to Memphis and began working as an Industrial Engineer at GreatNeck Tools, using analytics to profile and optimize inventory management operations and warehouse layout at the company's central distribution center.",
      "Then in January 2024, I joined CapTech as a Consultant in the Data & Analytics practice. In my time at CapTech, I have primarily worked for clients in the financial services industry, building and supporting data pipelines, automating data quality and testing processes, and supporting large-scale data migration efforts.",
      "Always pursuing technical and leadership growth, I also contribute internally on PoC projects, serve as a mentor for new hires, and lead Data & Analytics practice engagement at the Atlanta office. I'm currently focused on growing data engineering and data science skills, particularly in cloud data platforms, orchestration, machine learning, streaming data, and real-time analytics."
    ],
    reverse: false
  },
  {
    id: "interests",
    title: "Interests",
    image: "/images/about/interests-placeholder.svg",
    alt: "Interests placeholder image",
    text: [
      "In my free time, I enjoy staying active whether that means lifting in the gym, running, or playing sports with friends.",
      "I'm a lifelong sports fan, primarily college football and NBA basketball. My favorite teams are the Memphis Grizzlies and the Georgia Tech Yellow Jackets.",
      "I also enjoy traveling, culture, history, and languages. I've been learning and practicing Spanish for almost 4 years now and have gotten the chance to solo travel to several Spanish-speaking places to practice, including Mexico, Peru, Puerto Rico, and the Dominican Republic. The next country on my bucket list is Vietnam, where I hope to dive deeper into the cuisine.",
      "I also consider myself a bit of a foodie, but lately have explored that interest through cooking at home more than dining out. I enjoy shopping at the Buford Highway Farmers Market near Atlanta and trying new recipes, especially those with a Latin American and Southeast Asian influence. Last year, I took a cooking class in Oaxaca, Mexico and learned how to make traditional Oaxacan dishes like mole, tamales, and memelas, which was an incredible experience."
    ],
    reverse: true
  }
];
---

<BaseLayout title="About | Wyatt Entrekin">
  <section class="about-shell">
    <section class="about-intro">
      <div class="intro-main">
        <p class="intro-kicker">About</p>
        <h1>Wyatt Entrekin</h1>
        <p class="muted">
          Data engineer with an industrial engineering foundation, focused on building reliable analytics systems from
          ingest through modeled outputs and production delivery.
        </p>
        <div class="intro-actions">
          <a class="intro-btn primary" href="/projects">View Projects</a>
          <a class="intro-btn" href="https://www.linkedin.com/in/wmentrekin/" target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </div>

      <aside class="intro-panel">
        <h2>Snapshot</h2>
        <p><strong>Location:</strong> Atlanta, GA</p>
        <p><strong>Education:</strong> Georgia Tech, Industrial & Systems Engineering</p>
        <p><strong>Current Role:</strong> Consultant, Data & Analytics</p>
        <p><strong>Focus Areas:</strong> Data Engineering, Optimization, ML Systems</p>
      </aside>
    </section>

    <nav class="story-nav" aria-label="About sections">
      {
        aboutSections.map((section) => (
          <a href={`#${section.id}`}>{section.title}</a>
        ))
      }
    </nav>

    <section class="about-story">
      {
        aboutSections.map((section, index) => (
          <article class={`story-row ${section.reverse ? "reverse" : ""}`} id={section.id}>
            <figure class="story-media">
              <img src={section.image} alt={section.alt} loading="lazy" />
            </figure>
            <div class="story-copy">
              <p class="story-index">{String(index + 1).padStart(2, "0")}</p>
              <h2>{section.title}</h2>
              {
                section.text.map((paragraph) => (
                  <p class="muted">{paragraph}</p>
                ))
              }
            </div>
          </article>
        ))
      }
    </section>
  </section>

  <style>
    .about-shell {
      display: grid;
      gap: 1.1rem;
    }

    .about-intro {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 1rem;
      align-items: stretch;
    }

    .intro-main,
    .intro-panel {
      background: linear-gradient(160deg, rgba(255, 251, 248, 0.92), rgba(251, 240, 236, 0.9));
      border: 1px solid rgba(176, 132, 127, 0.3);
      border-radius: 14px;
      box-shadow:
        0 14px 32px rgba(82, 48, 45, 0.11),
        0 1px 0 rgba(255, 255, 255, 0.84) inset;
      padding: 1.1rem;
    }

    .intro-kicker {
      margin: 0;
      color: var(--accent);
      letter-spacing: 0.07em;
      text-transform: uppercase;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .intro-main h1 {
      margin: 0.45rem 0 0.68rem;
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      line-height: 1.15;
      letter-spacing: -0.01em;
    }

    .intro-main p {
      margin: 0;
      line-height: 1.75;
      max-width: 58ch;
    }

    .intro-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 1rem;
    }

    .intro-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0.5rem 0.85rem;
      border-radius: 10px;
      border: 1px solid rgba(160, 101, 97, 0.42);
      text-decoration: none;
      font-weight: 700;
      color: var(--text);
      background: rgba(245, 224, 219, 0.66);
      transition: transform 140ms ease, box-shadow 140ms ease;
    }

    .intro-btn.primary {
      background: linear-gradient(145deg, #9f4b47, #7e3633);
      color: #fff7f5;
      border-color: rgba(125, 55, 52, 0.5);
    }

    .intro-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(92, 54, 52, 0.17);
    }

    .intro-panel h2 {
      margin: 0;
      font-size: 1.08rem;
    }

    .intro-panel p {
      margin: 0.72rem 0 0;
      color: var(--muted);
      line-height: 1.65;
      padding-top: 0.72rem;
      border-top: 1px solid rgba(176, 132, 127, 0.24);
    }

    .story-nav {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.62rem;
    }

    .story-nav a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      text-decoration: none;
      color: #5f4644;
      background: rgba(244, 224, 218, 0.6);
      border: 1px solid rgba(166, 115, 110, 0.35);
      border-radius: 10px;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      transition: transform 130ms ease, border-color 130ms ease, box-shadow 130ms ease;
    }

    .story-nav a:hover {
      transform: translateY(-1px);
      border-color: rgba(142, 61, 58, 0.48);
      box-shadow: 0 8px 18px rgba(92, 54, 52, 0.14);
    }

    .about-story {
      display: grid;
      gap: 1rem;
    }

    .story-row {
      display: grid;
      grid-template-columns: minmax(240px, 330px) minmax(0, 1fr);
      gap: 1rem;
      align-items: stretch;
    }

    .story-row.reverse {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 330px);
    }

    .story-row.reverse .story-media {
      order: 2;
    }

    .story-row.reverse .story-copy {
      order: 1;
    }

    .story-media {
      margin: 0;
      border: 1px solid rgba(176, 132, 127, 0.32);
      box-shadow:
        0 14px 28px rgba(82, 48, 45, 0.13),
        0 1px 0 rgba(255, 255, 255, 0.78) inset;
      border-radius: 14px;
      background: #f7ece8;
      overflow: hidden;
      min-height: 220px;
      display: grid;
      place-items: center;
    }

    .story-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }

    .story-copy {
      border: 1px solid rgba(176, 132, 127, 0.26);
      background: linear-gradient(160deg, rgba(255, 251, 248, 0.92), rgba(250, 239, 235, 0.88));
      box-shadow:
        0 14px 30px rgba(82, 48, 45, 0.11),
        0 1px 0 rgba(255, 255, 255, 0.82) inset;
      border-radius: 14px;
      padding: 1rem 1.1rem;
    }

    .story-index {
      margin: 0;
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 750;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .story-copy h2 {
      margin: 0.36rem 0 0.64rem;
      font-size: 1.35rem;
      line-height: 1.24;
    }

    .story-copy p {
      margin: 0 0 0.9rem;
      line-height: 1.8;
    }

    .story-copy p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 960px) {
      .about-intro,
      .story-nav {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 920px) {
      .story-row,
      .story-row.reverse {
        grid-template-columns: 1fr;
      }

      .story-row.reverse .story-media,
      .story-row.reverse .story-copy {
        order: initial;
      }

      .story-media {
        min-height: 200px;
      }
    }
  </style>
</BaseLayout>
