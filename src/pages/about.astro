---
import BaseLayout from "../layouts/BaseLayout.astro";

const aboutSections = [
  {
    id: "background",
    title: "Background",
    image: "/images/about/background-placeholder.svg",
    alt: "Background placeholder image",
    text: "I was born and raised in Memphis, Tennessee, ",
    reverse: false
  },
  {
    id: "education",
    title: "Education at Georgia Tech",
    image: "/images/about/GT_logo.svg.png",
    alt: "Georgia Tech logo",
    text: "In the Fall of 2018, I enrolled at Georgia Tech to pursue a degree in Industrial & Systems Engineering. During my time at Tech, I developed a strong interest in data analytics, operation research, mathematical modeling, and machine learning. During my time in school, I was lucky enough to a mutliple jobs and internships in a variety of industries, including ones at CapTech, Assurant, Code Ninjas, Printpack, and WeAdmit. I was also an active member of Delta Tau Delta Fraternity, serving as the chapter's Vice President. Before graduating in May 2023, I worked on a senior design project with Delta Airlines using process simulation to mitigate failures in the airline's baggage handling system at the Atlanta airport hub.",
    reverse: true
  },
  {
    id: "career",
    title: "Career",
    image: "/images/about/career-placeholder.svg",
    alt: "Career placeholder image",
    text: "After graduating from Georgia Tech, I briefly returned home to Memphis and began working as an Industrial Engineer at GreatNeck Tools, using analytics to profile and optimize the inventory management operations and warehouse layout at the company's central distribution center. Then in January 2024, I joined Captech as a Consultant in the Data & Analytics practice. In my time at CapTech, I have primarily worked for clients in the financial services industry, building and supporting data pipelines, automating data quality and testing processes, and supporting large scale data migration efforts. Always pursuing technical and leadership growth, I also contribute internally on PoC projects, serve as a mentor for new hires, and lead Data & Analytics practice engagement at the Atlanta office. I'm currently focused on growing and learning new skills in the data engineering and data science spaces, particularly in the areas of cloud data platforms, orchestration, machine learning, streaming data, and real-time analytics.",
    reverse: false
  },
  {
    id: "interests",
    title: "Interests",
    image: "/images/about/interests-placeholder.svg",
    alt: "Interests placeholder image",
    text: "Add 2-5 sentences about interests outside work and how they connect to your projects.",
    reverse: true
  }
];
---

<BaseLayout title="About | Wyatt Entrekin">
  <section class="hero">
    <h1>Wyatt Entrekin</h1>

    <div class="link-card-row single">
      <a class="link-card tone-linkedin" href="https://www.linkedin.com/in/wmentrekin/" target="_blank" rel="noreferrer">
        LinkedIn
      </a>
    </div>
  </section>

  <section class="about-sections">
    {
      aboutSections.map((section) => (
        <article class={`about-row ${section.reverse ? "reverse" : ""}`} id={section.id}>
          <figure class="about-photo">
            <img src={section.image} alt={section.alt} loading="lazy" />
          </figure>
          <div class="about-copy">
            <h2>{section.title}</h2>
            <p class="muted">{section.text}</p>
          </div>
        </article>
      ))
    }
  </section>

  <style>
    .about-sections {
      display: grid;
      gap: 1.35rem;
      margin-top: 1.25rem;
    }

    .about-row {
      display: grid;
      grid-template-columns: minmax(230px, 340px) minmax(0, 1fr);
      gap: 1.25rem;
      align-items: stretch;
    }

    .about-row.reverse {
      grid-template-columns: minmax(0, 1fr) minmax(230px, 340px);
    }

    .about-row.reverse .about-photo {
      order: 2;
    }

    .about-row.reverse .about-copy {
      order: 1;
    }

    .about-photo {
      margin: 0;
      border: 1px solid rgba(133, 168, 221, 0.3);
      box-shadow:
        0 14px 34px rgba(0, 0, 0, 0.28),
        0 1px 0 rgba(255, 255, 255, 0.05) inset;
      overflow: hidden;
      min-height: 220px;
    }

    .about-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .about-copy {
      border: 1px solid rgba(133, 168, 221, 0.22);
      background: linear-gradient(160deg, rgba(14, 25, 44, 0.82), rgba(9, 18, 33, 0.9));
      padding: 1rem 1.15rem;
    }

    .about-copy h2 {
      margin-top: 0;
      margin-bottom: 0.7rem;
      font-size: 1.35rem;
    }

    .about-copy p {
      min-height: 7rem;
      margin: 0;
    }

    @media (max-width: 920px) {
      .about-row,
      .about-row.reverse {
        grid-template-columns: 1fr;
      }

      .about-row.reverse .about-photo,
      .about-row.reverse .about-copy {
        order: initial;
      }

      .about-photo {
        min-height: 200px;
      }
    }
  </style>
</BaseLayout>
