  }
];

// -- Timeline math --------------------------------------------------------
// Cards are uniform, fixed-size slots stacked in reverse-chronological
// order -- position no longer maps to real dates (the per-card date range
// is the source of truth for timing), so every entry gets the same visual
// weight regardless of how long the stint actually was.
const MONTH_INDEX: Record<string, number> = {
  Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
  Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11
};

const parseMonth = (label: string): number => {
  const [mon, yearStr] = label.split(" ");
  return Number(yearStr) * 12 + MONTH_INDEX[mon];
};

const formatDuration = (months: number): string => {
  const years = Math.floor(months / 12);
  const rest = months % 12;
  const parts: string[] = [];
  if (years) parts.push(`${years} yr${years > 1 ? "s" : ""}`);
  if (rest) parts.push(`${rest} mo${rest > 1 ? "s" : ""}`);
  return parts.length ? parts.join(" ") : "< 1 mo";
};

const today = new Date();
const todayMonths = today.getFullYear() * 12 + today.getMonth();

const effectiveEndMonths = (entry: TimelineEntry): number => {
  const startMonths = parseMonth(entry.start);
  if (entry.end === "Present") return todayMonths;
  if (entry.end === "Expected") return startMonths;
  return parseMonth(entry.end);
};

const rangeLabel = (entry: TimelineEntry): string => {
  if (entry.end === "Expected") {
    return `${entry.start} · Expected`;
  }
  const startMonths = parseMonth(entry.start);
  return `${entry.start} – ${entry.end} · ${formatDuration(effectiveEndMonths(entry) - startMonths)}`;
};

const SLOT_HEIGHT = 160;
const SLOT_GAP = 34;

type Positioned = TimelineEntry & {
  top: number;
  height: number;
  range: string;
  mergeTop: boolean;
  mergeBottom: boolean;
};

const layoutColumn = (entries: TimelineEntry[]): Positioned[] => {
  const sorted = [...entries].sort((a, b) => parseMonth(b.start) - parseMonth(a.start));

  const positioned: Positioned[] = sorted.map((entry, index) => ({
    ...entry,
    top: index * (SLOT_HEIGHT + SLOT_GAP),
    height: SLOT_HEIGHT,
    range: rangeLabel(entry),
    mergeTop: false,
    mergeBottom: false
  }));

  // Consecutive same-org entries where one starts exactly when the other
  // ends (e.g. a promotion) get a node-and-line connector rendered in the
  // gap between them (see mergeConnectors below) instead of two separate
  // job entries reading as unrelated.
  for (let i = 0; i < positioned.length - 1; i++) {
    const upper = positioned[i];
    const lower = positioned[i + 1];
    if (upper.org === lower.org && parseMonth(upper.start) === effectiveEndMonths(lower)) {
      upper.mergeBottom = true;
      lower.mergeTop = true;
    }
  }

  return positioned;
};

const workColumn = layoutColumn(timeline.filter((entry) => entry.kind === "work"));
const eduColumn = layoutColumn(timeline.filter((entry) => entry.kind === "education"));

type Connector = { top: number; height: number };

// Renders a node-and-line connector spanning exactly the SLOT_GAP between a
// mergeBottom card and the mergeTop card directly below it.
const mergeConnectors = (col: Positioned[]): Connector[] => {
  const connectors: Connector[] = [];
  for (let i = 0; i < col.length - 1; i++) {
    const upper = col[i];
    const lower = col[i + 1];
    if (upper.mergeBottom && lower.mergeTop) {
      connectors.push({
        top: upper.top + upper.height,
        height: lower.top - (upper.top + upper.height)
      });
    }
  }
  return connectors;
};

const workConnectors = mergeConnectors(workColumn);
const eduConnectors = mergeConnectors(eduColumn);

const columnBottom = (col: Positioned[]) =>
  col.length ? Math.max(...col.map((entry) => entry.top + entry.height)) : 0;

const chartHeight = Math.max(columnBottom(workColumn), columnBottom(eduColumn));

const mobileEntries = [...timeline]
  .sort((a, b) => parseMonth(b.start) - parseMonth(a.start))
  .map((entry) => ({
    ...entry,
    range: rangeLabel(entry)
  }));
---

<BaseLayout title="Resume | Wyatt Entrekin">
  <section class="resume-shell">
    <section class="resume-hero reveal">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span>
        Home
      </a>
      <p class="hero-kicker">Resume</p>
      <h1>Career Timeline</h1>
      <p class="hero-text">
        A chronological walk through my work and education history, most recent first, in place of a static PDF.
        Pulled from my <a href="https://www.linkedin.com/in/wmentrekin/" target="_blank" rel="noreferrer">LinkedIn</a>
        and filled in by hand.
      </p>
    </section>

    <div class="gantt-wrap reveal">
      <div class="gantt-header">
        <p class="col-label">Work</p>
        <p class="col-label">Education</p>
      </div>

      <div class="gantt" style={`height: ${chartHeight}px`}>
        <div class="gantt-axis-line"></div>

        <div class="gantt-col">
          {workConnectors.map((connector) => (
            <div class="merge-connector" style={`top: ${connector.top}px; height: ${connector.height}px`}></div>
          ))}
          {workColumn.map((entry) => (
            <article class:list={["gantt-card", entry.status]} style={`top: ${entry.top}px; height: ${entry.height}px`}>
              <div class="card-head">
                {entry.logo && (
                  <span class="card-logo-chip">
                    <img src={entry.logo} alt={`${entry.org} logo`} loading="lazy" />
                  </span>
                )}
                <div class="card-head-text">
                  <p class="card-range">
                    {entry.range}
                    {entry.status === "current" && <span class="card-badge">Current</span>}
                  </p>
                  <h2>{entry.title}</h2>
                </div>
              </div>
              <p class="card-org">
                {entry.org} <span class="card-dot">&middot;</span> {entry.location}
              </p>
              {entry.description && <p class="card-desc">{entry.description}</p>}
            </article>
          ))}
        </div>

        <div class="gantt-col">
          {eduConnectors.map((connector) => (
            <div class="merge-connector" style={`top: ${connector.top}px; height: ${connector.height}px`}></div>
          ))}
          {eduColumn.map((entry) => (
            <article class:list={["gantt-card", entry.status]} style={`top: ${entry.top}px; height: ${entry.height}px`}>
              <div class="card-head">
                {entry.logo && (
                  <span class="card-logo-chip">
                    <img src={entry.logo} alt={`${entry.org} logo`} loading="lazy" />
                  </span>
                )}
                <div class="card-head-text">
                  <p class="card-range">
                    {entry.range}
                    {entry.status === "upcoming" && <span class="card-badge">Upcoming</span>}
                  </p>
                  <h2>{entry.title}</h2>
                </div>
              </div>
              <p class="card-org">
                {entry.org} <span class="card-dot">&middot;</span> {entry.location}
              </p>
              {entry.description && <p class="card-desc">{entry.description}</p>}
            </article>
          ))}
        </div>
      </div>
    </div>

    <ol class="timeline-mobile reveal">
      {mobileEntries.map((entry) => (
        <li class:list={["mobile-item", entry.status]}>
          <div class="mobile-marker"><span class="mobile-dot"></span></div>
          <article class="mobile-content">
            <div class="card-head">
              {entry.logo && (
                <span class="card-logo-chip">
                  <img src={entry.logo} alt={`${entry.org} logo`} loading="lazy" />
                </span>
              )}
              <div class="card-head-text">
                <p class="card-range">
                  {entry.range}
                  <span class="card-badge kind-badge">{entry.kind === "work" ? "Work" : "Education"}</span>
                  {entry.status === "current" && <span class="card-badge">Current</span>}
                  {entry.status === "upcoming" && <span class="card-badge">Upcoming</span>}
                </p>
                <h2>{entry.title}</h2>
              </div>
            </div>
            <p class="card-org">
              {entry.org} <span class="card-dot">&middot;</span> {entry.location}
            </p>
            {entry.description && <p class="card-desc">{entry.description}</p>}
          </article>
        </li>
      ))}
    </ol>
  </section>

  <style>
    .resume-shell {
      display: grid;
      gap: 1.75rem;
      max-width: 58rem;
      margin: 0 auto;
      padding-top: 0.8rem;
      padding-bottom: 3.5rem;
    }

    .resume-hero {
      display: grid;
      gap: 0.6rem;
      padding-top: 0.3rem;
    }

    .hero-kicker {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .resume-hero h1 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(1.9rem, 4vw, 2.6rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .hero-text {
      margin: 0;
      max-width: 42rem;
      color: var(--text-soft);
      font-size: 1rem;
      line-height: 1.72;
    }

    .hero-text a {
      color: var(--text);
      text-underline-offset: 0.16em;
    }

    /* Desktop: two-column, uniform-slot vertical spine layout. */
    .gantt-wrap {
      display: block;
    }

    .gantt-header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
      margin-bottom: 0.6rem;
    }

    .col-label {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .gantt {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
    }

    .gantt-axis-line {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      background: var(--line-strong);
    }

    .gantt-col {
      position: relative;
    }

    /* CapTech promotion connector: a node-and-line pair living entirely
       inside the SLOT_GAP between the two cards it links. */
    .merge-connector {
      position: absolute;
      left: 50%;
      width: 2px;
      background: var(--accent);
      opacity: 0.7;
    }

    .merge-connector::before,
    .merge-connector::after {
      content: "";
      position: absolute;
      left: 50%;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background: var(--accent);
      transform: translate(-50%, -50%);
    }

    .merge-connector::before {
      top: 0;
    }

    .merge-connector::after {
      top: 100%;
    }

    .gantt-card {
      position: absolute;
      left: 0;
      right: 0;
      box-sizing: border-box;
      display: grid;
      align-content: start;
      gap: 0.3rem;
      padding: 0.9rem 1.05rem;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
      transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .gantt-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
      z-index: 2;
    }

    .gantt-card.current {
      border-color: rgba(125, 211, 252, 0.4);
    }

    .gantt-card.upcoming {
      border-style: dashed;
      border-color: rgba(125, 211, 252, 0.35);
    }

    /* Org/school logo chip: a light-neutral background so all 8 source
       images (mixed transparent/white/brand-color backgrounds) read
       consistently, sized to keep the CBHS/Georgia Tech horizontal
       icon+wordmark lockups legible. Lives beside the range/title text in
       a flex header row rather than as its own grid row, so it adds
       negligible height to the fixed-slot .gantt-card. */
    .card-head {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .card-logo-chip {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.35rem;
      height: 2.35rem;
      padding: 0.3rem;
      border-radius: 0.55rem;
      background: #f5f5f0;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    .card-logo-chip img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .card-head-text {
      display: grid;
      gap: 0.3rem;
      min-width: 0;
    }

    .card-range {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .card-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.06rem 0.5rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-soft);
      font-size: 0.64rem;
      font-weight: 600;
      letter-spacing: 0.06em;
    }

    .gantt-card h2,
    .mobile-content h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.08rem;
      line-height: 1.18;
      letter-spacing: -0.02em;
      text-wrap: pretty;
    }

    .card-org {
      margin: 0;
      color: var(--text-soft);
      font-size: 0.87rem;
      line-height: 1.5;
    }

    .card-dot {
      color: var(--muted);
    }

    .card-desc {
      margin: 0.1rem 0 0;
      color: var(--muted);
      font-size: 0.87rem;
      line-height: 1.6;
    }

    /* Mobile: single reverse-chronological list, hidden on desktop. */
    .timeline-mobile {
      display: none;
    }

    @media (max-width: 820px) {
      .gantt-wrap {
        display: none;
      }

      .timeline-mobile {
        display: grid;
        gap: 1.1rem;
        margin: 0;
        padding: 0 0 0 1.4rem;
        list-style: none;
        position: relative;
      }

      .timeline-mobile::before {
        content: "";
        position: absolute;
        top: 0.4rem;
        bottom: 0.4rem;
        left: 0.3rem;
        width: 1px;
        background: var(--line-strong);
      }

      .mobile-item {
        position: relative;
      }

      .mobile-marker {
        position: absolute;
        top: 0.35rem;
        left: -1.4rem;
        width: 1.4rem;
        display: flex;
        justify-content: center;
      }

      .mobile-dot {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 999px;
        background: var(--muted);
        box-shadow: 0 0 0 4px var(--bg-1);
      }

      .mobile-item.current .mobile-dot {
        background: var(--accent);
        box-shadow: 0 0 0 4px var(--bg-1), 0 0 0 6px rgba(125, 211, 252, 0.25);
      }

      .mobile-item.upcoming .mobile-dot {
        background: transparent;
        border: 1px dashed var(--accent);
      }

      .mobile-content {
        width: 100%;
        padding: 0.9rem 1.05rem;
        display: grid;
        gap: 0.3rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
          linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
        box-shadow: var(--shadow-card);
      }
    }

    @media (max-width: 480px) {
      .resume-shell {
        gap: 1.4rem;
      }

      .mobile-content {
        padding: 0.8rem 0.9rem;
      }
    }
  </style>
</BaseLayout>
