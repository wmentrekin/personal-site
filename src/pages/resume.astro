---
import BaseLayout from "../layouts/BaseLayout.astro";

type TimelineEntry = {
  start: string;
  end: string;
  title: string;
  org: string;
  location: string;
  kind: "education" | "work";
  description?: string;
  status?: "current" | "upcoming";
};

const timeline: TimelineEntry[] = [
  {
    start: "Aug 2014",
    end: "May 2018",
    title: "High School Diploma",
    org: "Christian Brothers High School",
    location: "Memphis, TN",
    kind: "education"
  },
  {
    start: "Aug 2018",
    end: "May 2023",
    title: "B.S., Industrial & Systems Engineering",
    org: "Georgia Institute of Technology",
    location: "Atlanta, GA",
    kind: "education",
    description: "Foundation in optimization, statistics, simulation, and systems thinking."
  },
  {
    start: "May 2019",
    end: "Jan 2020",
    title: "Lead Counselor",
    org: "WeAdmit Technologies, Inc.",
    location: "San Francisco Bay Area",
    kind: "work"
  },
  {
    start: "Jan 2020",
    end: "Mar 2020",
    title: "Industrial Engineer",
    org: "Printpack",
    location: "Atlanta Metropolitan Area",
    kind: "work"
  },
  {
    start: "May 2020",
    end: "Aug 2020",
    title: "Programming Instructor",
    org: "Code Ninjas",
    location: "Memphis Metropolitan Area",
    kind: "work"
  },
  {
    start: "May 2021",
    end: "Aug 2021",
    title: "Data Analyst",
    org: "Assurant",
    location: "Atlanta Metropolitan Area",
    kind: "work"
  },
  {
    start: "May 2022",
    end: "Aug 2022",
    title: "Data Analyst",
    org: "CapTech Consulting",
    location: "Washington DC-Baltimore Area",
    kind: "work"
  },
  {
    start: "Jul 2023",
    end: "Dec 2023",
