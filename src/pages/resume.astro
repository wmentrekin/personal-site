---
import BaseLayout from "../layouts/BaseLayout.astro";

type TimelineEntry = {
  start: string;
  end: string;
  title: string;
  org: string;
  location: string;
  kind: "education" | "work";
  description?: string;
  status?: "current" | "upcoming";
  logo?: string;
};

const timeline: TimelineEntry[] = [
  {
