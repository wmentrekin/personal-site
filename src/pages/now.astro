---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "March 15, 2026";

// Add a new entry here whenever you want to log a fresh update.
const entries = [
  {
    date: "March 15, 2026",
    title: "",
    summary:
      "Focusing on fitness, lifitng and running regularly. Working on cool personal projects.",
    items: [
    ]
  }
];
---

<BaseLayout
  title="Now | Wyatt Entrekin"
>
  <section class="now-shell">
    <section class="now-hero reveal">
      <p class="hero-kicker">Now</p>
      <p class="hero-text">
        This is a snapshot of what I&apos;m currently focused on rather than a full archive. The format comes from the
        <a href="https://nownownow.com/about" target="_blank" rel="noreferrer">now page idea</a>.
      </p>
      <p class="hero-meta">Last updated {lastUpdated}</p>
    </section>

    <section class="entry-list">
      {entries.map((entry) => (
        <article class="entry-card reveal">
          <p class="entry-date">{entry.date}</p>
          <h2>{entry.title}</h2>
          <p class="entry-summary">{entry.summary}</p>
          <ul>
            {entry.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  </section>

  <style>
    .now-shell {
      display: grid;
      gap: 1.5rem;
      max-width: 56rem;
      margin: 0 auto;
      padding-top: 0.8rem;
    }

    .now-hero {
      display: grid;
      gap: 0.75rem;
      padding: 0.3rem 0 0.1rem;
    }

    .hero-kicker {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .now-hero h1 {
      margin: 0;
      max-width: 12ch;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 0.98;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .hero-text,
    .hero-meta {
      margin: 0;
    }

    .hero-text {
      max-width: 40rem;
      color: var(--muted);
      line-height: 1.7;
    }

    .hero-text a {
      color: var(--text);
      text-underline-offset: 0.16em;
    }

    .hero-meta {
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .guide-card span,
    .entry-date {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .guide-card p {
      margin: 0.5rem 0 0;
    }

    .entry-list {
      display: grid;
      gap: 1rem;
    }

    .entry-card {
      padding: 1.3rem 1.35rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .entry-card h2 {
      margin: 0.35rem 0 0;
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 2vw, 1.7rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .entry-summary {
      margin: 0.8rem 0 0;
      color: var(--text-soft);
      line-height: 1.7;
    }

    .entry-card ul {
      margin: 0.9rem 0 0;
      padding-left: 1.15rem;
      color: var(--muted);
      line-height: 1.7;
    }

    .entry-card li + li {
      margin-top: 0.4rem;
    }

    @media (max-width: 820px) {
      .now-shell {
        gap: 1.15rem;
      }
    }
  </style>
</BaseLayout>
