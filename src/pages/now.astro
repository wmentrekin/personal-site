---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { NowEntry } from "../data/now/types";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric"
});

const entryModules = import.meta.glob("../data/now/entries/*.ts", {
  eager: true
}) as Record<string, { default: NowEntry }>;

const entries = Object.values(entryModules)
  .map(({ default: entry }) => ({
    ...entry,
    formattedDate: dateFormatter.format(new Date(`${entry.date}T00:00:00`))
  }))
  .sort((a, b) => b.date.localeCompare(a.date));

const lastUpdated = entries[0]?.formattedDate ?? "";
---

<BaseLayout
  title="Now | Wyatt Entrekin"
>
  <section class="now-shell">
    <section class="now-hero reveal">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span>
        Home
      </a>
      <p class="hero-kicker">Now</p>
      <p class="hero-text">
        This is a now page. It is meant to be a snapshot of what I&apos;m currently focused on. The idea comes from
        <a href="https://nownownow.com/about" target="_blank" rel="noreferrer">the now page movement</a>.
      </p>
      <p class="hero-text">
        The now page is a more up-to-date view of what I&apos;m working on. For more on my background and broader
        experience, visit my <a href="/about">about page</a>.
      </p>
      <p class="hero-meta">Last updated {lastUpdated}</p>
    </section>

    <section class="entry-list">
      {entries.map((entry) => (
        <article class="entry-card reveal">
          <p class="entry-date">{entry.formattedDate}</p>
          {entry.title && <h2>{entry.title}</h2>}
          <p class="entry-summary">{entry.intro}</p>
          <div class="entry-sections">
            {entry.sections.map((section) => (
              <p class="entry-section">
                <strong>{section.label}:</strong> {section.text}
              </p>
            ))}
          </div>
        </article>
      ))}
    </section>
  </section>

  <style>
    .now-shell {
      display: grid;
      gap: 1.5rem;
      max-width: 56rem;
      margin: 0 auto;
      padding-top: 0.8rem;
    }

    .now-hero {
      display: grid;
      gap: 0.75rem;
      padding: 0.3rem 0 0.1rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      width: fit-content;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.76rem;
      letter-spacing: 0.06em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .back-link:hover {
      color: var(--text);
    }

    .hero-kicker {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .now-hero h1 {
      margin: 0;
      max-width: 12ch;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 0.98;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .hero-text,
    .hero-meta {
      margin: 0;
    }

    .hero-text {
      max-width: 40rem;
      color: var(--muted);
      line-height: 1.7;
    }

    .hero-text a {
      color: var(--text);
      text-underline-offset: 0.16em;
    }

    .hero-meta {
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .guide-card span,
    .entry-date {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .guide-card p {
      margin: 0.5rem 0 0;
    }

    .entry-list {
      display: grid;
      gap: 1rem;
    }

    .entry-card {
      padding: 1.3rem 1.35rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .entry-card h2 {
      margin: 0.35rem 0 0;
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 2vw, 1.7rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .entry-summary {
      margin: 0.8rem 0 0;
      color: var(--text-soft);
      line-height: 1.7;
    }

    .entry-sections {
      display: grid;
      gap: 0.8rem;
      margin-top: 0.9rem;
    }

    .entry-section {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
    }

    .entry-section strong {
      color: var(--text);
    }

    @media (max-width: 820px) {
      .now-shell {
        gap: 1.15rem;
      }
    }
  </style>
</BaseLayout>
