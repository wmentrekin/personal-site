---
import { readFileSync } from "node:fs";

import RankingsTable from "../../components/RankingsTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface SeasonEntry {
  season: number;
  weeks: number[];
}

interface RankingsIndex {
  generated_at_utc: string;
  latest_season: number;
  latest_week: number;
  seasons: SeasonEntry[];
}

interface RankingRow {
  rank: number;
  team: string;
  conference: string;
  record: string;
  rating: number;
  delta: number;
  logo: string | null;
}

interface WeekPayload {
  season: number;
  week: number;
  generated_at_utc: string;
  rankings: RankingRow[];
}

function padWeek(week: number): string {
  return String(week).padStart(2, "0");
}

function formatDelta(delta: number): string {
  return delta > 0 ? `+${delta}` : `${delta}`;
}

function readJsonSafe<T>(url: URL): T | null {
  try {
    return JSON.parse(readFileSync(url, "utf-8")) as T;
  } catch {
    return null;
  }
}

// public/data/cfb/ is populated at build time by scripts/fetch-rankings-data.mjs, which
// requires R2 credentials to actually write anything. If those aren't configured yet (e.g. a
// fresh checkout, a PR preview build before secrets are set up), this directory won't exist --
// render an empty state instead of crashing the whole build.
const indexPath = new URL("../../../public/data/cfb/index.json", import.meta.url);
const rankingsIndex = readJsonSafe<RankingsIndex>(indexPath);

const seasonsForClient = rankingsIndex
  ? [...rankingsIndex.seasons]
      .sort((a, b) => b.season - a.season)
      .map((entry) => ({
        season: entry.season,
        weeks: [...entry.weeks].sort((a, b) => b - a)
      }))
  : [];

const latestSeason = rankingsIndex?.latest_season ?? null;
const latestWeek = rankingsIndex?.latest_week ?? null;

const weeksForLatestSeason =
  seasonsForClient.find((entry) => entry.season === latestSeason)?.weeks ?? [];

const weekPayload =
  latestSeason !== null && latestWeek !== null
    ? readJsonSafe<WeekPayload>(
        new URL(
          `../../../public/data/cfb/${latestSeason}/week-${padWeek(latestWeek)}.json`,
          import.meta.url
        )
      )
    : null;

const rows =
  weekPayload?.rankings.map((team) => [
    team.rank,
    { logo: team.logo ?? null, name: team.team },
    team.conference,
    team.record,
    Number(team.rating).toFixed(2),
    formatDelta(Number(team.delta))
  ]) ?? [];

const hasRankingsData = rankingsIndex !== null && weekPayload !== null;
---

<BaseLayout title="CFB Rankings Project | Wyatt Entrekin">
  <section class="project-shell">
    <a class="back-link reveal" href="/projects"><span aria-hidden="true">←</span> Projects</a>

    <section class="project-hero reveal glass-card">
      <div class="hero-copy">
        <p class="hero-kicker">Active Project</p>
        <h1>Entrekin Quadratic Index</h1>
        <h1>College Football Rankings</h1>
        <p class="hero-text">Optimization-based college football ratings based solely on objective metrics like record and game outcomes</p>
        <div class="hero-tags">
          <span>Optimization</span>
          <span>Sports Analytics</span>
          <span>Python</span>
          <span>Data Pipelines</span>
          <span>Automation</span>
        </div>
      </div>
      <div class="hero-actions">
        <a class="method-link-card" href="/projects/cfb-rankings/methodology">Methodology</a>
        <a
          class="icon-link"
          href="https://github.com/wmentrekin/cfb-rankings"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub Repository"
          title="GitHub Repository"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
              fill="currentColor"
            ></path>
          </svg>
        </a>
      </div>
    </section>

    <section class="rankings-panel reveal glass-card">
      {hasRankingsData ? (
        <>
          <div class="panel-head">
            <h2>FBS College Football Rankings</h2>
            <div class="panel-filters">
              <select class="filter-select" id="season-select" aria-label="Season">
                {
                  seasonsForClient.map((entry) => (
                    <option value={entry.season} selected={entry.season === latestSeason}>
                      {entry.season}
                    </option>
                  ))
                }
              </select>
              <select class="filter-select" id="week-select" aria-label="Week">
                {
                  weeksForLatestSeason.map((week) => (
                    <option value={week} selected={week === latestWeek}>
                      Week {week}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>
          <RankingsTable headers={["Rank", "Team", "Conference", "Record", "Rating", "Delta"]} rows={rows} />
        </>
      ) : (
        <div class="panel-empty">
          <h2>Rankings</h2>
          <p>Rankings data isn't available for this build yet. Check back after the next scheduled update.</p>
        </div>
      )}
    </section>
  </section>

  <style>
    .project-shell {
      display: grid;
      gap: 1rem;
      padding-top: 0.8rem;
      padding-bottom: 2.5rem;
    }

    .project-hero {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.05rem 1.15rem;
    }

    .hero-kicker {
      margin: 0;
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-copy h1 {
      margin: 0.35rem 0 0.45rem;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.2rem);
      line-height: 0.96;
      letter-spacing: -0.05em;
    }

    .hero-text {
      margin: 0;
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.65;
      max-width: 34rem;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.8rem;
    }

    .hero-tags span {
      display: inline-flex;
      align-items: center;
      min-height: 1.75rem;
      padding: 0.1rem 0.58rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-soft);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      flex-shrink: 0;
    }

    .method-link-card {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0.5rem 0.9rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .method-link-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
      border-color: rgba(255, 255, 255, 0.24);
      color: var(--text);
    }

    .icon-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.85rem;
      height: 1.85rem;
      padding: 0;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text);
      text-decoration: none;
      flex-shrink: 0;
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .icon-link:hover {
      color: var(--text);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
    }

    .icon-link svg {
      width: 0.95rem;
      height: 0.95rem;
      flex: 0 0 auto;
    }

    .rankings-panel {
      padding: 1.05rem;
    }

    .panel-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-bottom: 0.9rem;
    }

    .panel-head h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.55rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .panel-empty h2 {
      margin: 0 0 0.5rem;
      font-family: var(--font-display);
      font-size: 1.55rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .panel-empty p {
      margin: 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .panel-filters {
      display: flex;
      gap: 0.55rem;
    }

    .filter-select {
      appearance: none;
      padding: 0.45rem 1.9rem 0.45rem 0.75rem;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.03)
        url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="%2396a9bc"><path d="M5.5 7.5l4.5 4.5 4.5-4.5"/></svg>')
        no-repeat right 0.6rem center;
      background-size: 0.8rem;
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }

    .filter-select:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    .table-footnote {
      margin: 0.7rem 0 0;
      color: var(--muted);
      font-size: 0.78rem;
      font-family: var(--font-mono);
    }

    @media (max-width: 920px) {
      .project-hero {
        flex-direction: column;
      }

      .hero-actions {
        width: 100%;
      }

      .method-link-card {
        flex: 1;
        justify-content: center;
      }
    }

    @media (max-width: 640px) {
      .panel-head {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 480px) {
      .project-hero {
        padding: 1rem;
      }

      .rankings-panel {
        padding: 1rem;
      }

      .icon-link {
        width: 2.75rem;
        height: 2.75rem;
      }
    }
  </style>

  <script is:inline define:vars={{ seasonsForClient, latestSeason }}>
    // This site uses Astro's ClientRouter (View Transitions) for same-document navigation.
    // A bare top-level inline script only runs on the initial hard page load, not on
    // subsequent client-side transitions into this page -- so wire everything up inside
    // astro:page-load (fires on first load AND every transition into this page), matching
    // BaseLayout.astro's reveal-on-scroll script and the Home page's widget init pattern.
    function initRankingsSelector() {
      const seasonSelect = document.getElementById("season-select");
      const weekSelect = document.getElementById("week-select");
      const tableBody = document.querySelector(".rankings-panel .rankings-shell tbody");

      if (!seasonSelect || !weekSelect) return;

      // Guards against out-of-order renders if the user changes the selects faster than a
      // fetch resolves -- only the most recently started request is allowed to render.
      let loadGeneration = 0;

      function padWeek(week) {
        return String(week).padStart(2, "0");
      }

      function formatDelta(delta) {
        const value = Number(delta);
        return value > 0 ? `+${value}` : `${value}`;
      }

      function weeksForSeason(season) {
        const entry = seasonsForClient.find((item) => item.season === Number(season));
        return entry ? entry.weeks : [];
      }

      function populateWeekOptions(season) {
        const weeks = weeksForSeason(season);
        weekSelect.textContent = "";
        for (const week of weeks) {
          const option = document.createElement("option");
          option.value = String(week);
          option.textContent = `Week ${week}`;
          weekSelect.appendChild(option);
        }
      }

      // Uses DOM APIs (textContent/createElement + property assignment) rather than innerHTML
      // with interpolated strings, so team/conference/record values from the fetched JSON can
      // never be interpreted as markup.
      function renderRows(rankings) {
        if (!tableBody) return;
        tableBody.textContent = "";
        for (const team of rankings) {
          const cells = [
            team.rank,
            { logo: team.logo ?? null, name: team.team },
            team.conference,
            team.record,
            Number(team.rating).toFixed(2),
            formatDelta(team.delta)
          ];
          const row = document.createElement("tr");
          cells.forEach((cell, index) => {
            const td = document.createElement("td");
            if (index === 0) td.className = "rank-col";
            if (cell !== null && typeof cell === "object") {
              if (cell.logo) {
                const span = document.createElement("span");
                span.className = "team-cell";
                const img = document.createElement("img");
                img.className = "team-logo";
                img.src = cell.logo;
                img.alt = "";
                img.loading = "lazy";
                img.decoding = "async";
                span.appendChild(img);
                span.appendChild(document.createTextNode(cell.name));
                td.appendChild(span);
              } else {
                td.textContent = cell.name;
              }
            } else {
              td.textContent = cell;
            }
            row.appendChild(td);
          });
          tableBody.appendChild(row);
        }
      }

      function renderLoadError(message) {
        if (!tableBody) return;
        tableBody.textContent = "";
        const row = document.createElement("tr");
        const cell = document.createElement("td");
        cell.colSpan = 6;
        cell.textContent = message;
        row.appendChild(cell);
        tableBody.appendChild(row);
      }

      async function loadWeek(season, week) {
        const generation = ++loadGeneration;
        try {
          const response = await fetch(`/data/cfb/${season}/week-${padWeek(week)}.json`);
          if (generation !== loadGeneration) return;
          if (!response.ok) {
            renderLoadError("Couldn't load rankings for this selection. Please try again.");
            return;
          }
          const data = await response.json();
          if (generation !== loadGeneration) return;
          renderRows(data.rankings ?? []);
        } catch {
          if (generation !== loadGeneration) return;
          renderLoadError("Couldn't load rankings for this selection. Please try again.");
        }
      }

      seasonSelect.addEventListener("change", () => {
        const season = seasonSelect.value;
        populateWeekOptions(season);
        const firstWeekOption = weekSelect.options[0];
        if (firstWeekOption) {
          weekSelect.value = firstWeekOption.value;
          loadWeek(season, firstWeekOption.value);
        }
      });

      weekSelect.addEventListener("change", () => {
        loadWeek(seasonSelect.value ?? latestSeason, weekSelect.value);
      });
    }

    document.addEventListener("astro:page-load", initRankingsSelector);
  </script>
</BaseLayout>
