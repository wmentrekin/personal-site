---
import { readFileSync } from "node:fs";

import RankingsTable from "../../components/RankingsTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const rankingsPath = new URL("../../../public/data/cfb/latest-rankings.json", import.meta.url);
const rankingsPayload = JSON.parse(readFileSync(rankingsPath, "utf-8"));
const rows = rankingsPayload.rankings.map((team: Record<string, string | number>) => [
  team.rank,
  team.team,
  team.record,
  Number(team.rating).toFixed(2),
  Number(team.delta) > 0 ? `+${team.delta}` : `${team.delta}`
]);
---

<BaseLayout title="CFB Rankings Project | Wyatt Entrekin">
  <section class="project-shell">
    <a class="back-link reveal" href="/projects"><span aria-hidden="true">←</span> Projects</a>

    <section class="project-hero reveal glass-card">
      <div class="hero-copy">
        <p class="hero-kicker">Active Project</p>
        <h1>CFB Rankings</h1>
        <p class="hero-text">Optimization-based college football ratings published as a static artifact.</p>
        <div class="hero-tags">
          <span>Optimization</span>
          <span>Sports Analytics</span>
          <span>Python</span>
          <span>Static Delivery</span>
        </div>
      </div>
      <aside class="hero-aside">
        <div class="glass-card">
          <span>Snapshot</span>
          <strong>Season {rankingsPayload.season}, Week {rankingsPayload.week}</strong>
        </div>
        <div class="glass-card">
          <span>Updated</span>
          <strong>{rankingsPayload.generated_at_utc}</strong>
        </div>
      </aside>
    </section>

    <div class="link-card-row compact-links">
      <a class="link-card tone-method" href="/projects/cfb-rankings/methodology">Methodology</a>
      <a class="link-card tone-repo" href="https://github.com/wmentrekin/cfb-rankings" target="_blank" rel="noreferrer">
        GitHub Repository
      </a>
      <a class="link-card tone-streamlit" href="https://cfb-rankings-wmentrekin.streamlit.app/" target="_blank" rel="noreferrer">
        Original Streamlit App
      </a>
    </div>

    <section class="rankings-panel reveal glass-card">
      <div class="panel-head">
        <div>
          <p class="section-label">Current Rankings</p>
          <h2>Latest Ratings Snapshot</h2>
        </div>
        <p class="panel-meta">{rankingsPayload.generated_at_utc}</p>
      </div>
      <RankingsTable headers={["Rank", "Team", "Record", "Rating", "Delta"]} rows={rows} />
    </section>

    <section class="info-grid">
      <article class="info-card reveal glass-card">
        <h2>Project Notes</h2>
        <p class="muted">
          Rankings are produced weekly during the season. The current direction is to keep the public surface simple
          and move the model, architecture, and implementation details into the methodology page.
        </p>
        <a class="method-link" href="/projects/cfb-rankings/methodology">Open methodology</a>
      </article>

      <article class="info-card reveal glass-card">
        <h2>Next Up</h2>
        <ul>
          <li>Migrate rankings storage from Supabase to artifact storage</li>
          <li>Add outcome probability and simulation layers</li>
          <li>Extend the model into conference and postseason views</li>
        </ul>
      </article>
    </section>
  </section>

  <style>
    .project-shell {
      display: grid;
      gap: 1rem;
      padding-top: 0.8rem;
    }

    .project-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.7fr);
      gap: 1rem;
      padding: 1.05rem 1.15rem;
    }

    .hero-kicker,
    .section-label,
    .hero-aside span {
      margin: 0;
      color: var(--accent-football);
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-copy h1 {
      margin: 0.35rem 0 0.45rem;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.2rem);
      line-height: 0.96;
      letter-spacing: -0.05em;
    }

    .hero-text {
      margin: 0;
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.65;
      max-width: 34rem;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.8rem;
    }

    .hero-tags span {
      display: inline-flex;
      align-items: center;
      min-height: 1.75rem;
      padding: 0.1rem 0.58rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-soft);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hero-aside {
      display: grid;
      gap: 0.7rem;
      align-content: start;
    }

    .hero-aside div {
      padding: 0.75rem 0.85rem;
      border-radius: var(--radius-md);
    }

    .hero-aside strong {
      display: block;
      margin-top: 0.55rem;
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      line-height: 1.55;
    }

    .compact-links {
      margin: 0;
    }

    .rankings-panel {
      padding: 1.05rem;
    }

    .panel-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 0.8rem;
      margin-bottom: 0.8rem;
    }

    .panel-head h2 {
      margin: 0.4rem 0 0;
      font-family: var(--font-display);
      font-size: 1.55rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .panel-meta {
      margin: 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .info-card {
      padding: 1.05rem;
    }

    .info-card h2 {
      margin: 0 0 0.55rem;
      font-family: var(--font-display);
      font-size: 1.28rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .info-card ul {
      margin: 0;
      padding-left: 1.1rem;
      color: var(--muted);
      line-height: 1.7;
    }

    .info-card li + li {
      margin-top: 0.3rem;
    }

    .method-link {
      display: inline-flex;
      margin-top: 0.75rem;
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      position: relative;
    }

    .method-link::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -0.12rem;
      width: 100%;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 180ms ease;
    }

    .method-link:hover::after {
      transform: scaleX(1);
    }

    @media (max-width: 920px) {
      .project-hero,
      .info-grid {
        grid-template-columns: 1fr;
      }

      .panel-head {
        align-items: start;
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
