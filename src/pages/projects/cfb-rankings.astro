---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="CFB Rankings Project | Wyatt Entrekin">
  <section class="project-shell">
    <section class="project-hero">
      <div class="hero-copy">
        <p class="hero-kicker">Active Project</p>
        <h1>CFB Rankings</h1>
        <p class="hero-text">
          a convex quadratic program to optimally rank college football teams based on game outcomes
        </p>
        <div class="hero-tags">
          <span>Optimization</span>
          <span>Mathematical Programming</span>
          <span>Sports Analytics</span>
          <span>Python</span>
          <span>Supabase</span>
          <span>GitHub Actions</span>
        </div>
      </div>
      <aside class="hero-aside">
        <h2>Release Cadence</h2>
        <p>Weekly rankings updated every Sunday morning at 3:15 AM ET during the college football season</p>
        <p>Offseason enhancements are underway!</p>
      </aside>
    </section>

    <div class="link-card-row link-row-soft">
      <a class="link-card tone-repo" href="https://github.com/wmentrekin/cfb-rankings" target="_blank" rel="noreferrer">
        GitHub Repository
      </a>
      <a class="link-card tone-repo" href="https://cfb-rankings-wmentrekin.streamlit.app/" target="_blank" rel="noreferrer">
        Original Streamlit App
      </a>
      <a class="link-card tone-repo" href="/projects/cfb-rankings/methodology">
        Methodology
      </a>
    </div>

    <section class="info-grid">
      <article class="info-card">
        <h2>Current Architecture</h2>
        <ul>
          <li>CollegeFootballData API ingest for teams and games</li>
          <li>Supabase for relational storage of teams, games, and rankings</li>
          <li>Convex optimization model run for weekly team ratings</li>
        </ul>
      </article>

      <article class="info-card">
        <h2>Model Summary</h2>
        <ul>
          <li>Team ratings bounded between 0 and 100</li>
          <li>Soft margin penalty scaled by home/away/neutral and adjusted game margin</li>
          <li>Loss-rate penalty to dampen high ratings for poor records</li>
          <li>Early-season prior regularization that decays by week</li>
          <li>Extra penalty for losses to FCS teams</li>
        </ul>
      </article>
    </section>

    <section class="info-card snapshot-card">
      <div class="snapshot-head">
        <h2>Latest Ratings Snapshot [PLACEHOLDER UNTIL RANKINGS ARTIFACT MIGRATION]</h2>
        <p id="meta" class="snapshot-meta">Loading rankings artifact...</p>
      </div>
      <p id="error" class="error" hidden></p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>Team</th>
              <th>Record</th>
              <th>Rating</th>
              <th>Delta</th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
    </section>

    <section class="info-grid">
      <article class="info-card">
        <h2>EnhancementRoadmap</h2>
        <ul>
          <li>Migrate rankings storage from Supabase table to R2 artifact storage</li>
          <li>Implement ML-based outcome probability estimation</li>
          <li>Modify QP for conference rankings</li>
          <li>Add Playoff & Bowl Projection using a composite of QP rankings, ML probabilities, and CP assignment</li>
        </ul>
      </article>

      <article class="info-card snapshot-card">
        <h2>Methodology details</h2>
        <p class="muted">
          full mathematical writeup of objective terms, parameters, constraints, and implementation notes are documented on the methodology
          page
        </p>
        <a class="method-link" href="/projects/cfb-rankings/methodology">Read Methodology</a>
      </article>
    </section>
  </section>

  <script>
    function setError(message: string) {
      const meta = document.getElementById("meta");
      const error = document.getElementById("error");

      if (meta instanceof HTMLParagraphElement) {
        meta.textContent = "Rankings unavailable";
      }

      if (error instanceof HTMLParagraphElement) {
        error.hidden = false;
        error.textContent = message;
      }
    }

    function addCell(row: HTMLTableRowElement, value: string, className?: string) {
      const cell = document.createElement("td");
      cell.textContent = value;
      if (className) {
        cell.className = className;
      }
      row.appendChild(cell);
    }

    function formatDelta(value: number) {
      if (!Number.isFinite(value)) return "0";
      if (value > 0) return `+${value}`;
      return `${value}`;
    }

    async function loadRankings() {
      const meta = document.getElementById("meta");
      const rows = document.getElementById("rows");
      const error = document.getElementById("error");

      if (
        !(meta instanceof HTMLParagraphElement) ||
        !(rows instanceof HTMLTableSectionElement) ||
        !(error instanceof HTMLParagraphElement)
      ) {
        return;
      }

      error.hidden = true;
      error.textContent = "";

      let response;
      try {
        response = await fetch("/data/cfb/latest-rankings.json", { cache: "no-store" });
      } catch (_err) {
        setError("Network error while loading rankings artifact.");
        return;
      }

      if (!response.ok) {
        setError(`Could not load rankings artifact (HTTP ${response.status}).`);
        return;
      }

      let payload;
      try {
        payload = await response.json();
      } catch (_err) {
        setError("Artifact parsing failed. JSON payload is invalid.");
        return;
      }

      if (
        !payload ||
        typeof payload !== "object" ||
        !Array.isArray(payload.rankings) ||
        typeof payload.season !== "number" ||
        typeof payload.week !== "number" ||
        typeof payload.generated_at_utc !== "string"
      ) {
        setError("Artifact format is invalid. Expected a rankings array.");
        return;
      }

      if (payload.rankings.length === 0) {
        setError("No rankings are available for this snapshot yet.");
        return;
      }

      meta.textContent = `Season ${payload.season}, Week ${payload.week}. Updated ${payload.generated_at_utc}.`;
      rows.innerHTML = "";

      for (const row of payload.rankings) {
        const tableRow = document.createElement("tr");
        const rating = Number(row.rating);
        const delta = Number(row.delta);

        addCell(tableRow, String(row.rank ?? ""), "rank-cell");
        addCell(tableRow, String(row.team ?? ""), "team-cell");
        addCell(tableRow, String(row.record ?? ""), "");
        addCell(tableRow, Number.isFinite(rating) ? rating.toFixed(2) : "", "rating-cell");
        addCell(
          tableRow,
          formatDelta(delta),
          delta > 0 ? "delta-pos" : delta < 0 ? "delta-neg" : "delta-flat"
        );

        rows.appendChild(tableRow);
      }
    }

    loadRankings();
  </script>

  <style>
    .project-shell {
      display: grid;
      gap: 1rem;
    }

    .link-row-soft .link-card {
      border-radius: 12px;
      text-transform: none;
      letter-spacing: 0.02em;
      font-size: 0.92rem;
      min-height: 56px;
    }

    .project-hero {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 1rem;
    }

    .hero-copy,
    .hero-aside,
    .info-card {
      background: linear-gradient(160deg, rgba(255, 251, 248, 0.92), rgba(250, 239, 235, 0.88));
      border: 1px solid rgba(176, 132, 127, 0.3);
      border-radius: 14px;
      padding: 1.05rem;
      box-shadow:
        0 14px 30px rgba(82, 48, 45, 0.12),
        0 1px 0 rgba(255, 255, 255, 0.85) inset;
    }

    .hero-kicker {
      margin: 0;
      color: var(--accent);
      letter-spacing: 0.07em;
      text-transform: uppercase;
      font-size: 0.74rem;
      font-weight: 750;
    }

    .hero-copy h1 {
      margin: 0.45rem 0 0.55rem;
      font-size: clamp(1.8rem, 2.9vw, 2.4rem);
      line-height: 1.14;
    }

    .hero-text {
      margin: 0;
      color: var(--muted);
      line-height: 1.72;
      max-width: 62ch;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.48rem;
      margin-top: 0.9rem;
    }

    .hero-tags span {
      display: inline-flex;
      align-items: center;
      min-height: 30px;
      border-radius: 999px;
      padding: 0.25rem 0.62rem;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #5d3f3d;
      background: rgba(241, 216, 215, 0.86);
      border: 1px solid rgba(164, 110, 105, 0.34);
    }

    .hero-aside h2 {
      margin: 0;
      font-size: 1.05rem;
    }

    .hero-aside p {
      margin: 0.72rem 0 0;
      color: var(--muted);
      line-height: 1.68;
      padding-top: 0.72rem;
      border-top: 1px solid rgba(176, 132, 127, 0.26);
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .info-card h2 {
      margin: 0 0 0.6rem;
      font-size: 1.22rem;
    }

    .info-card p {
      margin: 0;
    }

    .info-card ul {
      margin: 0;
      padding-left: 1.25rem;
      color: var(--muted);
      line-height: 1.7;
    }

    .info-card li + li {
      margin-top: 0.35rem;
    }

    .snapshot-card {
      padding: 1rem 1.05rem 1.1rem;
    }

    .snapshot-head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.6rem;
      margin-bottom: 0.6rem;
      align-items: baseline;
    }

    .snapshot-head h2 {
      margin: 0;
    }

    .snapshot-meta {
      margin: 0;
      color: var(--muted);
      font-size: 0.92rem;
      font-weight: 600;
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    table {
      min-width: 560px;
    }

    th {
      color: #6a4f4d;
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    td {
      color: #3a2a2a;
      font-weight: 560;
    }

    .rank-cell {
      width: 60px;
      font-weight: 760;
      color: #5e3c3a;
    }

    .team-cell {
      font-weight: 700;
    }

    .rating-cell {
      font-variant-numeric: tabular-nums;
      font-weight: 700;
    }

    .delta-pos,
    .delta-neg,
    .delta-flat {
      font-weight: 700;
    }

    .delta-pos {
      color: #7e3834;
    }

    .delta-neg {
      color: #6a5a57;
    }

    .delta-flat {
      color: #6f5552;
    }

    .method-link {
      display: inline-flex;
      align-items: center;
      margin-top: 0.78rem;
      color: var(--accent);
      text-decoration: none;
      font-weight: 700;
    }

    .method-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 940px) {
      .project-hero,
      .info-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
