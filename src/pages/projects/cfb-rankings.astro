---
import { readFileSync } from "node:fs";

import RankingsTable from "../../components/RankingsTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface SeasonEntry {
  season: number;
  weeks: number[];
}

interface RankingsIndex {
  generated_at_utc: string;
  latest_season: number;
  latest_week: number;
  seasons: SeasonEntry[];
}

interface RankingRow {
  rank: number;
  team: string;
  conference: string;
  record: string;
  rating: number;
  delta: number;
}

interface WeekPayload {
  season: number;
  week: number;
  generated_at_utc: string;
  rankings: RankingRow[];
}

function padWeek(week: number): string {
  return String(week).padStart(2, "0");
}

function formatDelta(delta: number): string {
  return delta > 0 ? `+${delta}` : `${delta}`;
}

const indexPath = new URL("../../../public/data/cfb/index.json", import.meta.url);
const rankingsIndex: RankingsIndex = JSON.parse(readFileSync(indexPath, "utf-8"));

const { latest_season: latestSeason, latest_week: latestWeek, seasons } = rankingsIndex;

const seasonsForClient = [...seasons]
  .sort((a, b) => b.season - a.season)
  .map((entry) => ({
    season: entry.season,
    weeks: [...entry.weeks].sort((a, b) => b - a)
  }));

const weeksForLatestSeason =
  seasonsForClient.find((entry) => entry.season === latestSeason)?.weeks ?? [];

const weekPath = new URL(
  `../../../public/data/cfb/${latestSeason}/week-${padWeek(latestWeek)}.json`,
  import.meta.url
);
const weekPayload: WeekPayload = JSON.parse(readFileSync(weekPath, "utf-8"));

const rows = weekPayload.rankings.map((team) => [
  team.rank,
  team.team,
  team.conference,
  team.record,
  Number(team.rating).toFixed(2),
  formatDelta(Number(team.delta))
]);
---

<BaseLayout title="CFB Rankings Project | Wyatt Entrekin">
  <section class="project-shell">
    <a class="back-link reveal" href="/projects"><span aria-hidden="true">←</span> Projects</a>

    <section class="project-hero reveal glass-card">
      <div class="hero-copy">
        <p class="hero-kicker">Active Project</p>
        <h1>CFB Rankings</h1>
        <p class="hero-text">Optimization-based college football ratings published as a static artifact.</p>
        <div class="hero-tags">
          <span>Optimization</span>
          <span>Sports Analytics</span>
          <span>Python</span>
          <span>Static Delivery</span>
        </div>
      </div>
      <div class="hero-actions">
        <a class="method-link-card" href="/projects/cfb-rankings/methodology">Methodology</a>
        <a
          class="icon-link"
          href="https://github.com/wmentrekin/cfb-rankings"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub Repository"
          title="GitHub Repository"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
              fill="currentColor"
            ></path>
          </svg>
        </a>
      </div>
    </section>

    <section class="rankings-panel reveal glass-card">
      <div class="panel-head">
        <h2>Rankings</h2>
        <div class="panel-filters">
          <select class="filter-select" id="season-select" aria-label="Season">
            {
              seasonsForClient.map((entry) => (
                <option value={entry.season} selected={entry.season === latestSeason}>
                  {entry.season}
                </option>
              ))
            }
          </select>
          <select class="filter-select" id="week-select" aria-label="Week">
            {
              weeksForLatestSeason.map((week) => (
                <option value={week} selected={week === latestWeek}>
                  Week {week}
                </option>
              ))
            }
          </select>
        </div>
      </div>
      <RankingsTable headers={["Rank", "Team", "Conference", "Record", "Rating", "Delta"]} rows={rows} />
    </section>
  </section>

  <style>
    .project-shell {
      display: grid;
      gap: 1rem;
      padding-top: 0.8rem;
    }

    .project-hero {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.05rem 1.15rem;
    }

    .hero-kicker {
      margin: 0;
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-copy h1 {
      margin: 0.35rem 0 0.45rem;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.2rem);
      line-height: 0.96;
      letter-spacing: -0.05em;
    }

    .hero-text {
      margin: 0;
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.65;
      max-width: 34rem;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.8rem;
    }

    .hero-tags span {
      display: inline-flex;
      align-items: center;
      min-height: 1.75rem;
      padding: 0.1rem 0.58rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-soft);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      flex-shrink: 0;
    }

    .method-link-card {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0.5rem 0.9rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .method-link-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
      border-color: rgba(255, 255, 255, 0.24);
      color: var(--text);
    }

    .icon-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.85rem;
      height: 1.85rem;
      padding: 0;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text);
      text-decoration: none;
      flex-shrink: 0;
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .icon-link:hover {
      color: var(--text);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
    }

    .icon-link svg {
      width: 0.95rem;
      height: 0.95rem;
      flex: 0 0 auto;
    }

    .rankings-panel {
      padding: 1.05rem;
    }

    .panel-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-bottom: 0.9rem;
    }

    .panel-head h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.55rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .panel-filters {
      display: flex;
      gap: 0.55rem;
    }

    .filter-select {
      appearance: none;
      padding: 0.45rem 1.9rem 0.45rem 0.75rem;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.03)
        url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="%2396a9bc"><path d="M5.5 7.5l4.5 4.5 4.5-4.5"/></svg>')
        no-repeat right 0.6rem center;
      background-size: 0.8rem;
      color: var(--text-soft);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }

    .filter-select:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    @media (max-width: 920px) {
      .project-hero {
        flex-direction: column;
      }
    }

    @media (max-width: 640px) {
      .panel-head {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script define:vars={{ seasonsForClient, latestSeason }}>
    const seasonSelect = document.getElementById("season-select");
    const weekSelect = document.getElementById("week-select");
    const tableBody = document.querySelector(".rankings-panel .rankings-shell tbody");

    function padWeek(week) {
      return String(week).padStart(2, "0");
    }

    function formatDelta(delta) {
      const value = Number(delta);
      return value > 0 ? `+${value}` : `${value}`;
    }

    function weeksForSeason(season) {
      const entry = seasonsForClient.find((item) => item.season === Number(season));
      return entry ? entry.weeks : [];
    }

    function populateWeekOptions(season) {
      const weeks = weeksForSeason(season);
      weekSelect.innerHTML = weeks
        .map((week) => `<option value="${week}">Week ${week}</option>`)
        .join("");
    }

    function renderRows(rankings) {
      if (!tableBody) return;
      tableBody.innerHTML = rankings
        .map((team) => {
          const cells = [
            team.rank,
            team.team,
            team.conference,
            team.record,
            Number(team.rating).toFixed(2),
            formatDelta(team.delta)
          ];
          return `<tr>${cells
            .map((cell, index) => `<td class="${index === 0 ? "rank-col" : ""}">${cell}</td>`)
            .join("")}</tr>`;
        })
        .join("");
    }

    async function loadWeek(season, week) {
      const response = await fetch(`/data/cfb/${season}/week-${padWeek(week)}.json`);
      if (!response.ok) return;
      const data = await response.json();
      renderRows(data.rankings ?? []);
    }

    seasonSelect?.addEventListener("change", () => {
      const season = seasonSelect.value;
      populateWeekOptions(season);
      const firstWeekOption = weekSelect?.options[0];
      if (firstWeekOption) {
        weekSelect.value = firstWeekOption.value;
        loadWeek(season, firstWeekOption.value);
      }
    });

    weekSelect?.addEventListener("change", () => {
      loadWeek(seasonSelect?.value ?? latestSeason, weekSelect.value);
    });
  </script>
</BaseLayout>
