---
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects | Wyatt Entrekin">
  <section class="projects-shell">
    <a class="back-link reveal" href="/"><span aria-hidden="true">←</span> Home</a>

    <div class="projects-frame">
      <div class="frame-tile">
        <ProjectCard
          href="/projects/cfb-rankings"
          title="CFB Rankings"
          eyebrow="Active Project"
          status="Active"
          surface="glass"
          tone="football"
          summary="A convex quadratic optimization model for ranking college football teams, supported by automated ingestion, storage, publishing, and methodology documentation."
          tags={["Optimization", "Sports Analytics", "Python", "Supabase", "GitHub Actions"]}
        >
          <a
            slot="actions"
            class="card-link icon-link"
            href="https://github.com/wmentrekin/cfb-rankings"
            target="_blank"
            rel="noreferrer"
            aria-label="CFB Rankings repository"
            title="Repository"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
        </ProjectCard>
        <a class="tile-overlay" href="/projects/cfb-rankings" aria-label="Open CFB Rankings project"></a>
      </div>

      <div class="frame-tile">
        <ProjectCard
          href="/projects/2020-election-model"
          title="2020 Election Model"
          eyebrow="Archived Project"
          status="Archived"
          surface="glass"
          tone="archive"
          summary="A state-by-state election forecasting project preserved with its original narrative, map output, and full result tables in an archive-oriented presentation."
          tags={["Python", "Forecasting", "Statistics", "Election Modeling"]}
        >
          <a
            slot="actions"
            class="card-link icon-link"
            href="https://github.com/wmentrekin/2020election"
            target="_blank"
            rel="noreferrer"
            aria-label="2020 Election Model repository"
            title="Repository"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
        </ProjectCard>
        <a class="tile-overlay" href="/projects/2020-election-model" aria-label="Open 2020 Election Model project"></a>
      </div>

      <div class="frame-tile">
        <ProjectCard
          href="https://github.com/wmentrekin/cbb-rankings"
          title="College Basketball Rankings"
          eyebrow="In Progress"
          status="In Progress"
          surface="glass"
          tone="basketball"
          summary="An in-progress adaptation of the college football optimization framework for college basketball."
          tags={["Basketball", "Optimization", "Sports Analytics", "Python"]}
        >
          <a
            class="card-link icon-link"
            slot="actions"
            href="https://github.com/wmentrekin/cbb-rankings"
            target="_blank"
            rel="noreferrer"
            aria-label="College Basketball Rankings repository"
            title="Repository"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
        </ProjectCard>
      </div>

      <div class="frame-tile">
        <ProjectCard
          href="https://github.com/wmentrekin/nba-asset-lineage"
          title="Memphis Grizzlies Asset Lineage"
          eyebrow="In Progress"
          status="In Progress"
          surface="glass"
          tone="basketball"
          summary="A Grizzlies project tracing roster and draft-pick asset movement through timelines and network-style views."
          tags={["NBA", "Data Visualization", "Basketball", "Analytics"]}
        >
          <a
            class="card-link icon-link"
            slot="actions"
            href="https://github.com/wmentrekin/nba-asset-lineage"
            target="_blank"
            rel="noreferrer"
            aria-label="Memphis Grizzlies Asset Lineage repository"
            title="Repository"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
        </ProjectCard>
      </div>
    </div>
  </section>

  <style>
    .projects-shell {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: 1rem;
      height: calc(100svh - 4.5rem);
      padding-top: 0.8rem;
    }

    .projects-frame {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      height: 100%;
      min-height: 0;
      width: min(100%, 72rem);
      align-items: stretch;
    }

    .frame-tile {
      position: relative;
      min-height: 0;
      height: 100%;
      overflow: visible;
    }

    .frame-tile :global(.project-card) {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      height: 100%;
      min-height: 0;
      width: 100%;
      padding: 0.95rem;
      gap: 0.6rem;
      overflow: visible;
    }

    .frame-tile :global(.card-top) {
      gap: 0.7rem;
    }

    .frame-tile :global(.status-pill) {
      flex-shrink: 0;
    }

    .frame-tile :global(.project-card > *) {
      position: relative;
      z-index: 2;
    }

    .frame-tile :global(.card-summary) {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .frame-tile :global(h3) {
      font-size: 1.18rem;
    }

    .frame-tile :global(.card-eyebrow) {
      margin-bottom: 0.3rem;
      font-size: 0.7rem;
    }

    .frame-tile :global(.tag-row) {
      display: none;
    }

    .frame-tile :global(.card-actions) {
      margin-top: auto;
      gap: 0.55rem;
      font-size: 0.88rem;
    }

    .frame-tile :global(.card-actions > .card-link:first-child) {
      display: none;
    }

    .frame-tile :global(.project-card.surface-glass:hover) {
      transform: none;
    }

    .frame-tile :global(.icon-link) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.85rem;
      height: 1.85rem;
      padding: 0;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
    }

    .frame-tile :global(.icon-link svg) {
      width: 0.95rem;
      height: 0.95rem;
      flex: 0 0 auto;
    }

    .tile-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: var(--radius-lg);
    }

    @media (max-width: 980px) {
      .projects-frame {
        grid-template-columns: 1fr;
        grid-template-rows: none;
        height: auto;
        width: 100%;
        gap: 1rem;
      }

      .frame-tile {
        height: auto;
        overflow: visible;
      }

      .frame-tile :global(.project-card),
      .frame-tile {
        height: auto;
        min-height: 14rem;
      }
    }
  </style>
</BaseLayout>
