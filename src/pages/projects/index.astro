---
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects | Wyatt Entrekin">
  <section class="projects-shell">
    <a class="back-link reveal" href="/"><span aria-hidden="true">←</span> Home</a>

    <div class="projects-frame">
      <div class="frame-tile">
        <ProjectCard
          href="/projects/cfb-rankings"
          title="CFB Rankings"
          eyebrow="Active Project"
          status="Active"
          tone="football"
          summary="A convex quadratic optimization model for ranking college football teams, supported by automated ingestion, storage, publishing, and methodology documentation."
          tags={["Optimization", "Sports Analytics", "Python", "Supabase", "GitHub Actions"]}
        >
          <a slot="actions" class="card-link" href="https://github.com/wmentrekin/cfb-rankings" target="_blank" rel="noreferrer">
            Repository
          </a>
          <a slot="actions" class="card-link" href="/projects/cfb-rankings/methodology">Methodology</a>
          <a
            slot="actions"
            class="card-link"
            href="https://cfb-rankings-wmentrekin.streamlit.app/"
            target="_blank"
            rel="noreferrer"
          >
            Original Site
          </a>
        </ProjectCard>
      </div>

      <div class="frame-tile">
        <ProjectCard
          href="/projects/2020-election-model"
          title="2020 Election Model"
          eyebrow="Archived Project"
          status="Archived"
          tone="archive"
          summary="A state-by-state election forecasting project preserved with its original narrative, map output, and full result tables in an archive-oriented presentation."
          tags={["Python", "Forecasting", "Statistics", "Election Modeling"]}
        >
          <a slot="actions" class="card-link" href="https://github.com/wmentrekin/2020election" target="_blank" rel="noreferrer">
            Repository
          </a>
          <a
            slot="actions"
            class="card-link"
            href="https://wmentrekin.github.io/2020election/"
            target="_blank"
            rel="noreferrer"
          >
            Original Site
          </a>
        </ProjectCard>
      </div>

      <article class="placeholder-card frame-tile reveal">
        <p class="placeholder-eyebrow">Planned</p>
        <h2>College Basketball Rankings</h2>
        <p class="placeholder-copy">Future rankings model adapted from the college football framework.</p>
      </article>

      <article class="placeholder-card frame-tile reveal">
        <p class="placeholder-eyebrow">Planned</p>
        <h2>Memphis Grizzlies Asset Lineage</h2>
        <p class="placeholder-copy">A roster and pick-tracking project built around timelines and network views.</p>
      </article>
    </div>
  </section>

  <style>
    .projects-shell {
      --shell-gap: 0.95rem;
      --frame-gap: 0.9rem;
      display: grid;
      grid-template-rows: auto 1fr;
      gap: var(--shell-gap);
      height: calc(100svh - 4.5rem);
      padding-top: 0.8rem;
      overflow: hidden;
    }

    .projects-frame {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, calc((100% - var(--frame-gap)) / 2));
      gap: var(--frame-gap);
      height: 100%;
      min-height: 0;
    }

    .frame-tile {
      position: relative;
      min-height: 0;
      height: 100%;
      overflow: hidden;
    }

    .frame-tile :global(.project-card) {
      height: 100%;
      min-height: 0;
      padding: 1rem;
      gap: 0.7rem;
      border: 1px solid rgba(255, 255, 255, 0.24);
      border-radius: var(--radius-lg);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        border-color 180ms ease;
    }

    .frame-tile :global(.card-summary) {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .frame-tile :global(h3) {
      font-size: 1.25rem;
    }

    .frame-tile :global(.tag-row) {
      display: none;
    }

    .frame-tile :global(.card-actions) {
      gap: 0.55rem;
      font-size: 0.92rem;
    }

    .placeholder-card {
      position: relative;
      display: grid;
      align-content: start;
      gap: 0.45rem;
      padding: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.24);
      border-radius: var(--radius-lg);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        border-color 180ms ease;
    }

    .frame-tile :global(.project-card::before),
    .placeholder-card::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(
        135deg,
        rgba(125, 211, 252, 0.55),
        rgba(94, 234, 212, 0.2) 45%,
        rgba(255, 255, 255, 0.06) 100%
      );
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 180ms ease;
      pointer-events: none;
    }

    .frame-tile :global(.project-card:hover),
    .placeholder-card:hover {
      transform: translateY(-4px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.28),
        inset 0 -1px 0 rgba(255, 255, 255, 0.04),
        0 14px 28px rgba(0, 0, 0, 0.1);
      border-color: rgba(255, 255, 255, 0.34);
    }

    .frame-tile :global(.project-card:hover::before),
    .placeholder-card:hover::before {
      opacity: 1;
    }

    .placeholder-eyebrow {
      margin: 0;
      color: rgba(150, 169, 188, 0.7);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .placeholder-card h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.2rem;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .placeholder-copy {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
    }

    @media (max-width: 980px) {
      .projects-shell {
        height: auto;
        overflow: visible;
      }

      .projects-frame {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        height: auto;
      }
    }
  </style>
</BaseLayout>
