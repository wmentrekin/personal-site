---
import ProjectCard from "../../components/ProjectCard.astro";
import SectionBlock from "../../components/SectionBlock.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects | Wyatt Entrekin">
  <section class="projects-shell">
    <section class="projects-hero reveal">
      <div class="hero-copy">
        <p class="hero-kicker">Project Index</p>
        <h1>Technical portfolio work built around models, systems, and public-facing outputs.</h1>
        <p class="hero-text">
          These projects are structured as full case studies, with emphasis on architecture, methodology,
          implementation details, and delivery quality rather than isolated visual results.
        </p>
      </div>
      <div class="hero-grid">
        <div class="hero-metric">
          <span>Core themes</span>
          <strong>Sports analytics, optimization, forecasting, data engineering</strong>
        </div>
        <div class="hero-metric">
          <span>Approach</span>
          <strong>Build reliable systems first, then make the outputs readable</strong>
        </div>
      </div>
    </section>

    <SectionBlock
      eyebrow="Portfolio"
      title="Active systems and archived work in one consistent design language."
      intro="The active projects emphasize operational reliability and extensibility. Archived work stays accessible, but is presented as a historical reference rather than a current platform."
    >
      <div class="project-list">
        <ProjectCard
          href="/projects/cfb-rankings"
          title="CFB Rankings"
          eyebrow="Active Project"
          status="Active"
          tone="football"
          summary="A convex quadratic optimization model for ranking college football teams, supported by automated ingestion, storage, publishing, and methodology documentation."
          tags={["Optimization", "Sports Analytics", "Python", "Supabase", "GitHub Actions"]}
        >
          <a slot="actions" class="card-link" href="https://github.com/wmentrekin/cfb-rankings" target="_blank" rel="noreferrer">
            Repository
          </a>
          <a slot="actions" class="card-link" href="/projects/cfb-rankings/methodology">Methodology</a>
          <a
            slot="actions"
            class="card-link"
            href="https://cfb-rankings-wmentrekin.streamlit.app/"
            target="_blank"
            rel="noreferrer"
          >
            Original Site
          </a>
        </ProjectCard>

        <ProjectCard
          href="/projects/2020-election-model"
          title="2020 Election Model"
          eyebrow="Archived Project"
          status="Archived"
          tone="archive"
          summary="A state-by-state election forecasting project preserved with its original narrative, map output, and full result tables in an archive-oriented presentation."
          tags={["Python", "Forecasting", "Statistics", "Election Modeling"]}
        >
          <a slot="actions" class="card-link" href="https://github.com/wmentrekin/2020election" target="_blank" rel="noreferrer">
            Repository
          </a>
          <a
            slot="actions"
            class="card-link"
            href="https://wmentrekin.github.io/2020election/"
            target="_blank"
            rel="noreferrer"
          >
            Original Site
          </a>
        </ProjectCard>
      </div>
    </SectionBlock>
  </section>

  <style>
    .projects-shell {
      display: grid;
      gap: 5rem;
    }

    .projects-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.9fr);
      gap: 1.5rem;
      align-items: end;
      min-height: 22rem;
    }

    .hero-kicker {
      margin: 0 0 0.75rem;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-copy h1 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(3rem, 6vw, 5.5rem);
      line-height: 0.94;
      letter-spacing: -0.06em;
      max-width: 11ch;
      text-wrap: balance;
    }

    .hero-text {
      margin: 1.1rem 0 0;
      max-width: 42rem;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.85;
    }

    .hero-grid {
      display: grid;
      gap: 1rem;
    }

    .hero-metric {
      padding: 1.1rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 35%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .hero-metric span {
      display: block;
      margin-bottom: 0.45rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-metric strong {
      font-size: 1rem;
      line-height: 1.7;
      color: var(--text-soft);
    }

    .project-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    @media (max-width: 980px) {
      .projects-hero,
      .project-list {
        grid-template-columns: 1fr;
      }

      .projects-shell {
        gap: 4rem;
      }
    }
  </style>
</BaseLayout>
