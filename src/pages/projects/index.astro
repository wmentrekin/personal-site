---
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = [
  {
    title: "CFB Rankings",
    eyebrow: "Active Project",
    status: "Active",
    summary: "A convex optimization model for ranking college football teams with automated ingestion, artifact publishing, and methodology documentation.",
    pageHref: "/projects/cfb-rankings",
    repoHref: "https://github.com/wmentrekin/cfb-rankings",
    accentClass: "accent-football"
  },
  {
    title: "2020 Election Model",
    eyebrow: "Archived Project",
    status: "Archived",
    summary: "A state-by-state election forecasting project preserved with its original narrative, map output, and full result tables.",
    pageHref: "/projects/2020-election-model",
    repoHref: "https://github.com/wmentrekin/2020election",
    accentClass: "accent-archive"
  },
  {
    title: "College Basketball Rankings",
    eyebrow: "In Progress",
    status: "In Progress",
    summary: "An in-progress college basketball adaptation of the optimization framework behind the football model.",
    pageHref: "https://github.com/wmentrekin/cbb-rankings",
    repoHref: "https://github.com/wmentrekin/cbb-rankings",
    accentClass: "accent-basketball"
  },
  {
    title: "Memphis Grizzlies Asset Lineage",
    eyebrow: "In Progress",
    status: "In Progress",
    summary: "A Grizzlies project tracing roster and draft-pick asset movement through timeline and network-style views.",
    pageHref: "https://github.com/wmentrekin/nba-asset-lineage",
    repoHref: "https://github.com/wmentrekin/nba-asset-lineage",
    accentClass: "accent-basketball"
  }
];
---

<BaseLayout title="Projects | Wyatt Entrekin">
  <section class="projects-shell">
    <a class="back-link reveal" href="/"><span aria-hidden="true">←</span> Home</a>

    <div class="projects-frame">
      {projects.map((project) => (
        <article class="project-tile glass-card reveal">
          <div class="project-tile__inner">
            <div class="tile-head">
              <div class="tile-copy">
                <p class:list={["tile-eyebrow", project.accentClass]}>{project.eyebrow}</p>
                <h2>{project.title}</h2>
              </div>
              <span class="status-pill">{project.status}</span>
            </div>

            <p class="tile-summary">{project.summary}</p>

            <div class="tile-actions">
              <a
                class="icon-link"
                href={project.repoHref}
                target="_blank"
                rel="noreferrer"
                aria-label={`${project.title} repository`}
                title="Repository"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
                    fill="currentColor"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <a
            class="tile-overlay"
            href={project.pageHref}
            target={project.pageHref.startsWith("http") ? "_blank" : undefined}
            rel={project.pageHref.startsWith("http") ? "noreferrer" : undefined}
            aria-label={`Open ${project.title}`}
          ></a>
        </article>
      ))}
    </div>
  </section>

  <style>
    .projects-shell {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: 1rem;
      height: calc(100svh - 4.5rem);
      padding-top: 0.8rem;
    }

    .projects-frame {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      min-height: 0;
      width: min(100%, 72rem);
    }

    .project-tile {
      min-width: 0;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.22),
        inset 0 -1px 0 rgba(255, 255, 255, 0.03);
    }

    .project-tile:hover {
      transform: none;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.28),
        inset 0 -1px 0 rgba(255, 255, 255, 0.04);
    }

    .project-tile:hover::before {
      opacity: 1;
    }

    .project-tile__inner {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: 0.75rem;
      height: 100%;
      padding: 1rem;
    }

    .tile-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.9rem;
      min-width: 0;
    }

    .tile-copy {
      min-width: 0;
    }

    .tile-eyebrow {
      margin: 0 0 0.3rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .accent-football {
      color: var(--accent-football);
    }

    .accent-basketball {
      color: var(--accent-basketball);
    }

    .accent-archive {
      color: var(--accent-archive);
    }

    .tile-head h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.16rem;
      line-height: 1.04;
      letter-spacing: -0.03em;
      text-wrap: balance;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      min-height: 1.8rem;
      padding: 0.14rem 0.58rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-soft);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      flex-shrink: 0;
    }

    .tile-summary {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .tile-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: auto;
    }

    .icon-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.85rem;
      height: 1.85rem;
      padding: 0;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text);
      text-decoration: none;
    }

    .icon-link svg {
      width: 0.95rem;
      height: 0.95rem;
      flex: 0 0 auto;
    }

    .tile-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: var(--radius-lg);
    }

    @media (max-width: 980px) {
      .projects-shell {
        height: auto;
        min-height: calc(100svh - 4.5rem);
      }

      .projects-frame {
        grid-template-columns: 1fr;
        grid-template-rows: none;
        width: 100%;
      }

      .project-tile {
        min-height: 14rem;
      }
    }
  </style>
</BaseLayout>
