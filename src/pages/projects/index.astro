---
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = [
  {
    titleLines: ["Entrekin Quadratic Index - College Football Rankings"],
    status: "Active",
    summaryLines: [
      "a convex quadratic program to optimally and objectively rank college football teams in FBS based solely on game outcomes",
      "",
      "with automated ingestion, artifact publishing, methodology docs, and weekly in-season updates"
    ],
    pageHref: "/projects/cfb-rankings",
    repoHref: "https://github.com/wmentrekin/cfb-rankings",
    markSrc: "/images/projects/hub/png-marks/cfb.png",
    markAlt: "College football project mark"
  },
  {
    titleLines: ["Agent Skills"],
    status: "Active",
    summaryLines: [
      "my custom AI coding framework that integrates an agentic /work command natively into Claude Code, OpenAI Codex, and Google Antigravity"
    ],
    pageHref: "/projects/agent-skills/",
    repoHref: "https://github.com/wmentrekin/agent-skills",
    markSrc: null,
    markAlt: ""
  },
  {
    titleLines: ["Memphis Grizzlies Asset Lineage"],
    status: "In Progress",
    summaryLines: [
      "a data visualization and journalism project tracing the lineage of franchise player and draft assets since the end of the Grit & Grind era using processed historical transaction data",
      "",
      "an attempt to reconcile the present reality of rebuilding with recent memories of success by analyzing the past and present asset management strategies of the franchise"
    ],
    pageHref: "/projects/grizzlies-asset-lineage/",
    repoHref: "https://github.com/wmentrekin/nba-asset-lineage",
    markSrc: "/images/projects/hub/png-marks/grizzlies.png",
    markAlt: "Memphis Grizzlies project mark"
  },
  {
    titleLines: ["Chronicle"],
    status: "In Progress",
    summaryLines: [
      "an AI-powered agentic workflow for transcription, speaker-diarization, and thematic organization that supports my ongoing family history documentation work"
    ],
    pageHref: "/projects/chronicle/",
    repoHref: "https://github.com/wmentrekin/chronicle/tree/main",
    markSrc: null,
    markAlt: ""
  },
  {
    titleLines: ["College Basketball Rankings"],
    status: "In Progress",
    summaryLines: [
      "a college basketball adaptation of the optimization framework behind the football ranking model"
    ],
    pageHref: "/projects/cbb-rankings/",
    repoHref: "https://github.com/wmentrekin/cbb-rankings",
    markSrc: "/images/projects/hub/png-marks/cbb.png",
    markAlt: "College basketball project mark"
  },
  {
    titleLines: ["2020 Election Model"],
    status: "Archived",
    summaryLines: [
      "an archived state-by-state election forecasting model for the 2020 U.S. presidential election",
      "",
      "built from historical election results, census data, and polling data"
    ],
    pageHref: "/projects/2020-election-model",
    repoHref: "https://github.com/wmentrekin/2020election",
    markSrc: "/images/projects/hub/png-marks/election.png",
    markAlt: "2020 election project mark"
  }
];
---

<BaseLayout title="Projects | Wyatt Entrekin">
  <section class="projects-shell">
    <a class="back-link reveal" href="/"><span aria-hidden="true">←</span> Home</a>

    <div class="projects-frame">
      {projects.map((project) => (
        <article class="project-tile glass-card reveal">
          <div class="project-tile__inner">
            <div class="tile-head">
              <div class="tile-copy">
                <h2>
                  {project.titleLines.map((line) => (
                    <>
                      <span>{line}</span>
                      <br />
                    </>
                  ))}
                </h2>
              </div>
              <div class="tile-meta">
                <span class="status-pill">{project.status}</span>
                {project.repoHref && (
                  <a
                    class="icon-link"
                    href={project.repoHref}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${project.titleLines.join(" ")} repository`}
                    title="Repository"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
                        fill="currentColor"
                      ></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <p class="tile-summary">{project.summaryLines.join("\n")}</p>

            <span class="project-mark-anchor" aria-hidden="true">
              <span class="project-mark-frame">
                {project.markSrc && (
                  <img class="project-mark" src={project.markSrc} alt={project.markAlt} loading="lazy" />
                )}
              </span>
            </span>
          </div>

          {project.pageHref && (
            <a
              class="tile-overlay"
              href={project.pageHref}
              target={project.pageHref.startsWith("http") ? "_blank" : undefined}
              rel={project.pageHref.startsWith("http") ? "noreferrer" : undefined}
              aria-label={`Open ${project.titleLines.join(" ")}`}
            ></a>
          )}
        </article>
      ))}
    </div>
  </section>

  <style>
    .projects-shell {
      display: grid;
      gap: 1rem;
      min-height: calc(100svh - 4.5rem);
      padding-top: 0.8rem;
      padding-bottom: 1.5rem;
    }

    .projects-frame {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(14.75rem, auto));
      gap: 1rem;
      min-height: 0;
      width: min(100%, 72rem);
      margin-inline: auto;
    }

    .project-tile {
      min-width: 0;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.22),
        inset 0 -1px 0 rgba(255, 255, 255, 0.03);
    }

    .project-tile:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }

    .project-tile:hover::before {
      opacity: 1;
    }

    .project-tile__inner {
      position: relative;
      z-index: 4;
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: 0.85rem;
      height: 100%;
      padding: 1rem;
      pointer-events: none;
    }

    .tile-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.9rem;
      min-width: 0;
    }

    .tile-copy {
      min-width: 0;
    }

    .tile-meta {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      flex-shrink: 0;
    }

    .tile-head h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.16rem;
      line-height: 1.04;
      letter-spacing: -0.03em;
      text-wrap: initial;
    }

    .tile-head h2 span {
      display: inline;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      min-height: 1.8rem;
      padding: 0.14rem 0.58rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-soft);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      flex-shrink: 0;
    }

    .tile-summary {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
      white-space: pre-line;
      text-wrap: pretty;
    }

    .project-tile__inner:has(.project-mark-anchor) .tile-summary {
      padding-right: 4.4rem;
    }

    .project-mark-anchor {
      position: absolute;
      right: 1rem;
      bottom: 2.6rem;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }

    .project-mark-frame {
      width: 3.4rem;
      height: 3.4rem;
      padding: 0.55rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.045);
    }

    .project-mark {
      display: block;
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    .icon-link {
      position: relative;
      z-index: 4;
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.85rem;
      height: 1.85rem;
      padding: 0;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text);
      text-decoration: none;
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .icon-link:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-hover);
    }

    .icon-link svg {
      width: 0.95rem;
      height: 0.95rem;
      flex: 0 0 auto;
    }

    .tile-overlay {
      position: absolute;
      inset: 0;
      z-index: 3;
      border-radius: var(--radius-lg);
    }

    @media (max-width: 980px) {
      .projects-shell {
        min-height: calc(100svh - 4.5rem);
      }

      .projects-frame {
        grid-template-columns: 1fr;
        grid-template-rows: none;
        grid-auto-rows: minmax(14rem, auto);
        width: 100%;
      }

      .project-tile {
        min-height: 14rem;
      }

      .project-mark-anchor {
        right: 0.9rem;
        bottom: 2.2rem;
      }
    }
  </style>
</BaseLayout>
