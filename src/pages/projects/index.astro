---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects | Wyatt Entrekin">
  <section class="hero">
    <span class="eyebrow">Projects</span>
    <h1>Projects</h1>
    <p class="muted">
      Active and archived analytics projects.
    </p>
  </section>

  <section class="quick-grid">
    <a class="tile-link" href="/projects/cfb-rankings">
      <div class="tile-icon tone-cfb"></div>
      <h2>CFB Rankings</h2>
      <p class="muted">Optimization ratings project with live snapshot table, repo link, and Streamlit reference app.</p>
    </a>

    <a class="tile-link" href="/projects/2020-election-model">
      <div class="tile-icon tone-election"></div>
      <h2>2020 Election Model</h2>
      <p class="muted">Archived election model project page with repository reference.</p>
    </a>
  </section>
</BaseLayout>
