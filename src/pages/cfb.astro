---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CFB Rankings">
  <section class="card">
    <h1>CFB Optimization Ratings</h1>
    <p id="meta" class="muted">Loading rankings artifact...</p>
    <table>
      <thead>
        <tr>
          <th>Rank</th>
          <th>Team</th>
          <th>Record</th>
          <th>Rating</th>
          <th>Delta</th>
        </tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </section>

  <script>
    /** @typedef {{ rank: number; team: string; record: string; rating: number; delta: number }} RankingRow */
    /** @typedef {{ season: number; week: number; generated_at_utc: string; rankings: RankingRow[] }} RankingPayload */

    async function loadRankings() {
      const meta = document.getElementById("meta");
      const rows = document.getElementById("rows");
      if (!(meta instanceof HTMLParagraphElement) || !(rows instanceof HTMLTableSectionElement)) {
        return;
      }

      const response = await fetch("/data/cfb/latest-rankings.json", { cache: "no-store" });
      if (!response.ok) {
        meta.textContent = "Could not load rankings artifact.";
        return;
      }

      /** @type {RankingPayload} */
      const payload = await response.json();
      meta.textContent = `Season ${payload.season}, Week ${payload.week}. Updated ${payload.generated_at_utc}.`;

      for (const row of payload.rankings) {
        const tr = document.createElement("tr");
        const delta = row.delta > 0 ? `+${row.delta}` : `${row.delta}`;
        tr.innerHTML = `
          <td>${row.rank}</td>
          <td>${row.team}</td>
          <td>${row.record}</td>
          <td>${Number(row.rating).toFixed(2)}</td>
          <td>${delta}</td>
        `;
        rows.appendChild(tr);
      }
    }

    loadRankings();
  </script>
</BaseLayout>
