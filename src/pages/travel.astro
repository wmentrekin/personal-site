---
import TravelGlobe from "../components/TravelGlobe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const visited = [
  "United States",
  "Mexico",
  "Peru",
  "Puerto Rico",
  "Dominican Republic",
  "Italy",
  "Spain",
  "France",
  "Netherlands",
  "United Kingdom",
  "Germany",
  "Austria",
  "Iceland",
  "Ireland",
  "Vatican City",
  "United States Virgin Islands",
  "Costa Rica",
  "Jamaica",
  "Bahamas",
  "Cayman Islands"
];

const visitedIso2 = [
  "US",
  "MX",
  "PE",
  "DO",
  "IT",
  "ES",
  "FR",
  "NL",
  "GB",
  "DE",
  "AT",
  "IS",
  "IE",
  "CR",
  "JM",
  "BS",
  "KY"
];

const nextUp = ["Vietnam"];
---

<BaseLayout
  title="Travel | Wyatt Entrekin"
  description="Travel log and interactive globe visualization by Wyatt Entrekin."
>
  <section class="travel-shell">
    <section class="travel-hero reveal">
      <p class="hero-kicker">Travel</p>
      <h1>Places I&apos;ve been, with a globe I can keep extending over time.</h1>
      <p class="hero-text">
        Visited countries are highlighted on the globe, with trip stops layered on top. This page is meant to stay
        lightweight now and get richer as I add more travel history.
      </p>
    </section>

    <section class="travel-grid">
      <article class="globe-card reveal">
        <div class="globe-stage">
          <TravelGlobe visitedIso2={visitedIso2} />
        </div>
        <p class="globe-note">
          Countries are raised on hover. Territories and microstates may not appear as separate highlighted polygons
          depending on the globe dataset.
        </p>
      </article>

      <div class="travel-column">
        <article class="card reveal">
          <span class="meta-label">Visited</span>
          <ul class="country-list">
            {visited.map((country) => (
              <li>{country}</li>
            ))}
          </ul>
        </article>

        <article class="card reveal">
          <span class="meta-label">Next Up</span>
          <ul class="country-list">
            {nextUp.map((country) => (
              <li>{country}</li>
            ))}
          </ul>
        </article>
      </div>
    </section>
  </section>

  <style>
    .travel-shell {
      display: grid;
      gap: 1.4rem;
    }

    .travel-hero {
      display: grid;
      gap: 0.7rem;
      max-width: 44rem;
      padding-top: 0.2rem;
    }

    .hero-kicker,
    .meta-label {
      margin: 0;
      color: var(--accent-travel);
      font-family: var(--font-mono);
      font-size: 0.76rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .travel-hero h1 {
      margin: 0;
      max-width: 12ch;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 0.98;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .hero-text {
      margin: 0;
      color: var(--muted);
      line-height: 1.75;
    }

    .travel-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(18rem, 0.9fr);
      gap: 1rem;
      align-items: stretch;
    }

    .globe-card {
      display: grid;
      gap: 1rem;
      min-height: 30rem;
      padding: 1.35rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background:
        radial-gradient(circle at 25% 20%, rgba(94, 234, 212, 0.12), transparent 25%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .globe-stage {
      min-height: 24rem;
      height: 100%;
      border-radius: calc(var(--radius-lg) - 6px);
      overflow: hidden;
      border: 1px solid rgba(173, 196, 221, 0.08);
      background:
        radial-gradient(circle at center, rgba(94, 234, 212, 0.12), transparent 42%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    }

    .globe-note {
      margin: 0;
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.6;
    }

    .travel-column {
      display: grid;
      gap: 1rem;
      align-content: start;
    }

    .country-list {
      margin: 0.85rem 0 0;
      padding-left: 1.1rem;
      color: var(--text-soft);
      line-height: 1.7;
    }

    .country-list li + li {
      margin-top: 0.35rem;
    }

    @media (max-width: 900px) {
      .travel-grid {
        grid-template-columns: 1fr;
      }

      .globe-card {
        min-height: 0;
      }

      .globe-stage {
        min-height: 22rem;
      }
    }
  </style>
</BaseLayout>
