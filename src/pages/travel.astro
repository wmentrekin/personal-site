---
import TravelGlobe from "../components/TravelGlobe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const visitedIso2 = [
  "US",
  "MX",
  "PE",
  "DO",
  "IT",
  "ES",
  "FR",
  "NL",
  "GB",
  "DE",
  "AT",
  "IS",
  "IE",
  "CR",
  "JM",
  "BS",
  "KY"
];
---

<BaseLayout
  title="Travel | Wyatt Entrekin"
  description="Travel log and interactive globe visualization by Wyatt Entrekin."
>
  <section class="travel-shell">
    <section class="travel-hero reveal">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span>
        Home
      </a>
      <p class="hero-kicker">Travel</p>
      <h1>Places I&apos;ve been.</h1>
      <p class="hero-text">
        Click and drag the globe to rotate it.
      </p>
    </section>

    <section class="globe-card reveal">
      <div class="globe-stage">
        <TravelGlobe visitedIso2={visitedIso2} />
      </div>
    </section>
  </section>

  <style>
    .travel-shell {
      display: grid;
      gap: 1.6rem;
      justify-items: center;
      padding-top: 0.8rem;
    }

    .travel-hero {
      display: grid;
      gap: 0.7rem;
      width: min(100%, 64rem);
      padding-top: 0.2rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      width: fit-content;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.76rem;
      letter-spacing: 0.06em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .back-link:hover {
      color: var(--text);
    }

    .hero-kicker,
    .meta-label {
      margin: 0;
      color: var(--accent-travel);
      font-family: var(--font-mono);
      font-size: 0.76rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .travel-hero h1 {
      margin: 0;
      max-width: 10ch;
      font-family: var(--font-display);
      font-size: clamp(2.1rem, 4vw, 3.8rem);
      line-height: 0.98;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .hero-text {
      margin: 0;
      color: var(--muted);
      line-height: 1.75;
    }

    .globe-card {
      display: grid;
      width: min(100%, 72rem);
      padding: 1.5rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background:
        radial-gradient(circle at 25% 20%, rgba(94, 234, 212, 0.12), transparent 25%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .globe-stage {
      min-height: 36rem;
      border-radius: calc(var(--radius-lg) - 6px);
      overflow: hidden;
      border: 1px solid rgba(173, 196, 221, 0.08);
      background:
        radial-gradient(circle at center, rgba(94, 234, 212, 0.12), transparent 42%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    }

    @media (max-width: 900px) {
      .globe-stage {
        min-height: 28rem;
      }
    }
  </style>
</BaseLayout>
