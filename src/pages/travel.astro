---
import TravelGlobe from "../components/TravelGlobe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const visitedIso2 = [
  "MX",
  "PE",
  "DO",
  "IT",
  "ES",
  "FR",
  "NL",
  "GB",
  "DE",
  "AT",
  "IS",
  "IE",
  "CR",
  "JM",
  "BS",
  "KY"
];

const visitedUsStates = ["GA", "TN", "PR", "AL", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "ID", "IL", "IN", "KY", "LA", "MD", "MA", "MI", "MS", "MO", "NV", "NH", "NJ", "NY", "NC", "OH", "PA", "RI", "SC", "TX", "UT", "VT", "VA", "WY"];
---

<BaseLayout
  title="Travel | Wyatt Entrekin"
>
  <section class="travel-shell">
    <section class="travel-hero reveal">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span>
        Home
      </a>
    </section>

    <section class="globe-card reveal">
      <div class="globe-stage">
        <TravelGlobe visitedIso2={visitedIso2} visitedUsStates={visitedUsStates} />
      </div>
      <p class="globe-note">Click and drag to rotate the globe. Use the scroll wheel to zoom.</p>
    </section>
  </section>

  <style>
    .travel-shell {
      display: grid;
      gap: 1.6rem;
      justify-items: center;
      padding-top: 0.8rem;
    }

    .travel-hero {
      display: grid;
      width: min(100%, 72rem);
      padding-top: 0.2rem;
    }

    .globe-card {
      display: grid;
      gap: 0.7rem;
      width: min(100%, 72rem);
      justify-items: center;
    }

    .globe-stage {
      width: min(100%, 68rem);
      min-height: 42rem;
      overflow: visible;
    }

    .globe-note {
      margin: 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    @media (max-width: 900px) {
      .globe-stage {
        min-height: 30rem;
      }

      /* TravelGlobe.astro sets its own min-height floors on the shell/canvas
         (32rem / 36rem) that are taller than the value above, so without this
         override the stage never actually shrinks below ~36rem. Reach into
         the child component's classes from here rather than editing that
         shared file, since it stays reusable (e.g. for the Home mini-globe). */
      .globe-stage :global(.travel-globe-shell),
      .globe-stage :global(.travel-globe-canvas) {
        min-height: 26rem;
      }
    }

    @media (max-width: 480px) {
      .travel-shell {
        gap: 1.1rem;
        padding-top: 0.5rem;
      }

      .globe-card {
        gap: 0.5rem;
      }

      .globe-stage {
        min-height: 20rem;
      }

      .globe-stage :global(.travel-globe-shell),
      .globe-stage :global(.travel-globe-canvas) {
        min-height: 18rem;
      }

      .globe-note {
        font-size: 0.66rem;
      }
    }
  </style>
</BaseLayout>
