---
import TravelGlobe from "../components/TravelGlobe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const visitedIso2 = [
  "US",
  "PR",
  "MX",
  "PE",
  "DO",
  "IT",
  "ES",
  "FR",
  "NL",
  "GB",
  "DE",
  "AT",
  "IS",
  "IE",
  "CR",
  "JM",
  "BS",
  "KY"
];
---

<BaseLayout
  title="Travel | Wyatt Entrekin"
>
  <section class="travel-shell">
    <section class="travel-hero reveal">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span>
        Home
      </a>
    </section>

    <section class="globe-card reveal">
      <div class="globe-stage">
        <TravelGlobe visitedIso2={visitedIso2} />
      </div>
    </section>
  </section>

  <style>
    .travel-shell {
      display: grid;
      gap: 1.6rem;
      justify-items: center;
      padding-top: 0.8rem;
    }

    .travel-hero {
      display: grid;
      width: min(100%, 72rem);
      padding-top: 0.2rem;
    }

    .globe-card {
      display: grid;
      width: min(100%, 72rem);
      justify-items: center;
    }

    .globe-stage {
      width: min(100%, 68rem);
      min-height: 42rem;
      border: 1px solid rgba(173, 196, 221, 0.24);
      border-radius: calc(var(--radius-lg) - 2px);
      background:
        radial-gradient(circle at center, rgba(255, 255, 255, 0.02), transparent 55%),
        rgba(8, 13, 20, 0.74);
      box-shadow:
        0 24px 60px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.04);
      overflow: hidden;
    }

    @media (max-width: 900px) {
      .globe-stage {
        min-height: 30rem;
      }
    }
  </style>
</BaseLayout>
