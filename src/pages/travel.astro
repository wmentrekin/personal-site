---
import TravelGlobe from "../components/TravelGlobe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const visitedIso2 = [
  "US",
  "MX",
  "PE",
  "DO",
  "IT",
  "ES",
  "FR",
  "NL",
  "GB",
  "DE",
  "AT",
  "IS",
  "IE",
  "CR",
  "JM",
  "BS",
  "KY"
];
---

<BaseLayout
  title="Travel | Wyatt Entrekin"
>
  <section class="travel-shell">
    <section class="travel-hero reveal">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span>
        Home
      </a>
      <p class="hero-kicker">Travel</p>
    </section>

    <section class="globe-card reveal">
      <div class="globe-stage">
        <TravelGlobe visitedIso2={visitedIso2} />
      </div>
    </section>
  </section>

  <style>
    .travel-shell {
      display: grid;
      gap: 1.6rem;
      justify-items: center;
      padding-top: 0.8rem;
    }

    .travel-hero {
      display: grid;
      gap: 0.7rem;
      width: min(100%, 64rem);
      padding-top: 0.2rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      width: fit-content;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.76rem;
      letter-spacing: 0.06em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .back-link:hover {
      color: var(--text);
    }

    .hero-kicker,
    .meta-label {
      margin: 0;
      color: var(--accent-travel);
      font-family: var(--font-mono);
      font-size: 0.76rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .travel-hero h1 {
      margin: 0;
      max-width: 10ch;
      font-family: var(--font-display);
      font-size: clamp(2.1rem, 4vw, 3.8rem);
      line-height: 0.98;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .hero-text {
      margin: 0;
      color: var(--muted);
      line-height: 1.75;
    }

    .globe-card {
      display: grid;
      width: min(100%, 72rem);
      justify-items: center;
    }

    .globe-stage {
      width: min(100%, 68rem);
      min-height: 40rem;
    }

    @media (max-width: 900px) {
      .globe-stage {
        min-height: 28rem;
      }
    }
  </style>
</BaseLayout>
