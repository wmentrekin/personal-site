---
import TravelGlobe from "../components/TravelGlobe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const visitedIso2 = [
  "MX",
  "PE",
  "DO",
  "IT",
  "ES",
  "FR",
  "NL",
  "GB",
  "DE",
  "AT",
  "IS",
  "IE",
  "CR",
  "JM",
  "BS",
  "KY"
];

const visitedUsStates = ["GA", "TN", "PR", "AL", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "ID", "IL", "IN", "KY", "LA", "MD", "MA", "MI", "MS", "MO", "NV", "NH", "NJ", "NY", "NC", "OH", "PA", "RI", "SC", "TX", "UT", "VT", "VA", "WY"];
---

<BaseLayout
  title="Travel | Wyatt Entrekin"
>
  <section class="travel-shell">
    <section class="travel-hero reveal">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span>
        Home
      </a>
    </section>

    <section class="globe-card reveal">
      <div class="globe-stage">
        <TravelGlobe visitedIso2={visitedIso2} visitedUsStates={visitedUsStates} />
      </div>
    </section>
  </section>

  <style>
    .travel-shell {
      display: grid;
      gap: 1.6rem;
      justify-items: center;
      padding-top: 0.8rem;
    }

    .travel-hero {
      display: grid;
      width: min(100%, 72rem);
      padding-top: 0.2rem;
    }

    .globe-card {
      display: grid;
      width: min(100%, 72rem);
      justify-items: center;
    }

    .globe-stage {
      width: min(100%, 68rem);
      min-height: 42rem;
      overflow: visible;
    }

    @media (max-width: 900px) {
      .globe-stage {
        min-height: 30rem;
      }
    }
  </style>
</BaseLayout>
