---
import { readFileSync } from "node:fs";

import ChartFrame from "../components/ChartFrame.astro";
import ProjectCard from "../components/ProjectCard.astro";
import RankingsTable from "../components/RankingsTable.astro";
import SectionBlock from "../components/SectionBlock.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const rankingsPath = new URL("../../public/data/cfb/latest-rankings.json", import.meta.url);
const rankingsPayload = JSON.parse(readFileSync(rankingsPath, "utf-8"));
const sampleRows = rankingsPayload.rankings.slice(0, 5).map((team: Record<string, string | number>) => [
  team.rank,
  team.team,
  team.record,
  Number(team.rating).toFixed(2),
  Number(team.delta) > 0 ? `+${team.delta}` : `${team.delta}`
]);
const updatedLabel = `Season ${rankingsPayload.season}, Week ${rankingsPayload.week}`;
---

<BaseLayout title="Wyatt Entrekin">
  <section class="home-shell">
    <section class="hero-grid">
      <div class="hero-main reveal">
        <p class="hero-kicker">Sports Analytics + Data Engineering</p>
        <h1>Sports analytics systems built with production-minded engineering.</h1>
        <p class="hero-text">
          Rankings, simulations, and technical writeups designed to be reliable, inspectable, and useful.
        </p>
        <div class="hero-actions">
          <a class="hero-link primary" href="/projects">Browse Projects</a>
          <a class="hero-link" href="/about">Background</a>
        </div>
      </div>

      <aside class="hero-rail reveal">
        <div class="signal-card">
          <p class="signal-label">Current Focus</p>
          <ul>
            <li>Optimization-based sports ratings</li>
            <li>Artifact-first delivery for reliability</li>
            <li>Methodology pages that explain the system</li>
          </ul>
        </div>
      </aside>
    </section>

    <section class="featured-panel reveal">
      <div class="featured-copy">
        <p class="featured-label">Featured Project</p>
        <h2>CFB Rankings</h2>
        <p>
          Weekly college football rankings powered by a convex quadratic program and published as static artifacts.
        </p>
      </div>
      <div class="featured-meta">
        <div>
          <span>Model</span>
          <strong>Convex quadratic program</strong>
        </div>
        <div>
          <span>Delivery</span>
          <strong>Static artifacts + public UI</strong>
        </div>
        <div>
          <span>Ops</span>
          <strong>Automated weekly refreshes</strong>
        </div>
      </div>
      <div class="featured-actions">
        <a href="/projects/cfb-rankings">Open project</a>
        <a href="/projects/cfb-rankings/methodology">Read methodology</a>
      </div>
    </section>

    <SectionBlock
      id="projects"
      eyebrow="Selected Work"
      title="Projects"
      intro="Systems, not just screenshots."
    >
      <div class="project-grid">
        <ProjectCard
          href="/projects/cfb-rankings"
          title="CFB Rankings"
          eyebrow="Sports Analytics"
          status="Active"
          tone="football"
          summary="Weekly college football rankings with automated ingestion, optimization, publication, and static artifact resilience."
          tags={["Optimization", "Pipelines", "Astro", "Public UI"]}
        >
          <a slot="actions" class="card-link" href="/projects/cfb-rankings/methodology">Methodology</a>
        </ProjectCard>

        <ProjectCard
          href="/projects/cfb-rankings/methodology"
          title="Methodology Articles"
          eyebrow="Long-form Technical Writing"
          status="Docs"
          tone="article"
          summary="Mathematical documentation, implementation notes, and rationale written to make the model inspectable and critiqueable."
          tags={["Equations", "Assumptions", "Documentation"]}
        />

        <ProjectCard
          href="/projects/2020-election-model"
          title="2020 Election Model"
          eyebrow="Archive"
          status="Archived"
          tone="archive"
          summary="An earlier forecasting project preserved as a full archive, including original writeup, map output, and result tables."
          tags={["Forecasting", "Statistics", "Historical Snapshot"]}
        />
      </div>
    </SectionBlock>

    <section class="analytics-grid reveal">
      <ChartFrame
        title="Rankings Snapshot"
        subtitle="The shared table pattern for rankings, deltas, and future simulation outputs."
        source="Static artifact"
        updatedAt={updatedLabel}
      >
        <RankingsTable
          headers={["Rank", "Team", "Record", "Rating", "Delta"]}
          rows={sampleRows}
        />
      </ChartFrame>

      <article class="compact-note">
        <p class="signal-label">What This Site Is For</p>
        <p>
          A compact portfolio for sports analytics, methodology articles, and data engineering case studies.
        </p>
        <a href="/about">Read background</a>
      </article>
    </section>
  </section>

  <style>
    .home-shell {
      display: grid;
      gap: 2.4rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(18rem, 0.9fr);
      gap: 1rem;
      align-items: end;
    }

    .hero-main {
      display: grid;
      gap: 0.9rem;
      padding-top: 0.4rem;
      max-width: 42rem;
    }

    .hero-kicker,
    .featured-label,
    .signal-label {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-main h1 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 6vw, 4.9rem);
      line-height: 0.94;
      letter-spacing: -0.06em;
      max-width: 11ch;
      text-wrap: balance;
    }

    .hero-text {
      margin: 0;
      max-width: 34rem;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.7;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
      margin-top: 0.1rem;
    }

    .hero-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.9rem;
      padding: 0.6rem 1rem;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }

    .hero-link.primary {
      background: linear-gradient(135deg, rgba(125, 211, 252, 0.22), rgba(96, 165, 250, 0.12));
      border-color: rgba(125, 211, 252, 0.24);
    }

    .hero-link:hover {
      transform: translateY(-2px);
      border-color: rgba(125, 211, 252, 0.34);
    }

    .hero-rail {
      display: grid;
      gap: 0.8rem;
      padding-top: 0;
    }

    .signal-card {
      padding: 1rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 35%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .signal-card ul,
    .signal-card dl {
      margin: 0.8rem 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 0.85rem;
    }

    .signal-card li,
    .signal-card dd {
      margin: 0;
      color: var(--text-soft);
      line-height: 1.7;
    }

    .signal-card li {
      padding-top: 0.7rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .signal-card dt {
      color: var(--muted);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.25rem;
    }

    .featured-panel {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 0.85fr));
      gap: 1rem;
      padding: 1.15rem;
      border-radius: 1.5rem;
      border: 1px solid rgba(163, 230, 53, 0.18);
      background:
        radial-gradient(circle at 0% 0%, rgba(163, 230, 53, 0.1), transparent 30%),
        linear-gradient(160deg, rgba(18, 29, 25, 0.96), rgba(10, 16, 20, 0.98));
      box-shadow: var(--shadow-card);
    }

    .featured-copy h2 {
      margin: 0.3rem 0 0.55rem;
      font-family: var(--font-display);
      font-size: clamp(1.7rem, 3vw, 2.6rem);
      line-height: 1;
      letter-spacing: -0.05em;
    }

    .featured-copy p:last-child {
      margin: 0;
      color: var(--muted);
      line-height: 1.65;
      max-width: 30rem;
    }

    .featured-meta {
      display: grid;
      gap: 0.9rem;
    }

    .featured-meta div,
    .featured-actions {
      padding: 0.85rem;
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .featured-meta span {
      display: block;
      margin-bottom: 0.45rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .featured-meta strong {
      font-size: 0.94rem;
      line-height: 1.45;
    }

    .featured-actions {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .featured-actions a,
    .about-band a {
      position: relative;
      width: fit-content;
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
    }

    .featured-actions a::after,
    .about-band a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -0.15rem;
      width: 100%;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 180ms ease;
    }

    .featured-actions a:hover::after,
    .about-band a:hover::after {
      transform: scaleX(1);
    }

    .project-grid,
    .analytics-grid {
      display: grid;
      gap: 1rem;
    }

    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .analytics-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.65fr);
    }

    .compact-note {
      display: grid;
      gap: 0.75rem;
      align-content: start;
      padding: 1.05rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .compact-note p {
      margin: 0;
      color: var(--muted);
      line-height: 1.65;
    }

    .compact-note a {
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      position: relative;
      width: fit-content;
    }

    .compact-note a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -0.14rem;
      width: 100%;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 180ms ease;
    }

    .compact-note a:hover::after {
      transform: scaleX(1);
    }

    @media (max-width: 1100px) {
      .featured-panel,
      .project-grid,
      .analytics-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 900px) {
      .home-shell {
        gap: 2rem;
      }

      .hero-grid {
        grid-template-columns: 1fr;
      }

      .hero-main {
        padding-top: 0.4rem;
      }

      .hero-main h1 {
        max-width: 100%;
      }
    }
  </style>
</BaseLayout>
