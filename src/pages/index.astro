---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Wyatt Entrekin">
  <section class="home-stage">
    <div class="home-frame">
      <section class="intro-card reveal">
        <div class="intro-copy">
          <p class="eyebrow">Wyatt Entrekin</p>
          <h1>Hi, I&apos;m Wyatt.</h1>
          <p class="intro-text">
            I&apos;m a Data Engineer with a passion for analytics, optimization, and building reliable technical systems.
          </p>
          <p class="intro-text">
            This site is a home for sports analytics projects, methodology writeups, and engineering-focused case studies.
          </p>
        </div>

        <div class="social-row">
          <a href="https://github.com/wmentrekin" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/wentrekin/" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M6.94 8.5a1.56 1.56 0 1 1 0-3.12 1.56 1.56 0 0 1 0 3.12Zm1.3 2.12H5.65V19h2.59v-8.38ZM12.37 10.62H9.8V19h2.56v-4.4c0-2.32 3-2.51 3 0V19H18v-5.32c0-4.14-4.56-3.99-5.63-1.95v-1.11Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
          <a href="mailto:wmentrekin@gmail.com">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M3.27 5.5A2.25 2.25 0 0 1 5.5 4h13a2.25 2.25 0 0 1 2.23 1.5L12 12.18 3.27 5.5Zm-.27 1.9V18.5A2.5 2.5 0 0 0 5.5 21h13a2.5 2.5 0 0 0 2.5-2.5V7.4l-8.33 6.36a1.1 1.1 0 0 1-1.34 0L3 7.4Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
        </div>

        <p class="focus-line">
          <span>Focus</span>
          Data Engineering, Operations Research, Analytics
        </p>
      </section>

      <section class="link-grid">
        <a class="link-tile tone-football reveal" href="/projects/cfb-rankings">
          <p class="eyebrow accent-football">Featured</p>
          <h2>CFB Rankings</h2>
          <p>Weekly college football ratings.</p>
        </a>

        <a class="link-tile tone-method reveal" href="/projects/cfb-rankings/methodology">
          <p class="eyebrow accent-method">Documentation</p>
          <h2>Methodology</h2>
          <p>Model assumptions and equations.</p>
        </a>

        <a class="link-tile tone-projects reveal" href="/projects">
          <p class="eyebrow">Index</p>
          <h2>All Projects</h2>
          <p>Portfolio index and archive.</p>
        </a>

        <a class="link-tile tone-about reveal" href="/about">
          <p class="eyebrow">Profile</p>
          <h2>About</h2>
          <p>Background and experience.</p>
        </a>

        <a class="link-tile tone-election reveal" href="/projects/2020-election-model">
          <p class="eyebrow accent-archive">Archive</p>
          <h2>2020 Election Model</h2>
          <p>Forecasting project archive.</p>
        </a>

        <a class="link-tile tone-repo reveal" href="https://github.com/wmentrekin" target="_blank" rel="noreferrer">
          <p class="eyebrow">External</p>
          <h2>GitHub</h2>
          <p>Source code and repositories.</p>
        </a>
      </section>
    </div>
  </section>

  <style>
    .home-stage {
      min-height: calc(100svh - 4.5rem);
      display: grid;
      align-items: stretch;
    }

    .home-frame {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      grid-template-rows: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      min-height: calc(100svh - 4.5rem);
    }

    .intro-card,
    .link-tile {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .intro-card {
      display: grid;
      grid-row: span 2;
      align-content: start;
      gap: 0.9rem;
      padding: 1rem 1.05rem;
      background:
        radial-gradient(circle at top left, rgba(125, 211, 252, 0.12), transparent 30%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
    }

    .eyebrow {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .accent-football {
      color: var(--accent-football);
    }

    .accent-method {
      color: var(--accent-method);
    }

    .accent-archive {
      color: var(--accent-archive);
    }

    .intro-card h1 {
      margin: 0.35rem 0 0;
      max-width: 8.5ch;
      font-family: var(--font-display);
      font-size: clamp(1.65rem, 2.5vw, 2.35rem);
      line-height: 0.98;
      letter-spacing: -0.06em;
      text-wrap: balance;
    }

    .intro-text {
      margin: 0.45rem 0 0;
      max-width: 27rem;
      color: var(--muted);
      font-size: 0.89rem;
      line-height: 1.55;
    }

    .social-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }

    .social-row a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.35rem;
      min-width: 2.35rem;
      padding: 0;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }

    .social-row svg {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
    }

    .social-row a:hover {
      transform: translateY(-2px);
      border-color: rgba(125, 211, 252, 0.34);
      background: rgba(255, 255, 255, 0.05);
    }

    .focus-line {
      margin: 0;
      color: var(--text-soft);
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .focus-line span {
      margin-right: 0.5rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .link-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: subgrid;
      grid-row: span 3;
      gap: 1rem;
    }

    .link-tile {
      display: grid;
      align-content: end;
      gap: 0.55rem;
      min-height: 9.75rem;
      padding: 1rem;
      position: relative;
      text-decoration: none;
      color: var(--text);
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    }

    .link-tile::after {
      content: "";
      position: absolute;
      inset: -4rem -3rem auto auto;
      width: 8rem;
      height: 8rem;
      border-radius: 999px;
      filter: blur(18px);
      opacity: 0.14;
      background: var(--tone, var(--accent));
    }

    .link-tile:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
      border-color: rgba(255, 255, 255, 0.12);
    }

    .link-tile h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.2rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .link-tile p:not(.eyebrow) {
      margin: 0;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    @media (max-width: 1080px) {
      .home-stage {
        min-height: auto;
      }

      .home-frame {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        min-height: auto;
      }

      .link-grid {
        grid-template-rows: auto;
        grid-row: auto;
      }
    }

    @media (max-width: 720px) {
      .intro-card h1 {
        max-width: 100%;
      }

      .link-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
