---
import { readFileSync } from "node:fs";

import RankingsTable from "../components/RankingsTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const rankingsPath = new URL("../../public/data/cfb/latest-rankings.json", import.meta.url);
const rankingsPayload = JSON.parse(readFileSync(rankingsPath, "utf-8"));
const sampleRows = rankingsPayload.rankings.slice(0, 5).map((team: Record<string, string | number>) => [
  team.rank,
  team.team,
  team.record,
  Number(team.rating).toFixed(2),
  Number(team.delta) > 0 ? `+${team.delta}` : `${team.delta}`
]);
---

<BaseLayout title="Wyatt Entrekin">
  <section class="home-stage">
    <div class="home-grid">
      <section class="hero-card reveal">
        <p class="eyebrow">Sports Analytics + Data Engineering</p>
        <h1>Analytics systems built with production-minded engineering.</h1>
        <p class="hero-copy">
          Rankings, simulations, and methodology pages designed to be reliable, inspectable, and useful.
        </p>
        <div class="hero-actions">
          <a class="hero-link primary" href="/projects">Browse Projects</a>
          <a class="hero-link" href="/about">About</a>
        </div>
        <dl class="hero-meta">
          <div>
            <dt>Focus</dt>
            <dd>Optimization, pipelines, technical writing</dd>
          </div>
          <div>
            <dt>Current build</dt>
            <dd>Artifact-first sports analytics portfolio</dd>
          </div>
        </dl>
      </section>

      <section class="snapshot-card reveal">
        <div class="card-head">
          <div>
            <p class="eyebrow accent-football">CFB Snapshot</p>
            <h2>Latest Rankings</h2>
          </div>
          <p class="meta-note">S{rankingsPayload.season} W{rankingsPayload.week}</p>
        </div>
        <RankingsTable headers={["Rank", "Team", "Record", "Rating", "Delta"]} rows={sampleRows} />
      </section>

      <article class="feature-card tone-football reveal">
        <p class="eyebrow accent-football">Featured Project</p>
        <h2>CFB Rankings</h2>
        <p>Convex quadratic rankings published weekly with static artifacts and methodology documentation.</p>
        <div class="card-links">
          <a href="/projects/cfb-rankings">Project</a>
          <a href="/projects/cfb-rankings/methodology">Methodology</a>
        </div>
      </article>

      <article class="feature-card tone-method reveal">
        <p class="eyebrow accent-method">Documentation</p>
        <h2>Methodology</h2>
        <p>Long-form technical writing for equations, assumptions, architecture, and implementation details.</p>
        <div class="card-links">
          <a href="/projects/cfb-rankings/methodology">Read Article</a>
        </div>
      </article>

      <article class="feature-card tone-archive reveal">
        <p class="eyebrow accent-archive">Archive</p>
        <h2>2020 Election Model</h2>
        <p>A preserved forecasting project with original narrative, result tables, and map output.</p>
        <div class="card-links">
          <a href="/projects/2020-election-model">Open Archive</a>
        </div>
      </article>
    </div>
  </section>

  <style>
    .home-stage {
      min-height: calc(100svh - 8.2rem);
      display: grid;
      align-items: stretch;
    }

    .home-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1.05fr) minmax(0, 0.8fr);
      gap: 1rem;
      min-height: 100%;
    }

    .hero-card,
    .snapshot-card,
    .feature-card {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .hero-card {
      grid-column: span 7;
      display: grid;
      align-content: space-between;
      gap: 1rem;
      padding: 1.2rem 1.25rem;
      background:
        radial-gradient(circle at 0% 0%, rgba(125, 211, 252, 0.12), transparent 32%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
    }

    .snapshot-card {
      grid-column: span 5;
      padding: 1rem;
    }

    .feature-card {
      grid-column: span 4;
      display: grid;
      gap: 0.75rem;
      align-content: start;
      padding: 1rem 1.05rem;
      position: relative;
    }

    .feature-card::after {
      content: "";
      position: absolute;
      inset: -4rem -3rem auto auto;
      width: 8rem;
      height: 8rem;
      border-radius: 999px;
      filter: blur(18px);
      opacity: 0.16;
      background: var(--tone);
    }

    .tone-football {
      --tone: var(--accent-football);
    }

    .tone-method {
      --tone: var(--accent-method);
    }

    .tone-archive {
      --tone: var(--accent-archive);
    }

    .eyebrow {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .accent-football {
      color: var(--accent-football);
    }

    .accent-method {
      color: var(--accent-method);
    }

    .accent-archive {
      color: var(--accent-archive);
    }

    .hero-card h1 {
      margin: 0.35rem 0 0;
      max-width: 10ch;
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      line-height: 0.94;
      letter-spacing: -0.06em;
      text-wrap: balance;
    }

    .hero-copy {
      margin: 0;
      max-width: 32rem;
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.65;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
    }

    .hero-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.8rem;
      padding: 0.55rem 0.95rem;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      transition: transform 180ms ease, border-color 180ms ease;
    }

    .hero-link.primary {
      background: linear-gradient(135deg, rgba(125, 211, 252, 0.22), rgba(96, 165, 250, 0.12));
      border-color: rgba(125, 211, 252, 0.24);
    }

    .hero-link:hover {
      transform: translateY(-2px);
      border-color: rgba(125, 211, 252, 0.34);
    }

    .hero-meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      margin: 0;
    }

    .hero-meta div {
      padding: 0.8rem 0.9rem;
      border-radius: var(--radius-md);
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(255, 255, 255, 0.03);
    }

    .hero-meta dt {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-meta dd {
      margin: 0.4rem 0 0;
      color: var(--text-soft);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .card-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .card-head h2,
    .feature-card h2 {
      margin: 0.35rem 0 0;
      font-family: var(--font-display);
      font-size: 1.35rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .meta-note {
      margin: 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.76rem;
    }

    .feature-card p:not(.eyebrow) {
      margin: 0;
      color: var(--muted);
      font-size: 0.94rem;
      line-height: 1.6;
      max-width: 28rem;
    }

    .card-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
      margin-top: 0.1rem;
    }

    .card-links a {
      position: relative;
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      width: fit-content;
    }

    .card-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -0.12rem;
      width: 100%;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 180ms ease;
    }

    .card-links a:hover::after {
      transform: scaleX(1);
    }

    @media (max-width: 1080px) {
      .home-stage {
        min-height: auto;
      }

      .home-grid {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
      }

      .hero-card,
      .snapshot-card,
      .feature-card {
        grid-column: auto;
      }
    }

    @media (max-width: 720px) {
      .hero-card h1 {
        max-width: 100%;
      }

      .hero-meta {
        grid-template-columns: 1fr;
      }

      .card-head {
        align-items: start;
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
