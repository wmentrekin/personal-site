---
import { readFileSync } from "node:fs";

import ChartFrame from "../components/ChartFrame.astro";
import ProjectCard from "../components/ProjectCard.astro";
import RankingsTable from "../components/RankingsTable.astro";
import SectionBlock from "../components/SectionBlock.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const rankingsPath = new URL("../../public/data/cfb/latest-rankings.json", import.meta.url);
const rankingsPayload = JSON.parse(readFileSync(rankingsPath, "utf-8"));
const sampleRows = rankingsPayload.rankings.slice(0, 5).map((team: Record<string, string | number>) => [
  team.rank,
  team.team,
  team.record,
  Number(team.rating).toFixed(2),
  Number(team.delta) > 0 ? `+${team.delta}` : `${team.delta}`
]);
const updatedLabel = `Season ${rankingsPayload.season}, Week ${rankingsPayload.week}`;
---

<BaseLayout title="Wyatt Entrekin">
  <section class="home-shell">
    <section class="hero-grid">
      <div class="hero-main reveal">
        <p class="hero-kicker">Sports Analytics + Data Engineering</p>
        <h1>Developer-grade analytics systems with clear models, reliable pipelines, and public-facing outputs.</h1>
        <p class="hero-text">
          I build technical portfolio projects around rankings, simulation, optimization, and data delivery. The work
          starts with data contracts and ends with something people can actually use.
        </p>
        <div class="hero-actions">
          <a class="hero-link primary" href="/projects">Browse Projects</a>
          <a class="hero-link" href="/about">Background</a>
        </div>
      </div>

      <aside class="hero-rail reveal">
        <div class="signal-card">
          <p class="signal-label">Current Focus</p>
          <ul>
            <li>Optimization-based sports ratings</li>
            <li>Artifact-first delivery for reliability</li>
            <li>Technical writeups that explain the system</li>
          </ul>
        </div>
        <div class="signal-card">
          <p class="signal-label">Working Modes</p>
          <dl>
            <div>
              <dt>Primary stack</dt>
              <dd>Python, SQL, Astro, cloud data tooling</dd>
            </div>
            <div>
              <dt>Project style</dt>
              <dd>Transparent models, operational rigor, readable outputs</dd>
            </div>
          </dl>
        </div>
      </aside>
    </section>

    <section class="featured-panel reveal">
      <div class="featured-copy">
        <p class="featured-label">Featured Project</p>
        <h2>CFB Rankings</h2>
        <p>
          A college football rating system built as a full technical product: ingest, model, publish, archive, and
          explain. The core ranking engine is a convex quadratic program designed for transparent, repeatable weekly
          output.
        </p>
      </div>
      <div class="featured-meta">
        <div>
          <span>Model</span>
          <strong>Convex quadratic program</strong>
        </div>
        <div>
          <span>Delivery</span>
          <strong>Static artifacts + public UI</strong>
        </div>
        <div>
          <span>Ops</span>
          <strong>Automated weekly refreshes</strong>
        </div>
      </div>
      <div class="featured-actions">
        <a href="/projects/cfb-rankings">Open project</a>
        <a href="/projects/cfb-rankings/methodology">Read methodology</a>
      </div>
    </section>

    <SectionBlock
      id="projects"
      eyebrow="Selected Work"
      title="A portfolio structured like a technical system, not a gallery."
      intro="Each project is documented around architecture, analytical method, and delivery. The design goal is to make the work readable whether the page is showing rankings, methodology, or infrastructure context."
    >
      <div class="project-grid">
        <ProjectCard
          href="/projects/cfb-rankings"
          title="CFB Rankings"
          eyebrow="Sports Analytics"
          status="Active"
          tone="football"
          summary="Weekly college football rankings with automated ingestion, optimization, publication, and static artifact resilience."
          tags={["Optimization", "Pipelines", "Astro", "Public UI"]}
        >
          <a slot="actions" class="card-link" href="/projects/cfb-rankings/methodology">Methodology</a>
        </ProjectCard>

        <ProjectCard
          href="/projects/cfb-rankings/methodology"
          title="Methodology Articles"
          eyebrow="Long-form Technical Writing"
          status="Docs"
          tone="article"
          summary="Mathematical documentation, implementation notes, and rationale written to make the model inspectable and critiqueable."
          tags={["Equations", "Assumptions", "Documentation"]}
        />

        <ProjectCard
          href="/projects/2020-election-model"
          title="2020 Election Model"
          eyebrow="Archive"
          status="Archived"
          tone="archive"
          summary="An earlier forecasting project preserved as a full archive, including original writeup, map output, and result tables."
          tags={["Forecasting", "Statistics", "Historical Snapshot"]}
        />
      </div>
    </SectionBlock>

    <SectionBlock
      eyebrow="Analytics Surfaces"
      title="Interfaces built for charts, rankings, and system context."
      intro="The design system needs to handle both polished presentation and dense analytical content. These modules show the intended treatment for tables and chart containers."
    >
      <div class="analytics-grid">
        <ChartFrame
          title="Rankings Snapshot"
          subtitle="Compact, readable table styling for standings, weekly movement, and future simulation outputs."
          source="Static artifact"
          updatedAt={updatedLabel}
        >
          <RankingsTable
            headers={["Rank", "Team", "Record", "Rating", "Delta"]}
            rows={sampleRows}
          />
        </ChartFrame>

        <ChartFrame
          title="Pipeline / Lineage Panel"
          subtitle="A reusable chart card for timelines, architecture notes, and asset lineage views."
          source="System overview"
          updatedAt="Template"
        >
          <div class="lineage-preview" aria-hidden="true">
            <div class="lineage-node strong">API ingest</div>
            <div class="lineage-link"></div>
            <div class="lineage-node">Warehouse</div>
            <div class="lineage-link"></div>
            <div class="lineage-node">Model run</div>
            <div class="lineage-link"></div>
            <div class="lineage-node accent">Published artifact</div>
          </div>
          <p class="lineage-note">
            This module is where future NBA asset lineage graphs, release timelines, and architecture walkthroughs can
            live without needing a separate page pattern.
          </p>
        </ChartFrame>
      </div>
    </SectionBlock>

    <SectionBlock
      eyebrow="About"
      title="Industrial engineering background, data engineering execution, sports-first problem selection."
      intro="The portfolio is intentionally technical. I care about showing the mechanism behind the result: how the model works, how the data moves, how the artifact is published, and where reliability tradeoffs were made."
    >
      <div class="about-band reveal">
        <p>
          My work sits at the intersection of applied modeling and practical software delivery. The interesting part is
          not just producing a number or chart. It is building a system that keeps working, can be audited later, and
          can scale into future analytics products.
        </p>
        <a href="/about">Read full background</a>
      </div>
    </SectionBlock>
  </section>

  <style>
    .home-shell {
      display: grid;
      gap: 6rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(18rem, 0.9fr);
      gap: 1.5rem;
      align-items: start;
    }

    .hero-main {
      display: grid;
      gap: 1.2rem;
      padding-top: 2rem;
      max-width: 48rem;
    }

    .hero-kicker,
    .featured-label,
    .signal-label {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-main h1 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(3.5rem, 8vw, 6.75rem);
      line-height: 0.92;
      letter-spacing: -0.06em;
      max-width: 13ch;
      text-wrap: balance;
    }

    .hero-text {
      margin: 0;
      max-width: 42rem;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.85;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
      margin-top: 0.2rem;
    }

    .hero-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3.2rem;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }

    .hero-link.primary {
      background: linear-gradient(135deg, rgba(125, 211, 252, 0.22), rgba(96, 165, 250, 0.12));
      border-color: rgba(125, 211, 252, 0.24);
    }

    .hero-link:hover {
      transform: translateY(-2px);
      border-color: rgba(125, 211, 252, 0.34);
    }

    .hero-rail {
      display: grid;
      gap: 1rem;
      padding-top: 2.6rem;
    }

    .signal-card {
      padding: 1.2rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 35%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .signal-card ul,
    .signal-card dl {
      margin: 1rem 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 0.85rem;
    }

    .signal-card li,
    .signal-card dd {
      margin: 0;
      color: var(--text-soft);
      line-height: 1.7;
    }

    .signal-card li {
      padding-top: 0.85rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .signal-card dt {
      color: var(--muted);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.25rem;
    }

    .featured-panel {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 0.85fr));
      gap: 1.2rem;
      padding: 1.5rem;
      border-radius: 2rem;
      border: 1px solid rgba(163, 230, 53, 0.18);
      background:
        radial-gradient(circle at 0% 0%, rgba(163, 230, 53, 0.1), transparent 30%),
        linear-gradient(160deg, rgba(18, 29, 25, 0.96), rgba(10, 16, 20, 0.98));
      box-shadow: var(--shadow-card);
    }

    .featured-copy h2 {
      margin: 0.4rem 0 0.8rem;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 0.96;
      letter-spacing: -0.05em;
    }

    .featured-copy p:last-child {
      margin: 0;
      color: var(--muted);
      line-height: 1.8;
      max-width: 38rem;
    }

    .featured-meta {
      display: grid;
      gap: 0.9rem;
    }

    .featured-meta div,
    .featured-actions {
      padding: 1rem;
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .featured-meta span {
      display: block;
      margin-bottom: 0.45rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .featured-meta strong {
      font-size: 1rem;
      line-height: 1.55;
    }

    .featured-actions {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .featured-actions a,
    .about-band a {
      position: relative;
      width: fit-content;
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
    }

    .featured-actions a::after,
    .about-band a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -0.15rem;
      width: 100%;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 180ms ease;
    }

    .featured-actions a:hover::after,
    .about-band a:hover::after {
      transform: scaleX(1);
    }

    .project-grid,
    .analytics-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .analytics-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .lineage-preview {
      display: grid;
      grid-template-columns: repeat(7, auto);
      align-items: center;
      gap: 0.75rem;
      min-height: 12rem;
      padding: 1rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--line);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 70%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
      background-size: auto, 100% 2rem;
      background-position: 0 0, 0 0.25rem;
    }

    .lineage-node {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.65rem 0.9rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-soft);
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .lineage-node.strong {
      border-color: rgba(125, 211, 252, 0.26);
      color: var(--text);
    }

    .lineage-node.accent {
      border-color: rgba(163, 230, 53, 0.28);
      color: #dff7a5;
    }

    .lineage-link {
      height: 1px;
      background: linear-gradient(90deg, rgba(125, 211, 252, 0.55), rgba(163, 230, 53, 0.4));
    }

    .lineage-note,
    .about-band p {
      margin: 0;
      color: var(--muted);
      line-height: 1.8;
    }

    .about-band {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 1.5rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
      box-shadow: var(--shadow-card);
    }

    .about-band p {
      max-width: 48rem;
    }

    @media (max-width: 1100px) {
      .featured-panel,
      .project-grid,
      .analytics-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 900px) {
      .home-shell {
        gap: 4.5rem;
      }

      .hero-grid {
        grid-template-columns: 1fr;
      }

      .hero-main {
        padding-top: 0.4rem;
      }

      .hero-rail {
        padding-top: 0;
      }

      .about-band {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 640px) {
      .hero-main h1 {
        max-width: 100%;
      }

      .lineage-preview {
        grid-template-columns: 1fr;
        justify-items: stretch;
      }

      .lineage-link {
        width: 1px;
        height: 1.5rem;
        margin: 0 auto;
      }
    }
  </style>
</BaseLayout>
