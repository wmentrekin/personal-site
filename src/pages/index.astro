---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Wyatt Entrekin">
  <section class="home-stage">
    <div class="home-frame">
      <section class="intro-card reveal">
        <div class="intro-copy">
          <p class="eyebrow">Welcome</p>
          <p class="intro-text">
            Hello, I&apos;m <strong>Wyatt Entrekin</strong>, a Data Engineer with a passion for analytics.
          </p>
          <p class="intro-text">
            This site is a home for my personal projects, past, present, and future.
          </p>
          <p class="intro-text">
            Feel free to reach out to me if you have any questions, want to collaborate, or just want to chat about data, sports, or anything else!
          </p>
        </div>

        <div class="social-row">
          <a href="https://github.com/wmentrekin" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.86c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.33 4.8-4.56 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/wmentrekin/" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M6.94 8.5a1.56 1.56 0 1 1 0-3.12 1.56 1.56 0 0 1 0 3.12Zm1.3 2.12H5.65V19h2.59v-8.38ZM12.37 10.62H9.8V19h2.56v-4.4c0-2.32 3-2.51 3 0V19H18v-5.32c0-4.14-4.56-3.99-5.63-1.95v-1.11Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
          <a href="mailto:wmentrekin@gmail.com">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M3.27 5.5A2.25 2.25 0 0 1 5.5 4h13a2.25 2.25 0 0 1 2.23 1.5L12 12.18 3.27 5.5Zm-.27 1.9V18.5A2.5 2.5 0 0 0 5.5 21h13a2.5 2.5 0 0 0 2.5-2.5V7.4l-8.33 6.36a1.1 1.1 0 0 1-1.34 0L3 7.4Z"
                fill="currentColor"
              ></path>
            </svg>
          </a>
        </div>

        <p class="focus-line">
          <span>Main Focus</span>
          Data Engineering, Data Science, Operations Research
        </p>

        <p class="focus-line">
          <span>Location</span>
          Atlanta, GA
        </p>

        <p class="focus-line">
          <span>Hometown</span>
          Memphis, TN
        </p>

        <p class="focus-line">
          <span>Education</span>
          Georgia Tech, BS ISyE '23, Incoming MS Analytics Student
        </p>

        <p class="focus-line">
          <span>Interests</span>
          Fitness, Food, Travel, Sports, Language Learning, History
        </p>
      </section>

      <a class="link-tile glass-card tile-cfb reveal" href="/projects/cfb-rankings">
        <canvas class="cfb-network" data-cfb-network aria-hidden="true"></canvas>
        <h2>Entrekin Quadratic Index</h2>
        <p>ranking college football teams using convex optimization</p>
      </a>

      <a class="link-tile glass-card tile-projects reveal" href="/projects">
        <div class="heatmap" data-projects-terminal aria-hidden="true"></div>
        <h2>Projects</h2>
        <p>all my projects</p>
      </a>

      <a class="link-tile glass-card tile-resume reveal" href="/resume">
        <div class="resume-doc" aria-hidden="true">
          <svg class="resume-doc-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3.5h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1Z" />
            <path d="M15 3.5v4h4" />
          </svg>
          <svg class="resume-doc-front" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3.5h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1Z" />
            <path d="M15 3.5v4h4" />
            <path d="M8.5 12h7M8.5 15h7M8.5 18h4" />
          </svg>
        </div>
        <h2>Resume</h2>
        <p>my professional & academic history</p>
      </a>

      <a class="link-tile glass-card tile-now reveal" href="/now">
        <div class="now-clock" aria-hidden="true">
          <span class="now-time" data-now-time></span>
          <span class="now-date" data-now-date></span>
        </div>
        <h2>Now</h2>
        <p>what I&apos;m up to</p>
      </a>
      <a class="link-tile glass-card tile-about reveal" href="/about">
        <div class="fact-ticker" aria-hidden="true">
          <span class="type-name" data-about-typed></span><span class="type-cursor">|</span>
        </div>
        <h2>About</h2>
        <p>more about me</p>
      </a>
      <a class="link-tile glass-card tile-travel reveal" href="/travel">
        <canvas class="mini-globe" data-mini-globe aria-hidden="true"></canvas>
        <h2>Travel</h2>
        <p>where I&apos;ve been</p>
      </a>
      <a class="link-tile glass-card tile-stats reveal" href="/stats">
        <div class="stats-bars" data-stats-bars aria-hidden="true">
          <span class="stats-bar"></span>
          <span class="stats-bar"></span>
          <span class="stats-bar"></span>
          <span class="stats-bar"></span>
          <span class="stats-bar"></span>
          <span class="stats-bar"></span>
          <span class="stats-bar"></span>
          <span class="stats-bar"></span>
        </div>
        <h2>Stats</h2>
        <p>personal dashboard</p>
      </a>
    </div>
    <a class="site-note" href="https://astro.build" target="_blank" rel="noreferrer">
      <img
        src="/images/misc/astro-icon.svg"
        alt="Astro"
        loading="lazy"
      />
      <span>Built with Astro</span>
    </a>
  </section>

  <style>
    .home-stage {
      position: relative;
      display: grid;
      justify-items: center;
      align-items: start;
      padding-top: 1.15rem;
      padding-bottom: 1.5rem;
    }

    .home-frame {
      --desktop-col: 16rem;
      --desktop-row: 14.5rem;
      display: grid;
      grid-template-columns: repeat(4, var(--desktop-col));
      grid-template-rows: repeat(3, var(--desktop-row));
      gap: 1rem;
      width: fit-content;
      max-width: 100%;
    }

    .intro-card {
      position: relative;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition:
        transform 180ms ease,
        box-shadow 180ms ease,
        border-color 180ms ease;
    }

    .intro-card::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(
        135deg,
        rgba(125, 211, 252, 0.55),
        rgba(94, 234, 212, 0.2) 45%,
        rgba(255, 255, 255, 0.06) 100%
      );
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 180ms ease;
      pointer-events: none;
    }

    .intro-card {
      display: grid;
      grid-column: 1 / 3;
      grid-row: 1 / 3;
      align-content: start;
      gap: 1.05rem;
      padding: 1.1rem 1.2rem;
      background:
        radial-gradient(circle at top left, rgba(125, 211, 252, 0.12), transparent 30%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 30%),
        linear-gradient(160deg, rgba(19, 28, 39, 0.94), rgba(11, 18, 26, 0.98));
    }

    .intro-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
      border-color: rgba(255, 255, 255, 0.12);
    }

    .intro-card:hover::before {
      opacity: 1;
    }

    .eyebrow {
      margin: 0;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .accent-method {
      color: var(--accent-method);
    }

    .accent-archive {
      color: var(--accent-archive);
    }

    .intro-card h1 {
      margin: 0.35rem 0 0;
      max-width: 8.5ch;
      font-family: var(--font-display);
      font-size: clamp(1.65rem, 2.5vw, 2.35rem);
      line-height: 0.98;
      letter-spacing: -0.06em;
      text-wrap: balance;
    }

    .intro-text {
      margin: 0.6rem 0 0;
      max-width: 31rem;
      color: var(--text-soft);
      font-size: 1.02rem;
      line-height: 1.65;
      text-wrap: pretty;
    }

    .social-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
    }

    .social-row a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      min-width: 2.75rem;
      padding: 0;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }

    .social-row svg {
      width: 1.3rem;
      height: 1.3rem;
      flex: 0 0 auto;
    }

    .social-row img {
      width: 1.3rem;
      height: 1.3rem;
      flex: 0 0 auto;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }

    .social-row a:hover {
      transform: translateY(-2px);
      border-color: rgba(125, 211, 252, 0.34);
      background: rgba(255, 255, 255, 0.05);
    }

    .focus-line {
      margin: 0;
      color: var(--text-soft);
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .focus-line span {
      margin-right: 0.5rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .link-tile {
      display: grid;
      align-content: end;
      gap: 0.55rem;
      min-height: 0;
      padding: 1rem;
      text-decoration: none;
      color: var(--text);
    }

    .tile-cfb {
      grid-column: 3 / 5;
      grid-row: 1;
    }

    .tile-projects {
      grid-column: 3;
      grid-row: 2;
    }

    .tile-resume {
      grid-column: 4;
      grid-row: 2;
    }

    .tile-now {
      grid-column: 1;
      grid-row: 3;
    }

    .tile-about {
      grid-column: 2;
      grid-row: 3;
    }

    .tile-travel {
      grid-column: 3;
      grid-row: 3;
      position: relative;
    }

    .tile-stats {
      grid-column: 4;
      grid-row: 3;
    }

    /* Live-preview widgets: each tile keeps its grid placement above, but switches
       its own internal layout to a flex column so the widget occupies the flexible
       upper region while the heading/description stay pinned below it -- never
       absolutely positioned, so nothing overlaps regardless of tile height. */
    .tile-cfb,
    .tile-projects,
    .tile-about,
    .tile-now,
    .tile-resume,
    .tile-stats {
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .tile-cfb h2,
    .tile-cfb p,
    .tile-projects h2,
    .tile-projects p,
    .tile-about h2,
    .tile-about p,
    .tile-now h2,
    .tile-now p,
    .tile-stats h2,
    .tile-stats p,
    .tile-travel h2,
    .tile-travel p,
    .tile-resume h2,
    .tile-resume p {
      position: relative;
      z-index: 1;
      flex-shrink: 0;
    }

    .cfb-network {
      flex: 1 1 auto;
      min-height: 0;
      width: 100%;
      opacity: 0.55;
      pointer-events: none;
    }

    .heatmap {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 0.15rem;
      padding: 0.3rem 0.2rem;
      opacity: 0.6;
      pointer-events: none;
      overflow: hidden;
    }

    .heatmap :global(.log-line) {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      line-height: 1.3;
      color: var(--text-soft);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .heatmap :global(.log-line .prompt) {
      color: var(--accent);
      margin-right: 0.4rem;
    }

    .fact-ticker {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.6;
      pointer-events: none;
      overflow: hidden;
      padding: 0 0.4rem;
    }

    .fact-ticker .type-name {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--text);
      white-space: nowrap;
      line-height: 1;
    }

    .fact-ticker .type-cursor {
      display: inline-block;
      width: 2px;
      height: 1.05em;
      margin-left: 3px;
      background: var(--accent);
      vertical-align: -0.18em;
      animation: home-cursor-blink 900ms steps(1) infinite;
    }

    @keyframes home-cursor-blink {
      50% {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .fact-ticker .type-cursor {
        animation: none;
        opacity: 1;
      }
    }

    .now-clock {
      flex: 1 1 auto;
      min-height: 0;
      display: grid;
      place-content: center;
      gap: 0.15rem;
      justify-items: center;
      opacity: 0.55;
      pointer-events: none;
      overflow: hidden;
    }

    .now-clock .now-time {
      font-family: var(--font-mono);
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--text);
    }

    .now-clock .now-date {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text);
    }

    .mini-globe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.55;
      -webkit-mask-image: radial-gradient(circle at 50% 45%, #000 32%, transparent 62%);
      mask-image: radial-gradient(circle at 50% 45%, #000 32%, transparent 62%);
      pointer-events: none;
    }

    .resume-doc {
      flex: 1 1 auto;
      min-height: 0;
      display: grid;
      place-items: center;
      perspective: 60rem;
      opacity: 0.88;
      pointer-events: none;
    }

    .resume-doc-back,
    .resume-doc-front {
      grid-area: 1 / 1;
      width: 4.4rem;
      height: 4.4rem;
    }

    .resume-doc-back {
      transform: translate(0.4rem, 0.4rem);
      color: rgba(216, 226, 237, 0.32);
    }

    .resume-doc-front {
      color: var(--text-soft);
      transform-origin: 15% 50%;
      backface-visibility: hidden;
      animation: resume-page-turn 5.5s ease-in-out infinite;
    }

    @keyframes resume-page-turn {
      0%,
      55% {
        transform: rotateY(0deg);
      }
      72% {
        transform: rotateY(-130deg);
      }
      88%,
      100% {
        transform: rotateY(0deg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .resume-doc-front {
        animation: none;
      }
    }

    .stats-bars {
      flex: 1 1 auto;
      min-height: 0;
      width: 100%;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 0.3rem;
      padding: 0 0.1rem 0.3rem;
      opacity: 0.85;
      pointer-events: none;
      overflow: hidden;
    }

    .stats-bar {
      flex: 0 0 auto;
      width: 0.5rem;
      border-radius: 999px;
      background: linear-gradient(180deg, var(--accent-football), rgba(163, 230, 53, 0.28));
      transition: height 900ms ease-in-out;
    }

    .stats-bar:nth-child(1) {
      height: 1.8rem;
    }

    .stats-bar:nth-child(2) {
      height: 3.2rem;
    }

    .stats-bar:nth-child(3) {
      height: 2rem;
    }

    .stats-bar:nth-child(4) {
      height: 3.8rem;
    }

    .stats-bar:nth-child(5) {
      height: 1.4rem;
    }

    .stats-bar:nth-child(6) {
      height: 2.6rem;
    }

    .stats-bar:nth-child(7) {
      height: 3.4rem;
    }

    .stats-bar:nth-child(8) {
      height: 2.2rem;
    }

    @media (prefers-reduced-motion: reduce) {
      .stats-bar {
        transition: none;
      }
    }

    .link-tile h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.2rem;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .link-tile p:not(.eyebrow) {
      margin: 0;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .site-note {
      position: fixed;
      right: 1rem;
      bottom: 0.9rem;
      z-index: 20;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      margin: 0;
      color: rgba(150, 169, 188, 0.82);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .site-note img {
      width: 0.95rem;
      height: 0.95rem;
      flex: 0 0 auto;
    }

    .site-note:hover {
      color: var(--text);
    }

    @media (max-width: 1140px) {
      .home-stage {
        justify-items: stretch;
        padding-top: 0.8rem;
      }

      .home-frame {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto;
        width: 100%;
      }

      .intro-card,
      .tile-cfb,
      .tile-now,
      .tile-travel,
      .tile-projects,
      .tile-about,
      .tile-resume,
      .tile-stats {
        grid-column: auto;
        grid-row: auto;
      }

      .site-note {
        position: static;
        padding-top: 0.15rem;
      }
    }

    @media (max-width: 720px) {
      .intro-card h1 {
        max-width: 100%;
      }

      .home-frame {
        gap: 0.85rem;
      }
    }

    @media (max-width: 480px) {
      .intro-card,
      .tile-cfb,
      .tile-projects,
      .tile-about,
      .tile-now,
      .tile-travel,
      .tile-resume,
      .tile-stats {
        grid-column: auto;
        grid-row: auto;
      }

      .home-frame {
        gap: 0.75rem;
      }

      .intro-card {
        padding: 1.1rem;
      }

      .social-row a {
        min-height: 2.75rem;
        min-width: 2.75rem;
      }

      .social-row svg {
        width: 1.1rem;
        height: 1.1rem;
      }

      .link-tile {
        min-height: 6.5rem;
        padding: 1.1rem;
      }
    }
  </style>

  <script>
    // Home-tile live-preview widgets (design-handoff-mobile-2026-08, T6).
    // Fidelity reference: docs/design-handoff-mobile-2026-08 mockup zip, home.html.
    // Ported to real client-side behavior against this site's actual tile markup --
    // not copied from the mockup HTML. Each widget: no-ops if its target element is
    // missing, respects prefers-reduced-motion before starting continuous animation,
    // and initializes off the main render path via requestIdleCallback.
    import { geoOrthographic, geoPath, geoGraticule10 } from "d3-geo";

    type CountryFeature = {
      type?: string;
      geometry?: {
        type: string;
        coordinates: unknown;
      };
      properties: {
        ISO_A2?: string;
      };
    };

    const prefersReducedMotion = () =>
      typeof window.matchMedia === "function" &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const runWhenIdle = (callback: () => void) => {
      const requestIdle = (window as Window & { requestIdleCallback?: (cb: () => void) => number })
        .requestIdleCallback;

      if (typeof requestIdle === "function") {
        requestIdle(callback);
      } else {
        setTimeout(callback, 200);
      }
    };

    // Mini-globe (Travel tile): reuses the same visited-countries data and
    // same-origin geojson fetch as TravelGlobe.astro (src/components/TravelGlobe.astro),
    // duplicated here rather than imported since travel.astro/TravelGlobe.astro are
    // out of scope to modify for this task. d3-geo is a real npm package import
    // (Vite-bundled at build time), not a runtime CDN import -- no CSP exception needed.
    const initMiniGlobe = async () => {
      const canvas = document.querySelector("[data-mini-globe]");
      if (!(canvas instanceof HTMLCanvasElement)) {
        return;
      }

      const context = canvas.getContext("2d");
      if (!context) {
        return;
      }

      // Registered before the await below, not after -- if the user navigates
      // away while this same-origin fetch is still in flight (plausible, since
      // this widget sits on the Travel tile), astro:before-swap would otherwise
      // fire and be missed entirely, leaving the resize/rAF setup below to run
      // unmanaged until the *next* transition instead of this one.
      let cancelled = false;
      document.addEventListener("astro:before-swap", () => (cancelled = true), { once: true });

      let countries: CountryFeature[];
      try {
        const response = await fetch("/data/travel/ne_110m_admin_0_countries.geojson");
        if (!response.ok || cancelled) {
          return;
        }

        const geojson = (await response.json()) as { features: CountryFeature[] };
        countries = geojson.features.filter(
          (feature) => feature.properties.ISO_A2 && feature.properties.ISO_A2 !== "AQ"
        );
      } catch {
        return;
      }

      if (cancelled) {
        return;
      }

      const visitedIso2 = new Set([
        "MX",
        "PE",
        "DO",
        "IT",
        "ES",
        "FR",
        "NL",
        "GB",
        "DE",
        "AT",
        "IS",
        "IE",
        "CR",
        "JM",
        "BS",
        "KY"
      ]);

      const projection = geoOrthographic();
      const path = geoPath(projection, context);
      const graticule = geoGraticule10();
      const rotation: [number, number, number] = [10, -18, 0];
      let width = 0;
      let height = 0;

      const draw = () => {
        context.clearRect(0, 0, width, height);

        context.save();
        context.beginPath();
        path({ type: "Sphere" } as never);
        context.fillStyle = "rgba(16, 24, 33, 0.9)";
        context.fill();
        context.clip();

        context.beginPath();
        path(graticule);
        context.strokeStyle = "rgba(173, 196, 221, 0.12)";
        context.lineWidth = 0.6;
        context.stroke();

        countries.forEach((feature) => {
          const code = feature.properties.ISO_A2;
          const visited = (code ? visitedIso2.has(code) : false) || code === "US";

          context.beginPath();
          path(feature as never);
          context.fillStyle = visited ? "rgba(217, 67, 67, 0.85)" : "rgba(74, 86, 102, 0.35)";
          context.fill();
        });

        context.restore();

        context.beginPath();
        path({ type: "Sphere" } as never);
        context.strokeStyle = "rgba(173, 196, 221, 0.2)";
        context.lineWidth = 1;
        context.stroke();
      };

      const resize = () => {
        width = Math.max(1, canvas.clientWidth);
        height = Math.max(1, canvas.clientHeight);
        const ratio = window.devicePixelRatio || 1;

        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        context.setTransform(1, 0, 0, 1, 0, 0);
        context.scale(ratio, ratio);

        projection
          .translate([width / 2, height * 0.45])
          .scale(Math.min(width, height) * 0.42)
          .clipAngle(90)
          .rotate(rotation);

        draw();
      };

      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(canvas);
      resize();

      let frame = 0;

      if (!prefersReducedMotion()) {
        const spin = () => {
          rotation[0] += 0.12;
          projection.rotate(rotation);
          draw();
          frame = requestAnimationFrame(spin);
        };
        frame = requestAnimationFrame(spin);
      }

      document.addEventListener(
        "astro:before-swap",
        () => {
          resizeObserver.disconnect();
          if (frame) {
            cancelAnimationFrame(frame);
          }
        },
        { once: true }
      );
    };

    // Live clock (Now tile). Text updates are not "motion" -- runs regardless of
    // prefers-reduced-motion, matching the handoff's stated exception.
    const initNowClock = () => {
      const timeEl = document.querySelector("[data-now-time]");
      const dateEl = document.querySelector("[data-now-date]");
      if (!(timeEl instanceof HTMLElement) || !(dateEl instanceof HTMLElement)) {
        return;
      }

      const tick = () => {
        const now = new Date();
        timeEl.textContent = now.toLocaleTimeString([], {
          hour: "numeric",
          minute: "2-digit",
          second: "2-digit"
        });
        dateEl.textContent = now.toLocaleDateString([], {
          month: "long",
          day: "numeric",
          year: "numeric"
        });
      };

      tick();
      const interval = setInterval(tick, 1000);
      document.addEventListener("astro:before-swap", () => clearInterval(interval), { once: true });
    };

    // Fake terminal (Projects tile): types `cd projects` / `ls` / the real folder
    // list, one line at a time, then stops -- no loop.
    const initProjectsTerminal = () => {
      const container = document.querySelector("[data-projects-terminal]");
      if (!(container instanceof HTMLElement)) {
        return;
      }

      const commands: { type: "cmd" | "out"; text: string }[] = [
        { type: "cmd", text: "cd projects" },
        { type: "cmd", text: "ls" },
        { type: "out", text: "cfb-rankings/" },
        { type: "out", text: "nba-asset-lineage/" },
        { type: "out", text: "chronicle/" },
        { type: "out", text: "2020election/" },
        { type: "out", text: "cbb-rankings/" },
        { type: "out", text: "agent-skills/" }
      ];

      const renderLine = (line: (typeof commands)[number]) => {
        const div = document.createElement("div");
        div.className = "log-line";

        if (line.type === "cmd") {
          const prompt = document.createElement("span");
          prompt.className = "prompt";
          prompt.textContent = "$";
          div.append(prompt, document.createTextNode(` ${line.text}`));
        } else {
          div.textContent = line.text;
        }

        container.appendChild(div);
      };

      if (prefersReducedMotion()) {
        commands.forEach(renderLine);
        return;
      }

      let stopped = false;
      const RESTART_MS = 30000;

      const runCycle = () => {
        container.textContent = "";
        let i = 0;
        const step = () => {
          if (stopped || i >= commands.length) {
            return;
          }

          renderLine(commands[i]);
          i++;
          setTimeout(step, 750);
        };
        step();
      };

      runCycle();
      const intervalId = setInterval(() => {
        if (!stopped) {
          runCycle();
        }
      }, RESTART_MS);
      document.addEventListener(
        "astro:before-swap",
        () => {
          stopped = true;
          clearInterval(intervalId);
        },
        { once: true }
      );
    };

    // Typing/erasing loop (About tile).
    const initAboutTyping = () => {
      const el = document.querySelector("[data-about-typed]");
      if (!(el instanceof HTMLElement)) {
        return;
      }

      const full = "Wyatt Entrekin";

      if (prefersReducedMotion()) {
        el.textContent = full;
        return;
      }

      let c = 0;
      let deleting = false;
      let stopped = false;

      const tick = () => {
        if (stopped) {
          return;
        }

        if (deleting) {
          c--;
          el.textContent = full.slice(0, c);
        } else {
          el.textContent = full.slice(0, c);
          c++;
        }

        let delay = deleting ? 107 : 215;
        if (!deleting && c === full.length + 1) {
          delay = 4300;
          deleting = true;
        } else if (deleting && c === 0) {
          deleting = false;
          delay = 1200;
        }

        setTimeout(tick, delay);
      };

      tick();
      document.addEventListener("astro:before-swap", () => (stopped = true), { once: true });
    };

    // Network-sim (CFB Rankings tile): 68 nodes, round-robin "circle method"
    // 1-factorization adds one edge per node every ~8s until each node has 11 edges,
    // then resets with fresh random rest-lengths. A simple spring simulation relaxes
    // layout continuously; edge color/thickness scale with distance from rest length.
    const initCfbNetwork = () => {
      const canvas = document.querySelector("[data-cfb-network]");
      if (!(canvas instanceof HTMLCanvasElement)) {
        return;
      }

      const ctx = canvas.getContext("2d");
      if (!ctx) {
        return;
      }

      const N = 68;
      const nodes = Array.from({ length: N }, () => ({ x: Math.random(), y: Math.random(), vx: 0, vy: 0 }));

      const buildRounds = () => {
        const players = Array.from({ length: N }, (_, i) => i);
        const rounds: [number, number][][] = [];

        for (let r = 0; r < N - 1; r++) {
          const pairs: [number, number][] = [];
          for (let i = 0; i < N / 2; i++) {
            pairs.push([players[i], players[N - 1 - i]]);
          }
          rounds.push(pairs);

          const fixed = players[0];
          const rest = players.slice(1);
          rest.unshift(rest.pop() as number);
          players.splice(0, N, fixed, ...rest);
        }

        return rounds.slice(0, 11);
      };

      let edges: { a: number; b: number; rest: number }[] = [];
      let roundIdx = 0;
      const timers: ReturnType<typeof setTimeout>[] = [];

      const addRound = (rounds: [number, number][][]) => {
        if (roundIdx >= rounds.length) {
          timers.push(
            setTimeout(() => {
              edges = [];
              nodes.forEach((n) => {
                n.x = Math.random();
                n.y = Math.random();
              });
              roundIdx = 0;
              addRound(buildRounds());
            }, 8000)
          );
          return;
        }

        rounds[roundIdx].forEach(([a, b]) => edges.push({ a, b, rest: 0.14 + Math.random() * 0.4 }));
        roundIdx++;
        timers.push(setTimeout(() => addRound(rounds), 8000));
      };

      let width = 0;
      let height = 0;

      const resize = () => {
        width = canvas.clientWidth;
        height = canvas.clientHeight;
        const ratio = window.devicePixelRatio || 1;

        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(ratio, ratio);
      };

      const step = () => {
        edges.forEach((edge) => {
          const a = nodes[edge.a];
          const b = nodes[edge.b];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.hypot(dx, dy) || 0.001;
          const force = (dist - edge.rest) * 0.02;
          const fx = (dx / dist) * force;
          const fy = (dy / dist) * force;

          a.vx += fx;
          a.vy += fy;
          b.vx -= fx;
          b.vy -= fy;
        });

        nodes.forEach((n) => {
          n.vx += (0.5 - n.x) * 0.0025;
          n.vy += (0.5 - n.y) * 0.0025;
          n.vx *= 0.92;
          n.vy *= 0.92;
          n.x += n.vx;
          n.y += n.vy;
          n.x = Math.max(0.06, Math.min(0.94, n.x));
          n.y = Math.max(0.1, Math.min(0.9, n.y));
        });
      };

      const draw = () => {
        ctx.clearRect(0, 0, width, height);

        edges.forEach((edge) => {
          const a = nodes[edge.a];
          const b = nodes[edge.b];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.hypot(dx, dy);
          const tension = Math.min(1, Math.abs(dist - edge.rest) / edge.rest);

          ctx.beginPath();
          ctx.moveTo(a.x * width, a.y * height);
          ctx.lineTo(b.x * width, b.y * height);
          ctx.strokeStyle = `rgba(125, 211, 252, ${0.15 + tension * 0.55})`;
          ctx.lineWidth = 0.6 + tension * 1.4;
          ctx.stroke();
        });

        nodes.forEach((n) => {
          ctx.beginPath();
          ctx.arc(n.x * width, n.y * height, 2.6, 0, Math.PI * 2);
          ctx.fillStyle = "rgba(243, 247, 251, 0.85)";
          ctx.fill();
        });
      };

      const resizeObserver = new ResizeObserver(() => {
        resize();
        draw();
      });
      resizeObserver.observe(canvas);
      resize();

      let perturbTimer: ReturnType<typeof setTimeout> | undefined;
      let frame = 0;

      // Registered unconditionally, before the reduced-motion branch below can
      // return early -- the resizeObserver above is created either way, so its
      // cleanup must not depend on which branch runs (this was the bug the
      // reviewer caught: the reduced-motion path used to return before this
      // listener was ever attached, leaking the observer on every Home visit
      // for exactly the users this branch exists to protect).
      document.addEventListener(
        "astro:before-swap",
        () => {
          resizeObserver.disconnect();
          timers.forEach(clearTimeout);
          if (perturbTimer) {
            clearTimeout(perturbTimer);
          }
          if (frame) {
            cancelAnimationFrame(frame);
          }
        },
        { once: true }
      );

      if (prefersReducedMotion()) {
        // Static frame only: draw the fully-built network once, no timers, no
        // continuous spring simulation.
        edges = buildRounds()
          .flat()
          .map(([a, b]) => ({ a, b, rest: 0.14 + Math.random() * 0.4 }));
        draw();
        return;
      }

      addRound(buildRounds());

      const perturb = () => {
        const n = nodes[Math.floor(Math.random() * N)];
        n.vx += (Math.random() - 0.5) * 0.05;
        n.vy += (Math.random() - 0.5) * 0.05;
        perturbTimer = setTimeout(perturb, 2200 + Math.random() * 2200);
      };
      perturb();

      const loop = () => {
        step();
        draw();
        frame = requestAnimationFrame(loop);
      };
      frame = requestAnimationFrame(loop);
    };

    // Stats tile: 8 bars re-randomize their heights independently on an
    // interval (CSS transition animates the change) instead of all pulsing
    // around the same fixed skyline shape.
    const initStatsBars = () => {
      const bars = document.querySelectorAll("[data-stats-bars] .stats-bar");
      if (!bars.length) {
        return;
      }

      const randomize = () => {
        bars.forEach((bar) => {
          if (bar instanceof HTMLElement) {
            bar.style.height = `${1 + Math.random() * 3.2}rem`;
          }
        });
      };

      randomize();

      if (prefersReducedMotion()) {
        return;
      }

      const intervalId = setInterval(randomize, 1100);
      document.addEventListener("astro:before-swap", () => clearInterval(intervalId), { once: true });
    };

    const initHomeWidgets = () => {
      runWhenIdle(() => void initMiniGlobe());
      runWhenIdle(initNowClock);
      runWhenIdle(initCfbNetwork);
      runWhenIdle(initProjectsTerminal);
      runWhenIdle(initAboutTyping);
      runWhenIdle(initStatsBars);
    };

    // astro:page-load (not DOMContentLoaded) -- this site uses ClientRouter
    // (View Transitions, see BaseLayout.astro), which performs same-document
    // navigation. DOMContentLoaded only ever fires once, and pagehide doesn't
    // fire on same-document swaps, so both the init trigger and every widget's
    // cleanup above are wired to Astro's transition lifecycle events instead
    // (astro:page-load / astro:before-swap) -- the same pattern BaseLayout.astro
    // already uses for its own reveal-on-scroll script.
    document.addEventListener("astro:page-load", initHomeWidgets);
  </script>
</BaseLayout>
