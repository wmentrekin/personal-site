---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Wyatt Entrekin | Personal Site">
  <section class="hero">
    <span class="eyebrow">Home</span>
    <h1>Wyatt Entrekin</h1>
    <p class="muted">
      Data engineer building end-to-end analytics systems, from ingestion and modeling to automated delivery.
    </p>
  </section>

  <section class="quick-grid">
    <a class="quick-card" href="/projects">
      <div class="tile-icon tone-projects"></div>
      <h2>Projects</h2>
    </a>
    <a class="quick-card" href="/about">
      <div class="tile-icon tone-about"></div>
      <h2>About</h2>
    </a>
  </section>
</BaseLayout>
